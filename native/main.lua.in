local COLOR_HEX = { canvas = "#FFFFFF", ink = "#15191F", navy = "#0066FF",
teal = "#00A878", blue = "#0066FF", green = "#00B85A", amber = "#FF8C00",
red = "#FF3656", cyan = "#00A6D6", purple = "#A267FF", magenta = "#DF1770",
amber_paper = "#FFE3A0", white = "#FFFFFF" }
local TAB_ACCENTS = { "blue", "teal", "cyan", "purple", "amber", "magenta" }
local COLOR_CACHE = {}
local function dashboard_color_enabled()
if type(Screen.isColorEnabled) ~= "function" or type(Blitbuffer.colorFromString) ~= "function" then return false end
local ok, enabled = pcall(Screen.isColorEnabled, Screen)
return ok and enabled == true
end
local function dashboard_color(name, fallback)
if not dashboard_color_enabled() then return fallback or Blitbuffer.COLOR_BLACK end
if not COLOR_CACHE[name] then COLOR_CACHE[name] = Blitbuffer.colorFromString(COLOR_HEX[name]) end
return COLOR_CACHE[name] or fallback or Blitbuffer.COLOR_BLACK
end
local function dashboard_face(size)
local face=Font:getFace("cfont",size)
if type(face.size)=="number" and face.size>size then
face=Font:getFace("cfont",math.max(6,math.floor(size*size/face.size+.5)))
end
return face
end
local function accent_frame(options, accent)
local frame = FrameContainer:new(options)
local base_paint = frame.paintTo
if type(base_paint) == "function" then
frame.paintTo = function(widget, bb, x, y)
base_paint(widget, bb, x, y)
if dashboard_color_enabled() then
bb:paintRectRGB32(x + 1, y + 1, 6, widget.height - 2, dashboard_color(accent))
end
end
end
return frame
end
