local function battery_is_low()
local ok, capacity = pcall(function()
local power = Device:getPowerDevice()
if not power or type(power.getCapacity) ~= "function" then return nil end
if type(power.isCharging) == "function" and power:isCharging() then
return nil
end
return power:getCapacity()
end)
return ok and type(capacity) == "number" and capacity >= 0 and capacity <= 20
end
local function brightness_percent(level, maximum)
return math.floor(level * 100 / maximum + 0.5)
end
function Dashboard:readBrightness()
local ok, state, reason = pcall(function()
if type(Device.hasFrontlight) == "function" and not Device:hasFrontlight() then
return nil, "This device does not have a controllable frontlight."
end
local power = Device:getPowerDevice()
if not power or type(power.setIntensity) ~= "function"
or type(power.updateResumeFrontlightState) ~= "function" then
return nil, "Frontlight controls are unavailable on this device."
end
if type(Device.isKindle) == "function" and Device:isKindle()
and power.lipc_handle == nil then
return nil, "Kindle frontlight controls are unavailable without LIPC."
end
local minimum, maximum = power.fl_min, power.fl_max
if type(minimum) ~= "number" or minimum ~= 0
or type(maximum) ~= "number" or maximum % 1 ~= 0
or maximum < 1 or maximum > 1000 then
return nil, "The device frontlight range could not be read."
end
local hardware = type(power.frontlightIntensityHW) == "function"
local level
if hardware then
level = power:frontlightIntensityHW()
elseif type(power.frontlightIntensity) == "function" then
level = power:frontlightIntensity()
else
return nil, "The current frontlight level could not be read."
end
if type(level) ~= "number" or level % 1 ~= 0
or level < minimum or level > maximum then
return nil, "The current frontlight level could not be verified."
end
return { power = power, level = level, maximum = maximum,
percent = brightness_percent(level, maximum), hardware = hardware }
end)
if not ok then return nil, "Frontlight controls could not read the device." end
return state, reason
end
function Dashboard:setBrightnessLevel(level, automatic)
local state, reason = self:readBrightness()
if not state then return nil, reason end
if type(level) ~= "number" or level % 1 ~= 0
or level < 0 or level > state.maximum then
return nil, "That frontlight level is outside the device range."
end
local ok = pcall(function() state.power:setIntensity(level) end)
if not ok then
self:reconcileBrightnessCache(state.power)
return nil, "The device could not change its frontlight."
end
local actual, read_error = self:readBrightness()
if not actual then return nil, read_error end
if actual.power ~= state.power or actual.level ~= level then
self:reconcileBrightnessCache(state.power)
return nil, "The frontlight did not reach the requested level."
end
if not automatic and (self.settings.night_enabled or self.settings.night_owned) then self:overrideNightDimming() end
local saved = pcall(function() state.power:updateResumeFrontlightState() end)
if not saved then
return nil, "The light changed, but its resume setting could not be saved."
end
return actual
end
function Dashboard:reconcileBrightnessCache(power)
local actual = self:readBrightness()
if actual and actual.hardware and actual.power == power and type(power.frontlightIntensity) == "function" then
local ok, cached = pcall(power.frontlightIntensity, power)
if ok and cached ~= actual.level then pcall(power.setIntensity, power, actual.level, true) end
end
end
function Dashboard:showBrightnessDialog()
local state, reason = self:readBrightness()
if self.brightness_dialog then UIManager:close(self.brightness_dialog) end
if not state then self:notice(reason, 7); return false end
local dialog
local function apply(level)
local _, change_error = self:setBrightnessLevel(level)
if self:showBrightnessDialog() and change_error then self:notice(change_error, 7) end
end
local function step(delta)
local current, read_error = self:readBrightness()
if not current then
if self:showBrightnessDialog() then self:notice(read_error, 7) end
return
end
apply(math.max(0, math.min(current.maximum, current.level + delta)))
end
local function preset(percent)
local level = percent == 0 and 0
or math.max(1, math.floor(state.maximum * percent / 100 + 0.5))
local actual = brightness_percent(level, state.maximum)
local label = percent == 0 and "Off" or tostring(percent) .. "%"
if percent > 0 and actual ~= percent then label = label .. " (~" .. actual .. "%)" end
return { text = label, callback = function() apply(level) end }
end
local lowest = brightness_percent(1, state.maximum)
local title = state.level == 0 and "Light: Off" or "Light: " .. state.percent .. "%"
title = title .. " (" .. state.level .. "/" .. state.maximum .. ")"
if not state.hardware then title = title .. "\nKOReader-reported level" end
dialog = ButtonDialog:new {
title = title,
title_align = "center",
width = math.floor(Screen:getWidth() * 0.9),
buttons = {
{ preset(0), { text = "Lowest (~" .. lowest .. "%)",
callback = function() apply(1) end } },
{ preset(10), preset(50) },
{ preset(100) },
{ { text = "- One step", enabled = state.level > 0,
callback = function() step(-1) end },
{ text = "+ One step", enabled = state.level < state.maximum,
callback = function() step(1) end } },
{ { text = "Everyday settings / clean screen", callback = function()
UIManager:close(dialog); self:showEverydaySettings() end } },
{ { text = "Done", callback = function() UIManager:close(dialog) end } },
},
}
local original_close = dialog.onCloseWidget
dialog.onCloseWidget = function(widget)
self.quick_menu_count = math.max(0, (self.quick_menu_count or 1) - 1)
if self.brightness_dialog == widget then self.brightness_dialog = nil end
if original_close then original_close(widget) end
if type(UIManager.nextTick) == "function" then self:deferCleanScreen() end
end
self.brightness_dialog = dialog
self.quick_menu_count = (self.quick_menu_count or 0) + 1
UIManager:show(dialog)
return true
end
local function boot_launch_enabled()
return Device:isKindle()
and lfs.symlinkattributes(BOOT_LAUNCH_SWITCH, "mode") == "file"
end
local function parse_update_version(value)
if type(value) ~= "string" or #value > 32 then return nil end
local major, minor, patch = value:match("^(%d+)%.(%d+)%.(%d+)%-dev$")
local prerelease = true
if not major then
major, minor, patch = value:match("^(%d+)%.(%d+)%.(%d+)$")
prerelease = false
end
if not major or #major > 4 or #minor > 4 or #patch > 4 then return nil end
return { tonumber(major), tonumber(minor), tonumber(patch), prerelease }
end
local function compare_update_versions(a, b)
local av, bv = parse_update_version(a), parse_update_version(b)
if not av or not bv then return nil end
for i = 1, 3 do
if av[i] ~= bv[i] then return av[i] < bv[i] and -1 or 1 end
end
if av[4] ~= bv[4] then return av[4] and -1 or 1 end
return 0
end
local function device_serial()
local serial = io.open("/proc/usid", "r")
if not serial then return nil end
local value = serial:read(129)
serial:close()
if type(value)~="string" or #value>128 then return nil end
return value:gsub("[%z\r\n]+$", "")
end
local function normalize_plugin_path(path)
if type(path) ~= "string" or path == "" then return nil end
if path:sub(1, 1) == "@" then path = path:sub(2) end
if path:sub(1, 2) == "./" then path = path:sub(3) end
if path:sub(1, 1) ~= "/" then path = lfs.currentdir() .. "/" .. path end
for segment in path:gmatch("[^/]+") do
if segment == "." or segment == ".." then return nil end
end
if path:match("/main%.lua$") then path = path:sub(1, -10) end
return path
end
local function plugin_directory(plugin_path)
local source_info = debug.getinfo(1, "S")
local source = source_info and source_info.source
local candidates = {}
if type(source) == "string" and source:sub(1, 1) == "@"
and source:match("/main%.lua$") then
candidates[#candidates + 1] = source
end
if type(plugin_path) == "string" then
candidates[#candidates + 1] = plugin_path
end
if #candidates == 0 then return nil, nil, "source" end
local approved_but_unusable = false
for _, candidate in ipairs(candidates) do
local directory = normalize_plugin_path(candidate)
if UPDATE_PLUGIN_DIRS[directory] then
local parent = directory:match("^(.*)/kindleprinter%.koplugin$")
if parent and lfs.symlinkattributes(parent, "mode") == "directory"
and lfs.symlinkattributes(directory, "mode") == "directory"
and lfs.symlinkattributes(directory .. "/main.lua", "mode") == "file" then
return directory, parent
end
approved_but_unusable = true
end
end
return nil, nil, approved_but_unusable and "folder" or "path"
end
local function clean_base_url(value)
local url = require("socket.url")
value = (value or ""):match("^%s*(.-)%s*$"):gsub("/+$", "")
if value == PUBLIC_BASE then
return value
end
local parsed = url.parse(value)
if not parsed or parsed.scheme ~= "http" or not parsed.host or parsed.host == ""
or parsed.userinfo or parsed.user or parsed.password or parsed.query or parsed.fragment then
return nil
end
if parsed.path and parsed.path ~= "" and parsed.path ~= "/" then
return nil
end
if parsed.port and (not tonumber(parsed.port) or tonumber(parsed.port) < 1
or tonumber(parsed.port) > 65535) then
return nil
end
return value
end
local function private_ip(host, tailnet_only)
local a, b, c, d = host:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
if not a then return false end
a, b, c, d = tonumber(a), tonumber(b), tonumber(c), tonumber(d)
if a > 255 or b > 255 or c > 255 or d > 255 then return false end
if host ~= string.format("%d.%d.%d.%d", a, b, c, d) then return false end
local tailnet = a == 100 and b >= 64 and b <= 127
if tailnet_only then return tailnet end
return tailnet or a == 10 or a == 127 or (a == 192 and b == 168)
or (a == 172 and b >= 16 and b <= 31)
end
local function allowed_target(base, mode)
return mode=="https" and base==PUBLIC_BASE
end

local function san_matches_public_host(name)
if type(name) ~= "string" or name:find("[%c%s]") then return false end
name = name:lower()
if name == PUBLIC_HOST then return true end
local suffix = name:match("^%*%.([a-z0-9.%-]+)$")
if not suffix or not suffix:find("%.") then return false end
if PUBLIC_HOST:sub(-#suffix) ~= suffix then return false end
local prefix = PUBLIC_HOST:sub(1, #PUBLIC_HOST - #suffix)
if prefix:sub(-1) ~= "." then return false end
prefix = prefix:sub(1, -2)
return prefix ~= "" and not prefix:find("%.")
end
local function verified_https_factory(https, cafile)
local create_tls = https.tcp {
protocol = "any",
options = { "all", "no_sslv2", "no_sslv3", "no_tlsv1", "no_tlsv1_1" },
verify = "peer",
cafile = cafile,
depth = 8,
}
return function()
local conn = create_tls()
local tls_connect = conn.connect
function conn:connect(host, port)
if host ~= PUBLIC_HOST or tonumber(port) ~= 443 then
return nil, "Unexpected dashboard host"
end
local connected, err = tls_connect(self, host, port)
if not connected then
return nil, err
end
local checked, matches = pcall(function()
if not self.sock:getpeerverification() then return false end
local cert = self.sock:getpeercertificate()
if not cert then return false end
local san = cert:extensions()["2.5.29.17"]
local names = san and san.dNSName
if type(names) ~= "table" then return false end
for _, name in ipairs(names) do
if san_matches_public_host(name) then return true end
end
return false
end)
if not checked or not matches then
self:close()
return nil, "Dashboard TLS identity verification failed"
end
return 1
end
return conn
end
end
local function valid_token(value)
return type(value) == "string" and #value >= 24 and #value <= 256
and not value:find("[%c%s]")
end
local function read_bearer_token(path)
if type(path) ~= "string" or path:sub(1, 1) ~= "/" then
return nil, "Token-file path must be absolute"
end
local file = io.open(path, "rb")
if not file then
return nil, "Token file is missing"
end
local value = file:read(512)
file:close()
if not value then
return nil, "Token file is empty"
end
value = value:match("^%s*(.-)%s*$")
if not valid_token(value) then
return nil, "Token file is invalid"
end
return value
end
local function write_bearer_token(value, destination)
if not valid_token(value) then
return nil, "Token must be 24-256 characters without spaces"
end
local directory
if destination == TOKEN_FILE or destination == CONTROL_TOKEN_FILE then
directory = TOKEN_DIRECTORY
elseif destination == FALLBACK_TOKEN_FILE or destination == FALLBACK_CONTROL_TOKEN_FILE then
directory = FALLBACK_TOKEN_DIRECTORY
else
return nil, "Invalid token destination"
end
local ffi = require("ffi")
pcall(ffi.cdef, "int chmod(const char *path, unsigned int mode);")
local mode = lfs.symlinkattributes(directory, "mode")
if mode == nil then
local created = lfs.mkdir(directory)
if not created then return nil, "Cannot create private token directory" end
elseif mode ~= "directory" then
return nil, "Token directory is not a real directory"
end
if ffi.C.chmod(directory, 448) ~= 0 -- 0700
or lfs.attributes(directory, "permissions") ~= "rwx------" then
return nil, "Cannot restrict token directory permissions"
end
local temp = destination .. ".new-" .. tostring(os.time()) .. "-" .. tostring(math.random(100000, 999999))
local file = io.open(temp, "wb")
if not file then return nil, "Cannot create private token file" end
if ffi.C.chmod(temp, 384) ~= 0 -- 0600
or lfs.attributes(temp, "permissions") ~= "rw-------" then
file:close()
os.remove(temp)
return nil, "Cannot restrict token file permissions"
end
local wrote = file:write(value, "\n")
local closed = file:close()
if not wrote or not closed then
os.remove(temp)
return nil, "Cannot write token with private permissions"
end
if not os.rename(temp, destination) then
os.remove(temp)
return nil, "Cannot install private token file"
end
if lfs.attributes(destination, "permissions") ~= "rw-------" then
return nil, "Token file permissions changed after installation"
end
return true
end
local function import_token_bootstrap()
local mode = lfs.symlinkattributes(BOOTSTRAP_FILE, "mode")
if not mode then return nil end
if mode ~= "file" then
return false, "Token bootstrap is not a regular file. Remove it from Kindle storage."
end
local file = io.open(BOOTSTRAP_FILE, "rb")
if not file then
return false, "Token bootstrap cannot be read. Remove it from Kindle storage."
end
local data = file:read(512) or ""
local extra = file:read(1)
file:close()
if not os.remove(BOOTSTRAP_FILE) then
return false, "Token bootstrap could not be removed from Kindle storage; no tokens imported."
end
if extra or #data > 512 then
return false, "Token bootstrap was too large and was removed."
end
local reader, control = data:match("^KPD1\nreader=([A-Za-z0-9_-]+)\ncontrol=([A-Za-z0-9_-]+)\n$")
if not reader or not control or #reader ~= 64 or #control ~= 64
or reader == control or not valid_token(reader) or not valid_token(control) then
return false, "Token bootstrap format was invalid and was removed."
end
local reader_ok = write_bearer_token(reader, TOKEN_FILE)
local control_ok = reader_ok and write_bearer_token(control, CONTROL_TOKEN_FILE)
if reader_ok and control_ok then
return true, nil, TOKEN_FILE, CONTROL_TOKEN_FILE, false
end
local fallback_reader_ok = write_bearer_token(reader, FALLBACK_TOKEN_FILE)
local fallback_control_ok = fallback_reader_ok
and write_bearer_token(control, FALLBACK_CONTROL_TOKEN_FILE)
if fallback_reader_ok and fallback_control_ok then
return true, nil, FALLBACK_TOKEN_FILE, FALLBACK_CONTROL_TOKEN_FILE, true
end
return false, "Token storage failed in both locations. Check KOReader permissions."
end
local function png_size(data)
if #data < 24 or data:sub(1, 8) ~= PNG_SIGNATURE or data:sub(13, 16) ~= "IHDR" then
return nil
end
local function be32(position)
local a, b, c, d = data:byte(position, position + 3)
return ((a * 256 + b) * 256 + c) * 256 + d
end
local width, height = be32(17), be32(21)
if width < 64 or height < 64 or width > 4096 or height > 4096
or width * height > 8000000 then
return nil
end
return width, height
end
local REFRESH_PROFILES = {
always = { changes = 1, seconds = 60, label = "Clean every change (most flashing)" },
clarity = { changes = 3, seconds = 60, label = "Clarity (recommended)" },
balanced = { changes = 5, seconds = 120, label = "Balanced" },
low_flash = { changes = 8, seconds = 180, label = "Fewer flashes" },
}
local function minute_setting(value, fallback)
return type(value) == "number" and value % 1 == 0 and value >= 0 and value < 1440
and value or fallback
end
local function clock_label(value)
return string.format("%02d:%02d", math.floor(value / 60), value % 60)
end
function Dashboard:normalizeEverydaySettings()
local s = self.settings
if not REFRESH_PROFILES[s.refresh_profile] then s.refresh_profile = "clarity" end
if s.landing_tab ~= "last" then
local valid = false
for _, tab in ipairs(DASHBOARD_TABS) do if s.landing_tab == tab.id then valid = true end end
if not valid then s.landing_tab = "last" end
end
s.night_enabled = s.night_enabled == true
s.night_start = minute_setting(s.night_start, 1320)
s.night_end = minute_setting(s.night_end, 420)
if s.night_start == s.night_end then s.night_end = (s.night_start + 540) % 1440 end
if s.night_level ~= "off" then s.night_level = "lowest" end
local o = s.night_owned
if type(o) ~= "table" or type(o.maximum) ~= "number" or o.maximum % 1 ~= 0
or o.maximum < 1 or o.maximum > 1000 or type(o.previous) ~= "number"
or o.previous % 1 ~= 0 or o.previous < 0 or o.previous > o.maximum
or (o.applied ~= 0 and o.applied ~= 1) or type(o.cycle) ~= "string"
or not o.cycle:match("^%d+$") then s.night_owned = nil end
end
function Dashboard:refreshProfile()
return REFRESH_PROFILES[self.settings.refresh_profile] or REFRESH_PROFILES.clarity
end
function Dashboard:dirtyDashboard(view, force)
local top = type(UIManager.getTopmostVisibleWidget) == "function" and UIManager:getTopmostVisibleWidget()
if UIManager.currently_scrolling or (top and top ~= view) then
self.clean_refresh_pending = true
UIManager:setDirty(view, "ui", nil, view and view.dithered)
return "ui"
end
local now, profile = os.time(), self:refreshProfile()
local count = self.partial_refreshes or 0
local full = force or self.clean_refresh_pending or not self.last_full_refresh_at
or count >= profile.changes - 1 or now < self.last_full_refresh_at
or (count > 0 and now - self.last_full_refresh_at >= profile.seconds)
if full then
self.last_full_refresh_at, self.partial_refreshes = now, 0
self.full_refresh_serial = (self.full_refresh_serial or 0) + 1
self.clean_refresh_pending = nil
else self.partial_refreshes = count + 1 end
local mode = full and "full" or (dashboard_color_enabled() and view and view.dithered and "partial" or "ui")
UIManager:setDirty(view, mode, nil, view and view.dithered)
return mode
end
function Dashboard:dashboardCovered(view)
view = view or self.view
local top = type(UIManager.getTopmostVisibleWidget) == "function" and UIManager:getTopmostVisibleWidget()
return view and top and top ~= view
end
function Dashboard:cleanScreen()
self.clean_refresh_pending = true
local view = self.camera_view or self.view
if view and type(UIManager.getTopmostVisibleWidget) == "function"
and UIManager:getTopmostVisibleWidget() == view then self:dirtyDashboard(view, true) end
end
function Dashboard:nightWindow(now)
local date = os.date("*t", now or os.time())
if type(date) ~= "table" then return false end
local minute = date.hour * 60 + date.min
local start, finish = self.settings.night_start or 1320, self.settings.night_end or 420
local wraps = start > finish
local active = wraps and (minute >= start or minute < finish)
or (not wraps and minute >= start and minute < finish)
if not active then return false end
date.hour, date.min, date.sec, date.isdst = math.floor(start / 60), start % 60, 0, nil
if wraps and minute < finish then date.day = date.day - 1 end
return true, tostring(os.time(date))
end
function Dashboard:deferCleanScreen()
if not self.running or self.suspended then return end
if self.clean_task then return end
local serial = self.full_refresh_serial or 0
local task
task = function()
if self.clean_task ~= task then return end
self.clean_task = nil
if (self.full_refresh_serial or 0) ~= serial then return end
local view = self.camera_view or self.view
if self.running and not self.suspended and view and type(UIManager.getTopmostVisibleWidget) == "function"
and UIManager:getTopmostVisibleWidget() == view then self:cleanScreen() end
end
self.clean_task = task
UIManager:nextTick(task)
end
function Dashboard:overrideNightDimming()
local active, cycle = self:nightWindow()
self.settings.night_owned = nil
if active then self.settings.night_override = cycle end
self:saveSettings()
end
function Dashboard:releaseNightDimming()
local owned = self.settings.night_owned
if type(owned) ~= "table" then self.settings.night_owned = nil; return true end
local state = self:readBrightness()
if not state then return false end
if state.maximum == owned.maximum and state.level == owned.applied then
local changed = self:setBrightnessLevel(owned.previous, true)
if not changed then return false end
end
self.settings.night_owned = nil
self:saveSettings()
return true
end
function Dashboard:applyNightDimming()
if not self.settings.night_enabled then return self:releaseNightDimming() end
local active, cycle = self:nightWindow()
if not self.settings.night_enabled or not active then
return self:releaseNightDimming()
end
if self.settings.night_override == cycle then return true end
local state = self:readBrightness()
if not state then return false end
local target = self.settings.night_level == "off" and 0 or 1
local owned = self.settings.night_owned
if type(owned) == "table" then
if owned.cycle ~= cycle then
if not self:releaseNightDimming() then return false end
state = self:readBrightness()
if not state then return false end
elseif state.maximum == owned.maximum and state.level == owned.applied then return true
else self:overrideNightDimming(); return true end
end
if state.level <= target then return true end
self.settings.night_owned = { previous = state.level, applied = target,
maximum = state.maximum, cycle = cycle }
local ok, saved = pcall(self.saveSettings, self)
if not ok or saved == false then self.settings.night_owned = nil; return false end
local changed = self:setBrightnessLevel(target, true)
if not changed then
local actual = self:readBrightness()
if not actual or actual.maximum ~= state.maximum or actual.level ~= target then
self.settings.night_owned = nil; self:saveSettings()
end
return false
end
return true
end
function Dashboard:cancelEverydayTick()
if self.everyday_task then UIManager:unschedule(self.everyday_task) end
self.everyday_task = nil
if self.clean_task then UIManager:unschedule(self.clean_task) end
self.clean_task = nil
end
function Dashboard:scheduleEverydayTick()
if self.everyday_task then UIManager:unschedule(self.everyday_task) end
self.everyday_task = nil
if not self.running or self.suspended then return end
local task
task = function()
if self.everyday_task ~= task then return end
self.everyday_task = nil
self:everydayTick()
end
self.everyday_task = task
UIManager:scheduleIn(15, task)
end
function Dashboard:everydayTick()
if not self.running or self.suspended then return end
self:applyNightDimming()
self:refreshSelfHealthIndicator()
local view = self.camera_view or self.view
local top = type(UIManager.getTopmostVisibleWidget) == "function" and UIManager:getTopmostVisibleWidget()
local native = top and (top == self.printer_controls_menu or top == self.plex_stream_menu or top == self.media_tracker_menu)
if native then view = top end
local visible = view and top == view
if visible and not UIManager.currently_scrolling and (native or (self.quick_menu_count or 0) == 0)
and (self.clean_refresh_pending or ((self.partial_refreshes or 0) > 0
and os.time() - (self.last_full_refresh_at or 0) >= self:refreshProfile().seconds)) then
self:dirtyDashboard(view, true)
end
self:scheduleEverydayTick()
end
function Dashboard:showLandingSettings()
local items = { { text = "Remember last tab", close_on_select = true, callback = function()
self.settings.landing_tab = "last"; self:saveSettings() end } }
for _, tab in ipairs(DASHBOARD_TABS) do
local id, label = tab.id, tab.label
items[#items + 1] = { text = "Always open " .. label, close_on_select = true,
callback = function() self.settings.landing_tab = id; self:saveSettings() end }
end
self:showQuickMenu("Preferred landing screen", items)
end
function Dashboard:showNightSchedule()
if self.night_schedule_dialog then UIManager:close(self.night_schedule_dialog) end
local dialog
dialog = MultiInputDialog:new { title = "Night dimming · Kindle local time",
fields = { { text = clock_label(self.settings.night_start), hint = "Start HH:MM" },
{ text = clock_label(self.settings.night_end), hint = "End HH:MM" } },
buttons = { { { text = "Cancel", callback = function() UIManager:close(dialog) end },
{ text = "Save", callback = function()
local values = dialog:getFields()
local function parse(value)
local h, m = tostring(value):match("^(%d%d):(%d%d)$")
h, m = tonumber(h), tonumber(m)
return h and h < 24 and m < 60 and h * 60 + m or nil
end
local start, finish = parse(values[1]), parse(values[2])
if not start or not finish or start == finish then
self:notice("Use HH:MM (00:00–23:59), with different start and end times.", 7); return
end
if not self:releaseNightDimming() then self:notice("Could not restore the light; schedule unchanged.", 7); return end
self.settings.night_start, self.settings.night_end = start, finish
self.settings.night_override = nil
self:saveSettings(); if self.running then self:applyNightDimming() end; UIManager:close(dialog)
end } } } }
local original = dialog.onCloseWidget
dialog.onCloseWidget = function(widget)
self.quick_menu_count = math.max(0, (self.quick_menu_count or 1) - 1)
if self.night_schedule_dialog == widget then self.night_schedule_dialog = nil end
if original then original(widget) end
self:deferCleanScreen()
end
self.night_schedule_dialog = dialog
self.quick_menu_count = (self.quick_menu_count or 0) + 1
UIManager:show(dialog)
dialog:onShowKeyboard()
end
function Dashboard:showEverydaySettings()
local s, items = self.settings, {}
items[#items + 1] = { text = dashboard_color_enabled() and "Color: On · Colorsoft palette" or "Color: unavailable / disabled in KOReader",
callback = function() self:notice("The dashboard honors KOReader color rendering. On Colorsoft, enable Color rendering in KOReader's screen settings if colors are absent. Reader preferences are not changed automatically.", 15) end }
local landing = s.landing_tab == "last" and "Last tab" or DASHBOARD_TABS[tab_index_for_id(s.landing_tab)].label
items[#items + 1] = { text = "Landing screen: " .. landing, close_on_select = true,
callback = function() self:showLandingSettings() end }
items[#items + 1] = { text = "Clean screen now", close_on_select = true, enabled_func = function() return self.running end,
callback = function() self:cleanScreen() end }
for _, key in ipairs({ "clarity", "balanced", "low_flash", "always" }) do
local id, profile = key, REFRESH_PROFILES[key]
items[#items + 1] = { text = (s.refresh_profile == id and "✓ " or "") .. profile.label
.. " · clean every " .. profile.changes .. " paints / " .. profile.seconds .. "s",
close_on_select = true, callback = function()
s.refresh_profile = id; self:saveSettings(); self:cleanScreen() end }
end
items[#items + 1] = { text = "Night dimming: " .. (s.night_enabled and "On" or "Off"),
close_on_select = true, callback = function()
if s.night_enabled and not self:releaseNightDimming() then
self:notice("Could not restore the light; dimming remains enabled.", 7); return
end
s.night_enabled = not s.night_enabled; s.night_override = nil
self:saveSettings(); if self.running then self:applyNightDimming() end
end }
items[#items + 1] = { text = "Night schedule: " .. clock_label(s.night_start) .. "–" .. clock_label(s.night_end),
close_on_select = true, callback = function() self:showNightSchedule() end }
items[#items + 1] = { text = "Night level: " .. (s.night_level == "off" and "Light off" or "Lowest hardware step"),
close_on_select = true, callback = function()
if not self:releaseNightDimming() then self:notice("Light could not be restored.", 7); return end
s.night_level = s.night_level == "off" and "lowest" or "off"
s.night_override = nil; self:saveSettings(); if self.running then self:applyNightDimming() end
end }
items[#items + 1] = { text = "Kindle clock: " .. os.date("%Y-%m-%d %H:%M %Z")
.. "\nNight automation runs only while this dashboard is open. Manual brightness overrides tonight.",
enabled_func = function() return false end }
self:showQuickMenu("Everyday Kindle behavior", items)
end
local function private_cache_directory(create)
local ffi = require("ffi")
pcall(ffi.cdef, "int chmod(const char *path, unsigned int mode);")
for _, directory in ipairs({ TOKEN_DIRECTORY, PRIVATE_CACHE_DIRECTORY }) do
local mode = lfs.symlinkattributes(directory, "mode")
if not mode and create then
if not lfs.mkdir(directory) then return nil end
if ffi.C.chmod(directory, 448) ~= 0 then return nil end -- 0700
mode = lfs.symlinkattributes(directory, "mode")
end
if mode ~= "directory" or lfs.attributes(directory, "permissions") ~= "rwx------" then
return nil
end
end
return PRIVATE_CACHE_DIRECTORY
end
local function cache_slot_path(directory, tab, slot)
return directory .. "/" .. tab.id .. "-" .. slot
end
local function read_private_cache_file(path, maximum)
if lfs.symlinkattributes(path, "mode") ~= "file"
or lfs.attributes(path, "permissions") ~= "rw-------" then return nil end
local file = io.open(path, "rb")
if not file then return nil end
local data = file:read(maximum + 1)
file:close()
if not data or #data < 1 or #data > maximum then return nil end
return data
end
local function read_cache_slot(directory, tab, slot, sha256)
local prefix = cache_slot_path(directory, tab, slot)
local metadata = read_private_cache_file(prefix .. ".meta", 256)
if not metadata then return nil end
local serial, tab_id, stamp, length, digest = metadata:match(
"^KPC2\n([^\n]+)\n([^\n]+)\n(%d+)\n(%d+)\n([0-9a-f]+)\n$")
local image_time_known = serial ~= nil
if not serial then serial, tab_id, stamp, length, digest = metadata:match(
"^KPC1\n([^\n]+)\n([^\n]+)\n(%d+)\n(%d+)\n([0-9a-f]+)\n$")
end
if serial ~= DEVICE_SERIAL or tab_id ~= tab.id or not stamp or #digest ~= 64 then
return nil
end
local timestamp, bytes = tonumber(stamp), tonumber(length)
local now = os.time()
if not timestamp or not bytes or timestamp > now + 300
or now - timestamp > CACHE_MAX_AGE or bytes < 1
or bytes > MAX_CACHED_IMAGE_BYTES then return nil end
local png = read_private_cache_file(prefix .. ".png", MAX_CACHED_IMAGE_BYTES)
if not png or #png ~= bytes or sha256(png) ~= digest or not png_size(png) then
return nil
end
return { png = png, last_success_at = timestamp,
image_received_at = image_time_known and timestamp or nil, slot = slot }
end
local function write_private_cache_file(path, data)
local ffi = require("ffi")
pcall(ffi.cdef, "int chmod(const char *path, unsigned int mode);")
local temp = path .. ".new-" .. tostring(os.time()) .. "-"
.. tostring(math.random(100000, 999999))
local file = io.open(temp, "wb")
if not file then return false end
if ffi.C.chmod(temp, 384) ~= 0 -- 0600
or lfs.attributes(temp, "permissions") ~= "rw-------" then
file:close()
os.remove(temp)
return false
end
local wrote = file:write(data)
local closed = file:close()
if not wrote or not closed or not os.rename(temp, path) then
os.remove(temp)
return false
end
return true
end
local function remove_interrupted_cache_writes(directory)
for name in lfs.dir(directory) do
local id, slot, extension = name:match(
"^([a-z]+)%-([ab])%.([a-z]+)%.new%-%d+%-%d+$")
if id and slot and (extension == "png" or extension == "meta") then
for _, tab in ipairs(DASHBOARD_TABS) do
if id == tab.id then
local path = directory .. "/" .. name
if lfs.symlinkattributes(path, "mode") == "file"
and lfs.attributes(path, "permissions") == "rw-------" then
os.remove(path)
end
break
end
end
end
end
end
local function load_cached_images()
local images, slots, written = {}, {}, {}
local directory = private_cache_directory(false)
local ok, sha2 = pcall(require, "ffi/sha2")
if not directory or not ok or type(sha2.sha256) ~= "function" then
return images, slots, written
end
pcall(remove_interrupted_cache_writes, directory)
for index, tab in ipairs(DASHBOARD_TABS) do
local first = read_cache_slot(directory, tab, "a", sha2.sha256)
local second = read_cache_slot(directory, tab, "b", sha2.sha256)
local newest = first and second
and (first.last_success_at >= second.last_success_at and first or second)
or first or second
if newest then
images[index] = { png = newest.png, last_success_at = newest.last_success_at,
image_received_at = newest.image_received_at }
slots[index] = newest.slot
written[index] = newest.last_success_at
end
end
return images, slots, written
end
local function remove_private_cached_images()
local directory = private_cache_directory(false)
if not directory then
if lfs.symlinkattributes(PRIVATE_CACHE_DIRECTORY, "mode") == nil then
return true
end
return false
end
local paths = {}
for _, tab in ipairs(DASHBOARD_TABS) do
for _, slot in ipairs({ "a", "b" }) do
local prefix = cache_slot_path(directory, tab, slot)
for _, extension in ipairs({ ".png", ".meta" }) do
local path = prefix .. extension
local mode = lfs.symlinkattributes(path, "mode")
if mode then
if mode ~= "file"
or lfs.attributes(path, "permissions") ~= "rw-------" then
return false
end
paths[#paths + 1] = path
end
end
end
end
for _, path in ipairs(paths) do
if lfs.symlinkattributes(path, "mode") ~= "file"
or lfs.attributes(path, "permissions") ~= "rw-------"
or not os.remove(path) then
return false
end
end
return true
end
local function jpeg_size(data)
if #data < 12 or data:sub(1, 2) ~= "\255\216" or data:sub(-2) ~= "\255\217" then
return nil
end
local i = 3
while i + 9 <= #data do
if data:byte(i) ~= 255 then return nil end
local marker = data:byte(i + 1)
while marker == 255 do
i = i + 1
marker = data:byte(i + 1)
end
if not marker or marker == 0 or marker == 217 or marker == 218 then return nil end
if marker >= 208 and marker <= 215 then
i = i + 2
else
local length = data:byte(i + 2) * 256 + data:byte(i + 3)
if length < 2 or i + 1 + length > #data then return nil end
if (marker >= 192 and marker <= 195) or (marker >= 197 and marker <= 199)
or (marker >= 201 and marker <= 203) or (marker >= 205 and marker <= 207) then
if length < 7 then return nil end
local height = data:byte(i + 5) * 256 + data:byte(i + 6)
local width = data:byte(i + 7) * 256 + data:byte(i + 8)
if width < 64 or height < 64 or width > 4096 or height > 4096
or width * height > 8000000 then return nil end
return width, height
end
i = i + length + 2
end
end
return nil
end
local PLEX_RECEIPT_ACTIONS = {
approve = true, scan = true, request = true, restart_service = true,
refresh_metadata = true, flush_seerr_cache = true, terminate_stream = true,
}
local function plex_receipt_uuid(value)
if type(value) ~= "string" or value ~= value:lower() then return false end
local a, b, c, d, e = value:match("^(%x+)%-(%x+)%-(%x+)%-(%x+)%-(%x+)$")
return a and #a == 8 and #b == 4 and #c == 4 and #d == 4 and #e == 12
end
local function plex_receipt_open_flags(ffi)
if ffi.os ~= "Linux" then return nil end
local directory, nofollow
if ffi.arch == "arm" or ffi.arch == "arm64" then
directory, nofollow = 16384, 32768
elseif ffi.arch == "x86" or ffi.arch == "x64" then
directory, nofollow = 65536, 131072
else
return nil
end
return {
create = 1 + 64 + 128 + nofollow + 524288,
directory = directory + nofollow + 524288,
}
end
local function plex_receipt_ffi()
local ffi = require("ffi")
pcall(ffi.cdef, [[
        int open(const char *path, int flags, ...);
        long write(int fd, const void *data, unsigned long size);
        int fsync(int fd);
        int close(int fd);
    ]])
return ffi
end
local function write_plex_receipt(value)
local ffi = plex_receipt_ffi()
local flags = plex_receipt_open_flags(ffi)
if not flags then return false end
local directory = private_cache_directory(true)
if not directory then return false end
local path = directory .. "/plex-action.json"
local mode = lfs.symlinkattributes(path, "mode")
if mode and (mode ~= "file" or lfs.attributes(path, "permissions") ~= "rw-------") then return false end
local ok, encoded = pcall(require("json").encode, value)
local maximum = value.state == "clear" and 16384 or 8192
if not ok or type(encoded) ~= "string" or #encoded > maximum then return false end
local temporary = path .. ".new-" .. require("random").uuid(true):lower()
local fd = ffi.C.open(temporary, flags.create, ffi.cast("unsigned int", 384))
if fd < 0 then return false end
local offset = 0
while offset < #encoded do
local wrote = tonumber(ffi.C.write(fd, encoded:sub(offset + 1), #encoded - offset))
if not wrote or wrote <= 0 then break end
offset = offset + wrote
end
local synced = offset == #encoded and ffi.C.fsync(fd) == 0
local closed = ffi.C.close(fd) == 0
if not synced or not closed or not os.rename(temporary, path) then
os.remove(temporary)
return false
end
local directory_fd = ffi.C.open(directory, flags.directory) -- DIRECTORY|NOFOLLOW|CLOEXEC.
if directory_fd < 0 then return false end
local directory_synced = ffi.C.fsync(directory_fd) == 0
local directory_closed = ffi.C.close(directory_fd) == 0
return directory_synced and directory_closed
and read_private_cache_file(path, maximum) == encoded
end
function Dashboard:restorePlexReceipt()
local directory = private_cache_directory(true)
if not directory then self.plex_receipt_error = true; return end
local path = directory .. "/plex-action.json"
if not lfs.symlinkattributes(path, "mode") then return end
local body = read_private_cache_file(path, 16384)
local ok, receipt = pcall(require("json").decode, body)
if not ok or type(receipt) ~= "table" or receipt.schema ~= 1 then
self.plex_receipt_error = true; return
end
if receipt.state == "clear" then return end
if receipt.state ~= "pending" or not plex_receipt_uuid(receipt.id)
or not PLEX_RECEIPT_ACTIONS[receipt.action]
or type(receipt.label) ~= "string" or #receipt.label < 1 or #receipt.label > 100
or type(receipt.started_at) ~= "number" or receipt.started_at ~= receipt.started_at
or receipt.started_at < 0 or receipt.started_at == math.huge
or type(receipt.payload) ~= "table" or receipt.payload.request_id ~= receipt.id
or receipt.payload.action ~= receipt.action or self.active_plex_command then
self.plex_receipt_error = true; return
end
self.active_plex_command = receipt
end
function Dashboard:readKeepAlive()
if type(Device.isKindle) ~= "function" or not Device:isKindle() then
return nil, "KeepAlive is supported here only on Kindle."
end
local ok, state = pcall(function()
if not self.keepalive_handle then
local lipc = require("liblipclua")
if type(lipc.init) ~= "function" then return nil end
self.keepalive_handle = lipc.init("com.github.koreader.inkboard.keepalive")
end
local handle = self.keepalive_handle
if not handle then return nil end
local value = handle:get_int_property("com.lab126.powerd", "preventScreenSaver")
if value ~= 0 and value ~= 1 then return nil end
return { handle = handle, enabled = value == 1, owned = self.keepalive_owned == true }
end)
if not ok or not state then return nil, "Kindle KeepAlive could not be verified. Manual sleep remains available." end
return state
end
function Dashboard:applyKeepAliveDefault()
if self.keepalive_closed then return false end
if self.settings.keepalive_default == false or self.suspended then return true end
local state, reason = self:readKeepAlive()
if state and not state.enabled then
self.keepalive_owned = true
local changed = pcall(function()
state.handle:set_int_property("com.lab126.powerd", "preventScreenSaver", 1)
end)
local actual = self:readKeepAlive()
if not changed or not actual or not actual.enabled then
if actual and not actual.enabled then PluginShare.keepalive = false end
state, reason = nil, "Kindle KeepAlive did not enable; its current state is unverified."
else
state = actual
end
end
if not state then
if self.keepalive_last_error ~= reason then self:notice(reason, 8) end
self.keepalive_last_error = reason
return false
end
PluginShare.keepalive = true
self.keepalive_last_error = nil
return true
end
function Dashboard:releaseOwnedKeepAlive()
if not self.keepalive_owned then return true end
local state, reason = self:readKeepAlive()
if not state then return false, reason end
if state.enabled then
local changed = pcall(function()
state.handle:set_int_property("com.lab126.powerd", "preventScreenSaver", 0)
end)
local actual = self:readKeepAlive()
if not changed or not actual or actual.enabled then
return false, "Dashboard KeepAlive could not be released; use KOReader's Keep alive → Close if needed."
end
end
self.keepalive_owned = false
PluginShare.keepalive = false
return true
end
function Dashboard:toggleKeepAliveDefault()
self.settings.keepalive_default = self.settings.keepalive_default == false
local saved = self:saveSettings()
if saved == false then self:notice("The startup choice could not be saved. Check KOReader storage.", 8) end
if self.settings.keepalive_default then
self:applyKeepAliveDefault()
else
local released, reason = self:releaseOwnedKeepAlive()
if not released then self:notice(reason, 8) end
end
end
function Dashboard:showKeepAliveStatus()
local state, reason = self:readKeepAlive()
local lines = { "At KOReader startup: " .. (self.settings.keepalive_default ~= false and "On" or "Off"),
"Current Kindle state: " .. (state and (state.enabled and "KeepAlive on (verified)" or "KeepAlive off (verified)") or "Unknown"),
"", "KeepAlive is applied at KOReader startup and dashboard start/resume. It is not forced on each refresh.",
"Manual sleep releases the dashboard's own inhibition; wake applies your startup choice again.",
"Closing the dashboard keeps the KOReader instance alive. Exiting KOReader releases only the inhibition this dashboard enabled.",
"", "KeepAlive uses more battery. The startup switch stays off across restarts when you turn it off." }
if reason then lines[#lines + 1] = "\n" .. reason end
if state and state.enabled and not self.keepalive_owned then
lines[#lines + 1] = "\nKeepAlive was already active from another source; this dashboard will not turn that inhibition off."
end
self:showWindowsText("KeepAlive", lines)
end
function Dashboard:init()
local bootstrap_result, bootstrap_error, bootstrap_reader_path,
bootstrap_control_path, bootstrap_mtp_fallback = import_token_bootstrap()
self.settings_file = LuaSettings:open(DataStorage:getSettingsDir() .. "/kindleprinter.lua")
self.settings = self.settings_file:readSetting("settings") or {}
self.settings.base_url = self.settings.base_url or PUBLIC_BASE
self.settings.proxy_mode = self.settings.proxy_mode or "https"
self.settings.token_file = bootstrap_reader_path or self.settings.token_file or TOKEN_FILE
self.settings.control_token_file = bootstrap_control_path
or self.settings.control_token_file or CONTROL_TOKEN_FILE
local refresh_seconds = tonumber(self.settings.refresh_seconds)
self.settings.refresh_seconds = refresh_seconds and refresh_seconds % 1 == 0
and math.max(60, math.min(900, refresh_seconds)) or 60
self.settings.keep_awake = self.settings.keep_awake ~= false
local keepalive_default_added = self.settings.keepalive_default == nil
self.settings.keepalive_default = self.settings.keepalive_default ~= false
self.keepalive_closed = false
self.settings.full_refresh_every = tonumber(self.settings.full_refresh_every) or 5
self:normalizeEverydaySettings()
if self.settings.traffic_window ~= "5m" and self.settings.traffic_window ~= "1h"
and self.settings.traffic_window ~= "24h" then self.settings.traffic_window = "5m" end
if self.settings.traffic_view ~= "pages" and self.settings.traffic_view ~= "sites" then self.settings.traffic_view = "pages" end
self.running = false
self.suspended = false
self.standby_held = false
self.failure_count = 0
self.stable_polls = {}
self.screen_changes = 0
self.last_request_at = 0
self.active_tab = tab_index_for_id(self.settings.active_tab)
local loaded, cached, slots, written = pcall(load_cached_images)
if self.settings.proxy_mode ~= "https" or self.settings.base_url ~= PUBLIC_BASE then
loaded = false
end
self.tab_cache = loaded and cached or {}
self.tab_cache[5] = nil
self.cache_slots = loaded and slots or {}
self.cache_written_at = loaded and written or {}
self.cache_failure_notified = false
self.offline_banner = nil
self.tab_header_height = TAB_HEADER_MIN_HEIGHT
self.view = nil
self.view_kind = nil
self.view_text = nil
self.poll_task = function() self:poll() end
self.command_poll_task = function() self:pollCommand() end
self:restorePrinterCommands()
self.doctor_poll_task = function() self:pollDoctor() end
self.active_doctor = nil
self.quick_menu_count = 0
self.camera_poll_task = function() self:pollCamera() end
self.camera_view = nil
self.camera_printer = nil
self.camera_etag = nil
self.camera_changes = 0
self.camera_last_changed_at = nil
self.camera_delay_noticed_at = nil
self.camera_last_captured_at = nil
self.plex_command_poll_task = function() self:pollPlexCommand() end
self.active_plex_command = nil
local saved_delete_command = self.settings.plex_delete_command
if type(saved_delete_command) == "table"
and type(saved_delete_command.id) == "string"
and #saved_delete_command.id == 36
and saved_delete_command.id:match("^[0-9a-f%-]+$")
and type(saved_delete_command.label) == "string"
and #saved_delete_command.label > 0
and #saved_delete_command.label <= 100 then
self.active_plex_command = { id = saved_delete_command.id,
action = "delete_media", label = saved_delete_command.label,
started_at = os.time() }
else
self.settings.plex_delete_command = nil
end
self.plex_receipt_error = false
self:restorePlexReceipt()
self.ebook_poll_task = function() self:pollOptionalEbooks() end
self.active_ebook_job = nil
self:restoreOptionalEbookReceipt()
self.plex_search_poll_task = function() self:pollPlexSearch() end
self.active_plex_search = nil
self.plex_details_poll_task = function() self:pollPlexDetails() end
self.active_plex_details = nil
self.subtitle_catalog_poll_task = function() self:pollSubtitleCatalog() end
self.active_subtitle_catalog = nil
self.subtitle_job_poll_task = function() self:pollSubtitleJob() end
self.active_subtitle_job = nil
self.last_subtitle_job = nil
local saved_subtitle_job = self.settings.subtitle_job
if type(saved_subtitle_job) == "table" and type(saved_subtitle_job.id) == "string"
and #saved_subtitle_job.id == 36
and saved_subtitle_job.id:match("^[0-9a-f%-]+$")
and type(saved_subtitle_job.label) == "string"
and #saved_subtitle_job.label <= 100 then
self.active_subtitle_job = { id = saved_subtitle_job.id,
label = saved_subtitle_job.label, state = "queued" }
else
self.settings.subtitle_job = nil
end
self.ui.menu:registerToMainMenu(self)
if bootstrap_result or keepalive_default_added then self:saveSettings() end
self.keepalive_startup_task = function()
self.keepalive_startup_task = nil
if not self.keepalive_closed then self:applyKeepAliveDefault() end
end
UIManager:nextTick(self.keepalive_startup_task)
if bootstrap_result ~= nil then
UIManager:nextTick(function()
self:notice(bootstrap_result
and (bootstrap_mtp_fallback
and "Tokens imported to MTP-visible KOReader settings. Inspect storage before sharing the Kindle."
or "Reader and control tokens were imported privately.")
or bootstrap_error, 8)
end)
end
self:queueAutoStart()
end
function Dashboard:queueAutoStart()
local saved_auto_start = not not self.settings_file:readSetting("auto_start")
if saved_auto_start then
UIManager:nextTick(function() self:startDashboard(true) end)
elseif boot_launch_enabled() then
self.boot_auto_start_task = function()
self.boot_auto_start_task = nil
if boot_launch_enabled() then self:startDashboard(false) end
end
UIManager:scheduleIn(2, self.boot_auto_start_task)
end
end
function Dashboard:onFlushSettings()
if self.settings_file then
self.settings_file:saveSetting("settings", self.settings)
return self.settings_file:flush()
end
return false
end
function Dashboard:saveSettings()
return self:onFlushSettings()
end
function Dashboard:saveCachedPng(index, data, timestamp)
if index == 5 then return nil end
if self.settings.proxy_mode ~= "https"
or self.settings.base_url ~= PUBLIC_BASE then return nil end
if type(data) ~= "string" or #data > MAX_CACHED_IMAGE_BYTES
or not png_size(data) then return false end
local previous = self.cache_written_at[index]
if previous and timestamp - previous < CACHE_WRITE_INTERVAL then return nil end
local directory = private_cache_directory(true)
local ok, sha2 = pcall(require, "ffi/sha2")
if not directory or not ok or type(sha2.sha256) ~= "function" then return false end
local tab = DASHBOARD_TABS[index]
if not tab then return false end
local slot = self.cache_slots[index] == "a" and "b" or "a"
local prefix = cache_slot_path(directory, tab, slot)
local digest = sha2.sha256(data)
local metadata = "KPC2\n" .. DEVICE_SERIAL .. "\n" .. tab.id .. "\n"
.. tostring(timestamp) .. "\n" .. tostring(#data) .. "\n" .. digest .. "\n"
if write_private_cache_file(prefix .. ".png", data)
and write_private_cache_file(prefix .. ".meta", metadata) then
local checked = read_cache_slot(directory, tab, slot, sha2.sha256)
if checked and checked.last_success_at == timestamp then
self.cache_slots[index] = slot
self.cache_written_at[index] = timestamp
return true
end
end
return false
end
function Dashboard:persistCachedPng(index, data, timestamp)
local ok, saved = pcall(self.saveCachedPng, self, index, data, timestamp)
if (not ok or saved == false) and not self.cache_failure_notified then
self.cache_failure_notified = true
logger.warn("Printer Dashboard: private image cache is unavailable")
self:notice("Saved view unavailable; check Kindle storage.", 7)
end
end
function Dashboard:clearSavedImages()
local ok, cleared = pcall(remove_private_cached_images)
if not ok or not cleared then
self:notice("Saved views could not be cleared. Check Kindle storage.", 8)
return false
end
self.tab_cache = {}
self.cache_slots = {}
self.cache_written_at = {}
self.cache_failure_notified = false
self.offline_banner = nil
self:notice("Saved dashboard images cleared.", 6)
if self.running and not self.suspended then
self.last_request_at = 0
self:schedulePoll(1)
end
return true
end
function Dashboard:setAutoStart(enabled)
self.settings_file:saveSetting("auto_start", enabled)
self.settings_file:flush()
end
function Dashboard:holdStandby()
if self.settings.keep_awake and not self.standby_held then
UIManager:preventStandby()
self.standby_held = true
end
end
function Dashboard:releaseStandby()
if self.standby_held then
UIManager:allowStandby()
self.standby_held = false
end
end
function Dashboard:cancelPoll()
UIManager:unschedule(self.poll_task)
end
function Dashboard:schedulePoll(delay)
self:cancelPoll()
if self.running and not self.suspended then
UIManager:scheduleIn(delay, self.poll_task)
end
end
function Dashboard:normalPollDelay()
if self.active_tab == 1 then return 15 end
local base = tonumber(self.settings.refresh_seconds) or 60
local unchanged = self.stable_polls and self.stable_polls[self.active_tab] or 0
local delay = unchanged >= 2 and math.min(900, math.max(base, math.min(120, base * 2)))
or base
if battery_is_low() then delay = math.min(900, math.max(delay, 180)) end
return delay
end
function Dashboard:retryPollDelay(disconnected)
local base, ceiling = disconnected and 5 or 10, disconnected and 30 or 60
return math.min(ceiling, base * (2 ^ math.min(self.failure_count - 1, 4)))
end
function Dashboard:showCachedOrConnecting(label)
if self.active_tab == 6 then
self:renderAlerts(self.alerts_context or self.alerts_cache or { fetched_at = os.time() })
return
end
local cache = self.tab_cache[self.active_tab]
if cache and cache.png then
self.offline_banner = "SAVED VIEW | " .. self:cachedViewStamp(cache) .. " | refreshing"
if self:showPng(cache.png) then return end
end
self.offline_banner = nil
self:showText(label, "Connecting...")
end
local function health_read(object, method)
local ok, value = pcall(function()
if (type(object) ~= "table" and type(object) ~= "userdata") or type(object[method]) ~= "function" then return nil end
return object[method](object)
end)
if ok then return value end
end
local function health_stamp(value)
if type(value) ~= "number" or value ~= value or value <= 0 or value == math.huge then return "Unknown" end
local ok, text = pcall(os.date, "%Y-%m-%d %H:%M:%S", value)
return ok and text or "Unknown"
end
function Dashboard:selfHealthState()
local connected = health_read(NetworkMgr, "isConnected")
if type(connected) ~= "boolean" then connected = nil end
local radio = health_read(NetworkMgr, "isWifiOn")
if type(radio) ~= "boolean" then radio = nil end
local power = health_read(Device, "getPowerDevice")
local capacity, charging = health_read(power, "getCapacity"), health_read(power, "isCharging")
if type(capacity) ~= "number" or not (capacity >= 0 and capacity <= 100) then capacity = nil end
if capacity then capacity = math.floor(capacity + .5) end
if type(charging) ~= "boolean" then charging = nil end
local version = self:getClientProvenance()
local checked = self.health_refresh and self.health_refresh[self.active_tab]
local age = checked and os.time() - checked
local delay = self.active_tab == 6 and 12 or self:normalPollDelay()
local stale_after = math.max(60, delay * 2 + 15)
local label, accent, explanation = "Health", "green", "This tab's dashboard delivery is current."
if not self.running then label, accent, explanation = "Stopped", "amber", "Start the dashboard to resume automatic refreshes."
elseif self.suspended then label, accent, explanation = "Paused", "amber", "Refreshes are paused while the Kindle is suspended."
elseif connected == false then label, accent, explanation = "Offline", "red", "The Kindle has no Wi-Fi connection. Saved information remains visible."
elseif self.health_failure and self.health_failure[self.active_tab] then label, accent, explanation = "Check", "amber", "The latest refresh of this tab failed. Its saved view is retained."
elseif age and age < 0 then label, accent, explanation = "Clock", "amber", "The Kindle clock changed. Refresh this tab to establish a new check time."
elseif not age then label, accent, explanation = "Waiting", "amber", "This tab has not completed a validated refresh during this KOReader session."
elseif age > stale_after then label, accent, explanation = "Stale", "amber", "This tab has missed its expected refresh window. Refresh it to verify delivery."
elseif capacity and capacity <= 10 and charging ~= true then label, accent, explanation = "Battery", "red", "The Kindle battery is low. Connect a charger."
elseif capacity and capacity <= 20 and charging ~= true then label, accent, explanation = "Battery", "amber", "The Kindle battery is low. Connect a charger when convenient."
elseif version.restart_required then label, accent, explanation = "Reopen", "amber", "New client files are installed. Exit and reopen KOReader to load them."
elseif not version.installed_version then label, accent, explanation = "Check", "amber", "The installed software version is unavailable. The loaded client is still running."
elseif connected == nil then label, accent, explanation = "Check", "amber", "KOReader could not report the Kindle's connection state. The last relay check is shown below."
elseif capacity == nil then label, accent, explanation = "Check", "amber", "The Kindle battery level could not be read."
end
local battery = capacity and (tostring(capacity) .. "%") or "?%"
local charge = charging == true and "Charging" or charging == false and "Not charging" or "Charging unknown"
local wifi = connected == true and "Connected" or connected == false and (radio == false and "Off" or "Disconnected") or "Unknown"
return { label = label, accent = accent, explanation = explanation, connected = connected,
radio = radio, capacity = capacity, charging = charging, battery = battery, charge = charge, wifi = wifi,
checked_at = checked, age = age, stale_after = stale_after, version = version,
indicator = label .. "\n" .. battery .. (charging == true and " +" or "") }
end
function Dashboard:noteHealthRefresh(checked_at)
self.health_refresh = self.health_refresh or {}
self.health_failure = self.health_failure or {}
self.health_refresh[self.active_tab] = checked_at or os.time()
self.health_failure[self.active_tab] = nil
self:refreshSelfHealthIndicator()
end
function Dashboard:noteAlertHealth(context, fresh)
if self.active_tab ~= 6 or fresh ~= true then return end
if context.failure then self:noteHealthFailure()
elseif context.data and (context == self.alerts_cache or context == self.alerts_history_cache) then
self:noteHealthRefresh(context.fetched_at)
end
end
function Dashboard:noteHealthFailure()
self.health_failure = self.health_failure or {}
self.health_failure[self.active_tab] = true
self:refreshSelfHealthIndicator()
end
function Dashboard:refreshSelfHealthIndicator()
local widget = self.health_indicator
if not widget or not self.view or self:dashboardCovered() then return end
local state = self:selfHealthState()
if self.health_indicator_key == state.indicator .. state.accent then return end
self.health_indicator_key = state.indicator .. state.accent
widget.fgcolor = dashboard_color(state.accent)
if type(widget.setText) == "function" then widget:setText(state.indicator) else widget.text = state.indicator end
if self.health_indicator_frame then self.health_indicator_frame.color = dashboard_color(state.accent) end
self:dirtyDashboard(self.view)
end
function Dashboard:showSelfHealthReport()
local s = self:selfHealthState()
local cache = self.tab_cache and self.tab_cache[self.active_tab]
local lines = { s.explanation, "", "Wi-Fi: " .. s.wifi .. " (local connection; relay reachability is separate).",
"Battery: " .. s.battery .. " · " .. s.charge,
"Loaded client: " .. s.version.running_version,
"Client loaded: " .. health_stamp(s.version.loaded_at),
"Installed files: " .. (s.version.installed_version or "Unknown"),
s.version.restart_required and "Exit and reopen KOReader to load the installed files."
or s.version.installed_version and "Loaded software matches the installed version."
or "Installed version unavailable; the loaded client is still running.",
"", "Current tab: " .. DASHBOARD_TABS[self.active_tab].label,
"Last successful refresh: " .. (s.checked_at and health_stamp(s.checked_at) or "None this session"),
"Refresh age: " .. (s.age and s.age >= 0 and (tostring(math.floor(s.age)) .. " seconds") or s.age and "Clock changed" or "Unknown"),
"Attention after: " .. tostring(s.stale_after) .. " seconds without a successful refresh.",
"Times use the Kindle's local clock.", "",
"Only a validated dashboard response qualifies. Commands, cameras and background alert checks do not refresh this tab's health.",
"An unchanged image can pass a fresh relay check without its image receipt time changing.",
"Dashboard delivery does not prove every service's data is current; check tab warnings and Alerts for service health." }
if cache then lines[#lines + 1] = "Saved image: " .. self:cachedViewStamp(cache) end
self:showAlertText("Dashboard self-health", lines)
end
function Dashboard:connectSelfHealthWifi()
local function complete()
if self.running and not self.suspended then self.last_request_at = 0; self:schedulePoll(.2) end
end
local method = health_read(NetworkMgr, "isWifiOn") == false
and "turnOnWifiAndWaitForConnection" or "reconnectOrShowNetworkMenu"
if type(NetworkMgr[method]) ~= "function" then self:notice("KOReader Wi-Fi settings are unavailable. Open its Network menu and then refresh.", 10); return end
local ok = pcall(NetworkMgr[method], NetworkMgr, complete, true)
if not ok then self:notice("Wi-Fi connection could not start. Open KOReader's Network menu and then refresh.", 10) end
end
function Dashboard:showSelfHealth()
local s = self:selfHealthState()
local checked = s.checked_at and health_stamp(s.checked_at) or "None this session"
self:showQuickMenu("Dashboard health · " .. s.label, {
{ text = "Wi-Fi: " .. s.wifi .. "   /   Battery: " .. s.battery .. " · " .. s.charge,
callback = function() self:showSelfHealthReport() end },
{ text = "Loaded: " .. s.version.running_version .. (s.version.restart_required and " · reopen required" or ""),
callback = function() self:showSelfHealthReport() end },
{ text = "Last successful refresh: " .. checked, callback = function() self:showSelfHealthReport() end },
{ text = "Full self-health details", callback = function() self:showSelfHealthReport() end },
{ text = "Refresh current tab", close_on_select = true, callback = function()
self.last_request_at = 0
if not self.running then self:startDashboard(false, true) else self:schedulePoll(.2) end
end },
{ text = "Connect / reconnect Wi-Fi", close_on_select = true, callback = function() self:connectSelfHealthWifi() end },
{ text = "Check for Wi-Fi update", close_on_select = true, callback = function() self:checkWifiUpdate() end },
})
end
function Dashboard:makeInputView(content)
local width, height = Screen:getWidth(), Screen:getHeight()
local view = InputContainer:new {
dimen = Geom:new { x = 0, y = 0, w = width, h = height },
covers_fullscreen = true,
content,
}
local range = Geom:new { x = 0, y = 0, w = width, h = height }
view.ges_events = {
RefreshDashboard = { GestureRange:new { ges = "tap", range = range } },
CloseDashboard = { GestureRange:new { ges = "hold", range = range } },
OpenPrinterControls = { GestureRange:new { ges = "swipe", range = range } },
}
view.onRefreshDashboard = function(_, _args, gesture)
local pos = gesture and gesture.pos
if pos and type(pos.x) == "number" and type(pos.y) == "number"
and pos.x >= 0 and pos.x < width and pos.y >= 0 and pos.y < TAB_HEADER_MIN_HEIGHT then
local selected = math.floor(pos.x / math.max(1, math.floor(width / (#DASHBOARD_TABS + 2)))) + 1
if selected >= #DASHBOARD_TABS + 2 then self:showSelfHealth()
elseif selected > #DASHBOARD_TABS then self:showBrightnessDialog()
else self:switchTab(selected) end
return true
elseif pos and type(pos.y) == "number" and pos.y >= TAB_HEADER_MIN_HEIGHT
and pos.y < self.tab_header_height then
return true
end
if pos and self.active_tab == 1 then
self:showPrinterActionAt(pos)
return true
end
if pos and self.active_tab == 4 then
self:showPlexActionAt(pos)
return true
end
if pos and self.active_tab == 6 then
self:showAlertAt(pos)
return true
end
if pos and self.active_tab == 5 then
self:showTrafficMenu()
return true
end
if pos and (self.active_tab == 2 or self.active_tab == 3) then
self:showStatusActionAt(pos, self.active_tab == 2 and "llm" or "site")
return true
end
self:poll(true)
return true
end
view.onCloseDashboard = function()
self:stopDashboard()
return true
end
view.onOpenPrinterControls = function(_, _args, gesture)
if gesture and (gesture.direction == "north"
or gesture.direction == "northeast" or gesture.direction == "northwest") then
self:showQuickControls()
return true
elseif gesture and gesture.direction == "east" then
self:switchTab(self.active_tab == 1 and #DASHBOARD_TABS or self.active_tab - 1)
return true
elseif gesture and gesture.direction == "west" then
self:switchTab(self.active_tab == #DASHBOARD_TABS and 1 or self.active_tab + 1)
return true
elseif gesture and gesture.direction == "south" then
self:poll(true)
return true
end
return false
end
return view
end
function Dashboard:replaceView(content, kind, refresh_type, text)
if self:dashboardCovered() then self.clean_refresh_pending = true; return false end
local next_view = self:makeInputView(content)
next_view.dithered = kind == "png" or dashboard_color_enabled()
local previous = self.view
self.view = next_view
self.view_kind = kind
self.view_text = text
UIManager:show(next_view)
if previous then
UIManager:close(previous)
end
self:dirtyDashboard(next_view, refresh_type == "full")
return true
end
function Dashboard:makeTabHeader(banner)
local width = Screen:getWidth()
local tab_width = math.floor(width / (#DASHBOARD_TABS + 2))
local labels = HorizontalGroup:new { allow_mirroring = false }
for index, tab in ipairs(DASHBOARD_TABS) do
local title = tab.short_label or tab.label
if tab.id == "alerts" then
local data = self.alerts_cache and self.alerts_cache.data
local stale = self.alerts_badge_stale or (self.alerts_cache
and os.time() - self.alerts_cache.fetched_at > 180)
if stale then title = title .. " ?"
elseif data and not data.quiet_hours.active and data.counts.attention > 0 then
title = title .. " " .. tostring(math.min(99, data.counts.attention))
end
end
local active, colored = index == self.active_tab, dashboard_color_enabled()
local label = not colored and active and ("[" .. title .. "]") or title
local paper = dashboard_color(active and TAB_ACCENTS[index] or "canvas", Blitbuffer.COLOR_WHITE)
local box = TextBoxWidget:new {
text = label,
fgcolor = dashboard_color("ink"), bgcolor = paper, bold = active,
width = tab_width - 12,
face = dashboard_face(math.min(26, math.floor(tab_width / 3.5))),
alignment = "center",
}
local cell = CenterContainer:new { dimen = Geom:new { x = 0, y = 0, w = tab_width, h = TAB_HEADER_MIN_HEIGHT }, box }
labels[#labels + 1] = colored and FrameContainer:new {
dimen = Geom:new { x = 0, y = 0, w = tab_width, h = TAB_HEADER_MIN_HEIGHT },
width = tab_width, height = TAB_HEADER_MIN_HEIGHT, margin = 0, padding = 0, bordersize = 0, background = paper, cell,
} or cell
end
labels[#labels + 1] = CenterContainer:new {
dimen = Geom:new { x = 0, y = 0,
w = tab_width, h = TAB_HEADER_MIN_HEIGHT },
FrameContainer:new {
padding = 6, bordersize = 2, radius = 8, background = dashboard_color("canvas", Blitbuffer.COLOR_WHITE),
TextBoxWidget:new {
text = _("Light"), fgcolor = dashboard_color("teal"), bgcolor = dashboard_color("canvas", Blitbuffer.COLOR_WHITE), width = tab_width - 28,
face = dashboard_face(26), alignment = "center",
},
},
}
local state = self:selfHealthState()
local health_width = width - tab_width * (#DASHBOARD_TABS + 1)
self.health_indicator = TextBoxWidget:new {
text = state.indicator, fgcolor = dashboard_color(state.accent), bgcolor = dashboard_color("canvas", Blitbuffer.COLOR_WHITE),
width = health_width - 16, face = dashboard_face(math.min(22, math.max(12, math.floor(health_width / 5)))), alignment = "center",
}
self.health_indicator_frame = FrameContainer:new { padding = 2, margin = 0, bordersize = 2, radius = 8,
color = dashboard_color(state.accent), background = dashboard_color("canvas", Blitbuffer.COLOR_WHITE), self.health_indicator }
labels[#labels + 1] = CenterContainer:new {
dimen = Geom:new { x = 0, y = 0, w = health_width, h = TAB_HEADER_MIN_HEIGHT }, self.health_indicator_frame }
self.health_indicator_key = state.indicator .. state.accent
local rows = VerticalGroup:new { labels }
local height = TAB_HEADER_MIN_HEIGHT
if self.active_tab == 1 then
local hint = TextBoxWidget:new {
text = "Tap card: controls and camera menu",
fgcolor = dashboard_color("teal"), bgcolor = dashboard_color("canvas", Blitbuffer.COLOR_WHITE),
width = width - 48,
face = dashboard_face(24),
alignment = "center",
}
rows[#rows + 1] = FrameContainer:new {
width = width, height = PRINTER_HINT_HEIGHT, padding = 0, margin = 0, bordersize = 0,
background = dashboard_color("canvas", Blitbuffer.COLOR_WHITE),
CenterContainer:new { dimen = Geom:new { x = 0, y = 0, w = width, h = PRINTER_HINT_HEIGHT }, hint },
}
height = height + PRINTER_HINT_HEIGHT
end
if banner then
local notice = TextBoxWidget:new {
text = banner,
fgcolor = dashboard_color("amber"), bgcolor = dashboard_color("amber_paper", Blitbuffer.COLOR_WHITE),
width = width - 32,
face = dashboard_face(23),
alignment = "center",
}
local notice_height = math.min(112, notice:getSize().h + 12)
rows[#rows + 1] = FrameContainer:new {
width = width, height = notice_height, padding = 0, margin = 0, bordersize = 0,
background = dashboard_color("amber_paper", Blitbuffer.COLOR_WHITE),
CenterContainer:new { dimen = Geom:new { x = 0, y = 0, w = width, h = notice_height }, notice },
}
height = height + notice_height
end
self.tab_header_height = height
return rows, height
end
function Dashboard:showText(title, detail)
local description = title .. "\n\n" .. detail
.. "\n\nTap a tab above or swipe sideways to switch. Hold to close."
if self.active_tab == 1 then
description = description .. "\nTap a card for controls and its camera menu."
end
local view_key = tostring(self.active_tab) .. "\n"
.. tostring(self.offline_banner or "") .. "\n" .. description
if self.view_kind == "text" and self.view_text == view_key then
return
end
local width, height = Screen:getWidth(), Screen:getHeight()
self.image_rect = nil
local header, header_height = self:makeTabHeader(self.offline_banner)
local content_height = height - header_height
local box = TextBoxWidget:new {
text = description,
width = math.floor(width * 0.82),
face = Font:getFace("cfont", 28),
alignment = "center",
}
local surface = FrameContainer:new {
width = width,
height = height,
margin = 0,
padding = 0,
bordersize = 0,
background = Blitbuffer.COLOR_WHITE,
VerticalGroup:new {
header,
CenterContainer:new {
dimen = Geom:new { x = 0, y = 0, w = width, h = content_height },
box,
},
},
}
self:replaceView(surface, "text", "full", view_key)
end
function Dashboard:cachedViewStamp(cache)
if not cache then return "No saved image" end
local image = cache.image_received_at and ("Image received "
.. os.date("%Y-%m-%d %H:%M:%S", cache.image_received_at)) or "Image time unknown (older saved view)"
local checked = cache.last_checked_at or cache.last_success_at
return image .. " | Last relay check " .. (checked and os.date("%Y-%m-%d %H:%M:%S", checked) or "unknown")
.. " · Kindle local time; image receipt is not source capture time"
end
function Dashboard:showOffline(reason)
local cache = self.tab_cache[self.active_tab]
local last = cache and cache.last_success_at
and os.date("%Y-%m-%d %H:%M", cache.last_success_at)
or "Never"
local brief_reason = tostring(reason or "Connection failed"):gsub("[%c]", " "):sub(1, 44)
local banner = "OFFLINE: " .. brief_reason .. " | " .. self:cachedViewStamp(cache)
if not self.offline_banner or not self.offline_banner:match("^OFFLINE:") then self.clean_refresh_pending = true end
local already_visible = self.view_kind == "png" and self.offline_banner == banner
self.offline_banner = banner
if already_visible and cache and cache.png then return end
if cache and cache.png and self:showPng(cache.png) then return end
self:showText(DASHBOARD_TABS[self.active_tab].label .. " unavailable",
reason .. "\nLast successful contact: " .. last)
end
function Dashboard:showPng(data)
if self:dashboardCovered() then return false end
local width, height = Screen:getWidth(), Screen:getHeight()
local png_width, png_height = png_size(data)
if not png_width then return false end
local header, header_height = self:makeTabHeader(self.offline_banner)
local image_space_height = height - header_height
local scale = math.min(width / png_width, image_space_height / png_height)
local image_width = math.max(1, math.floor(png_width * scale))
local image_height = math.max(1, math.floor(png_height * scale))
local ok, image = pcall(RenderImage.renderImageData, RenderImage, data, #data,
false, image_width, image_height)
if not ok or not image then
logger.warn("Printer Dashboard: PNG decode failed")
return false
end
local widget = ImageWidget:new {
image = image,
image_disposable = true,
width = image_width,
height = image_height,
alpha = false,
}
self.image_rect = {
x = math.floor((width - image_width) / 2),
y = header_height + math.floor((image_space_height - image_height) / 2),
w = image_width, h = image_height,
png_w = png_width, png_h = png_height,
}
local surface = FrameContainer:new {
width = width, height = height, margin = 0, padding = 0, bordersize = 0,
background = Blitbuffer.COLOR_WHITE,
VerticalGroup:new {
header,
CenterContainer:new {
dimen = Geom:new { x = 0, y = 0, w = width, h = image_space_height },
widget,
},
},
}
self.screen_changes = self.screen_changes + 1
return self:replaceView(surface, "png", "ui")
end
function Dashboard:requestRemote(path, method, token_path, payload, accept, max_bytes, etag,
force_public_https, background_alerts)
local update_version, update_file = path:match("^/api/client%-update/file/([^/]+)/([^/]+)$")
local update_path = path == UPDATE_MANIFEST_PATH
or (parse_update_version(update_version) and UPDATE_FILE_SET[update_file])
if update_path and (not force_public_https or method ~= "GET" or payload ~= nil
or token_path ~= self.settings.token_file) then
return nil, "Invalid Wi-Fi update request"
end
if background_alerts ~= nil and (background_alerts ~= true
or path ~= "/api/v1/alerts" or method ~= "GET") then
return nil, "Invalid background alert request"
end
local alert_detail = path:match("^/api/v1/alerts/([0-9a-f%-]+)$")
local alert_receipt = path:match("^/api/v1/alerts/actions/([0-9a-f%-]+)$")
local alert_read = path == "/api/v1/alerts" or path == "/api/v1/alerts/history"
or alert_detail and self:validAlertUuid(alert_detail)
local alert_write = path == "/api/v1/alerts/actions"
local alert_result = alert_receipt and self:validAlertUuid(alert_receipt)
if alert_read and (method ~= "GET" or payload ~= nil or token_path ~= self.settings.token_file
or force_public_https ~= true) then return nil, "Invalid alert reader request" end
if alert_result and (method ~= "GET" or payload ~= nil or token_path ~= self.settings.control_token_file
or force_public_https ~= true) then return nil, "Invalid alert receipt request" end
if alert_write then
local valid, command = pcall(require("json").decode, payload)
if method ~= "POST" or type(payload) ~= "string" or not valid or not self:validAlertAction(command)
or token_path ~= self.settings.control_token_file or force_public_https ~= true then
return nil, "Invalid alert action request"
end
end
local subtitle_catalog_base = path == "/api/v1/plex/subtitles/catalog"
local windows_path = path == "/api/v1/windows/status"
if windows_path and (method ~= "GET" or payload ~= nil
or token_path ~= self.settings.token_file or force_public_https ~= true) then
return nil, "Invalid Windows telemetry request"
end
local insights_path = path == "/api/v1/plex/insights"
if insights_path and (method ~= "GET" or payload ~= nil
or token_path ~= self.settings.token_file or force_public_https ~= true) then
return nil, "Invalid media insights request"
end
local subtitle_job_base = path == "/api/v1/plex/subtitles/jobs"
local subtitle_catalog_result = path:match("^/api/v1/plex/subtitles/catalog/[0-9a-f%-]+$")
local subtitle_job_result = path:match("^/api/v1/plex/subtitles/jobs/[0-9a-f%-]+$")
local traffic_image_window = path:match("^/status/traffic%.png%?window=([a-z0-9]+)$")
local traffic_detail_window, traffic_page = path:match("^/api/v1/status/traffic%?window=([a-z0-9]+)&page=(%d+)$")
local traffic_image_scope_window, traffic_image_view = path:match("^/status/traffic%.png%?window=([a-z0-9]+)&view=([a-z]+)$")
local traffic_detail_scope_window, traffic_scope_page, traffic_detail_view = path:match("^/api/v1/status/traffic%?window=([a-z0-9]+)&page=(%d+)&view=([a-z]+)$")
traffic_image_window = traffic_image_window or traffic_image_scope_window
traffic_detail_window = traffic_detail_window or traffic_detail_scope_window
traffic_page = traffic_page or traffic_scope_page
local traffic_view = traffic_image_view or traffic_detail_view
local traffic_window = traffic_image_window or traffic_detail_window
local traffic_path = traffic_window ~= nil
if traffic_path and (traffic_window ~= "5m" and traffic_window ~= "1h" and traffic_window ~= "24h"
or traffic_view and traffic_view ~= "pages" and traffic_view ~= "sites"
or traffic_page and (#traffic_page > 6 or tonumber(traffic_page) < 1 or tonumber(traffic_page) > 100000)
or method ~= "GET" or payload ~= nil or token_path ~= self.settings.token_file) then
return nil, "Invalid traffic request"
end
if path ~= "/dashboard.png" and path ~= "/api/v1/status"
and path ~= "/status/llm.png" and path ~= "/status/site.png"
and path ~= "/api/v1/status/llm" and path ~= "/api/v1/status/site"
and path ~= "/status/plex.png" and path ~= "/api/v1/plex/status"
and path ~= "/api/v1/plex/commands" and path ~= "/api/v1/plex/search"
and path ~= "/api/v1/plex/details" and not insights_path and not windows_path
and path ~= "/api/v1/commands"
and not DOCTOR_PATHS[path]
and not path:match("^/api/v1/commands/[0-9a-f%-]+$")
and not path:match("^/api/v1/plex/commands/[0-9a-f%-]+$")
and not path:match("^/api/v1/plex/search/[0-9a-f%-]+$")
and not path:match("^/api/v1/plex/details/[0-9a-f%-]+$")
and not subtitle_catalog_base and not subtitle_job_base
and not subtitle_catalog_result and not subtitle_job_result
and not path:match("^/api/v1/camera/[A-Za-z0-9_-]+$")
and not update_path and not traffic_path and not alert_read and not alert_write and not alert_result then
return nil, "Invalid dashboard endpoint"
end
if (subtitle_catalog_base or subtitle_job_base) and
(method ~= "POST" or type(payload) ~= "string"
or token_path ~= self.settings.control_token_file) then
return nil, "Invalid subtitle request"
end
if (subtitle_catalog_result or subtitle_job_result) and
(method ~= "GET" or payload ~= nil
or token_path ~= self.settings.control_token_file) then
return nil, "Invalid subtitle status request"
end
if path == "/api/v1/commands" then
if method ~= "POST" or type(payload) ~= "string"
or token_path ~= self.settings.control_token_file then
return nil, "Invalid printer control request"
end
local ok, command = pcall(require("json").decode, payload)
if not ok or type(command) ~= "table"
or type(command.request_id) ~= "string"
or not command.request_id:match("^[0-9a-f]+%-[0-9a-f]+%-[0-9a-f]+%-[0-9a-f]+%-[0-9a-f]+$")
or type(command.printer_id) ~= "string"
or not command.printer_id:match("^[A-Za-z0-9_-]+$") then
return nil, "Invalid printer control request"
end
local action = command.action
local fields = { request_id = true, printer_id = true, action = true }
if command.job_identity~=nil then
local epoch,task
if type(command.job_identity)=="string" then epoch,task=command.job_identity:match("^run:([0-9a-f]+):task:([1-9][0-9]*)$")end
if not epoch or #epoch~=32 or not task or #task>20 or action=="light" or action=="reprint" then return nil,"Invalid job binding" end
fields.job_identity=true
end
if action == "light" then
if command.value ~= "on" and command.value ~= "off" then
return nil, "Invalid chamber-light request"
end
fields.value = true
elseif action == "pause" or action == "resume" then
elseif action == "stop" then
if command.confirm ~= "STOP" then return nil, "Invalid stop request" end
fields.confirm = true
elseif action == "speed" then
if type(command.value) ~= "number" or command.value % 1 ~= 0
or command.value < 1 or command.value > 4 then
return nil, "Invalid speed request"
end
fields.value = true
elseif action == "reprint" then
if not valid_reprint_history_id(command.value)
or command.confirm ~= "BED_CLEAR" then
return nil, "Invalid reprint request"
end
fields.value = true
fields.confirm = true
else
return nil, "Unsupported printer control"
end
for key in pairs(command) do
if not fields[key] then return nil, "Invalid printer control fields" end
end
end
if not NetworkMgr:isConnected() then
return nil, "Wi-Fi is disconnected"
end
local base = force_public_https and PUBLIC_BASE or clean_base_url(self.settings.base_url)
if not base then
return nil, "Configure the dashboard URL"
end
local mode = force_public_https and "https" or self.settings.proxy_mode
if not allowed_target(base, mode) then
return nil, "URL does not match the selected connection route"
end
local token, token_error = read_bearer_token(token_path)
if not token then
return nil, token_error
end
local http = require("socket.http")
local socketutil = require("socketutil")
if mode == "auto" and http.PROXY then
local configured_proxy = http.PROXY:gsub("/+$", "")
if configured_proxy ~= TAILSCALE_PROXY then
return nil, "KOReader proxy is not the local Tailscale proxy"
end
end
local chunks, bytes = {}, 0
local started = os.time()
local camera_request = path:match("^/api/v1/camera/[A-Za-z0-9_-]+$") ~= nil
local image_request = path == "/dashboard.png" or path == "/status/llm.png"
or path == "/status/site.png" or path == "/status/plex.png"
local alert_list_request = path == "/api/v1/alerts" and method == "GET"
local fast_alert_request = alert_list_request and background_alerts == true
local fast_printer_request = path == "/api/v1/status" or path == "/api/v1/commands"
or path:match("^/api/v1/commands/[0-9a-f%-]+$") ~= nil
local request_limit = fast_alert_request and 2 or (fast_printer_request and 3
or (camera_request and 8 or (image_request and 10 or 20)))
local sink = function(chunk)
if chunk then
bytes = bytes + #chunk
if bytes > max_bytes then
return nil, "Dashboard response is too large"
end
if os.time() - started > request_limit then
return nil, "Dashboard download timed out"
end
chunks[#chunks + 1] = chunk
end
return 1
end
local request = {
url = base .. path,
method = method,
redirect = false,
sink = sink,
headers = {
["Authorization"] = "Bearer " .. token,
["Accept"] = accept,
["Accept-Encoding"] = "identity",
["User-Agent"] = "kindle-printer-dashboard/1.0",
},
}
if etag then
request.headers["If-None-Match"] = etag
end
if payload then
local ltn12 = require("ltn12")
request.source = ltn12.source.string(payload)
request.headers["Content-Type"] = "application/json"
request.headers["Content-Length"] = tostring(#payload)
end
if mode == "tailnet" then
request.proxy = TAILSCALE_PROXY
elseif mode == "https" then
local koreader_dir = os.getenv("KOREADER_DIR") or lfs.currentdir()
local cafile = koreader_dir .. "/data/ca-bundle.crt"
if lfs.attributes(cafile, "mode") ~= "file" then
return nil, "KOReader CA bundle is missing"
end
local loaded, module = pcall(require, "ssl.https")
if not loaded or type(module.tcp) ~= "function" then
return nil, "KOReader LuaSec HTTPS support is unavailable"
end
request.create = verified_https_factory(module, cafile)
elseif mode ~= "auto" and mode ~= "direct" then
return nil, "Invalid proxy mode"
end
local previous_proxy = http.PROXY
if mode == "direct" or mode == "https" then
http.PROXY = nil
end
socketutil:set_timeout((fast_alert_request or fast_printer_request) and 2
or (camera_request and 3 or (image_request and 4 or 6)), request_limit)
local ok, result, code, headers = pcall(http.request, request)
socketutil:reset_timeout()
http.PROXY = previous_proxy
if not ok or result ~= 1 then
logger.warn("Printer Dashboard: request failed")
local failure = tostring(ok and code or result):lower()
if failure:find("dashboard tls identity verification failed", 1, true) then
return nil, "Dashboard TLS hostname check failed; check the device clock and certificate"
end
if failure:find("certificate verify failed", 1, true)
or failure:find("certificate verification failed", 1, true) then
return nil, "Dashboard TLS chain check failed; check the device clock and KOReader CA bundle"
end
if failure:find("timeout", 1, true) or failure:find("timed out", 1, true) then
return nil, "Dashboard request timed out; check Wi-Fi and retry"
end
return nil, "Cannot reach dashboard or verify its identity"
end
return table.concat(chunks), code, headers
end
local function read_update_file(path, maximum)
if lfs.symlinkattributes(path, "mode") ~= "file" then return nil end
local file = io.open(path, "rb")
if not file then return nil end
local body = file:read(maximum + 1)
file:close()
if not body or #body > maximum then return nil end
return body
end
local function plugin_file_hashes(directory, sha256)
if lfs.symlinkattributes(directory, "mode") ~= "directory" then return nil end
local count = 0
for name in lfs.dir(directory) do
if name ~= "." and name ~= ".." then
if not UPDATE_FILE_SET[name]
or lfs.symlinkattributes(directory .. "/" .. name, "mode") ~= "file" then
return nil
end
count = count + 1
end
end
if count ~= #UPDATE_FILES then return nil end
local hashes = {}
for _, name in ipairs(UPDATE_FILES) do
local body = read_update_file(directory .. "/" .. name, MAX_UPDATE_FILE_BYTES)
if not body then return nil end
hashes[name] = sha256(body)
end
return hashes
end
local function exact_version_file(body)
if not body then return nil end
local version = body:match("^([^\r\n]+)\r?\n?$")
if version and parse_update_version(version) then return version end
return nil
end
function Dashboard:getClientProvenance()
local ok, installed = pcall(function()
local active = plugin_directory(self.path)
return active and exact_version_file(read_update_file(active .. "/VERSION", 64))
end)
if not ok then installed = nil end
return { running_version = RUNNING_CLIENT_VERSION, loaded_at = CLIENT_LOADED_AT,
installed_version = installed,
restart_required = installed ~= nil and installed ~= RUNNING_CLIENT_VERSION }
end
local function validate_update_manifest(value, current_version)
if type(value) ~= "table" or value.schema_version ~= 1
or value.device_serial ~= DEVICE_SERIAL
or not parse_update_version(value.version)
or not compare_update_versions(value.version, current_version)
or type(value.files) ~= "table" or #value.files ~= #UPDATE_FILES then
return nil, "Wi-Fi update manifest is invalid"
end
local files, count, total = {}, 0, 0
for index, item in pairs(value.files) do
if type(index) ~= "number" or index % 1 ~= 0
or index < 1 or index > #UPDATE_FILES or type(item) ~= "table"
or not UPDATE_FILE_SET[item.name] or files[item.name]
or type(item.size) ~= "number" or item.size % 1 ~= 0
or item.size < 1 or item.size > MAX_UPDATE_FILE_BYTES
or type(item.sha256) ~= "string" or #item.sha256 ~= 64
or not item.sha256:match("^[0-9a-f]+$") then
return nil, "Wi-Fi update manifest has invalid files"
end
files[item.name] = item
count, total = count + 1, total + item.size
end
if count ~= #UPDATE_FILES or total > MAX_UPDATE_PACKAGE_BYTES then
return nil, "Wi-Fi update package is incomplete or too large"
end
for _, name in ipairs(UPDATE_FILES) do
if not files[name] then return nil, "Wi-Fi update package is incomplete" end
end
return { version = value.version, files = files }
end
local function remove_staged_update(directory)
if lfs.symlinkattributes(directory, "mode") ~= "directory" then return end
for _, name in ipairs(UPDATE_FILES) do
local path = directory .. "/" .. name
if lfs.symlinkattributes(path, "mode") == "file" then os.remove(path) end
end
lfs.rmdir(directory)
end
local function load_file_ota_recovery(sha256)
local directory = "/var/local/kindle-printer-dashboard"
local path = directory .. "/ota-file-recovery.lua"
local parent = lfs.symlinkattributes(directory)
local item = lfs.symlinkattributes(path)
if not parent or parent.mode ~= "directory" or parent.uid ~= 0
or parent.permissions ~= "rwx------" or not item or item.mode ~= "file"
or item.uid ~= 0 or item.nlink ~= 1 or item.permissions ~= "rw-------"
or item.size < 1 or item.size > 32768 then
return nil, "Wi-Fi update recovery helper is missing or unsafe; reconnect for repair"
end
local source = read_update_file(path, 32768)
if not source or sha256(source) ~= "__INKBOARD_RECOVERY_SHA256__" then
return nil, "Wi-Fi update recovery helper changed; reconnect for repair"
end
local loaded, recovery, reason = pcall(function()
local chunk = assert(loadstring(source, "@private-dashboard-file-ota-recovery.lua"))
local module = chunk()
if type(module) ~= "table" or module.api ~= 2
or type(module.new_native) ~= "function" then return nil, "helper_api" end
return module.new_native()
end)
if not loaded or type(recovery) ~= "table" or type(recovery.install) ~= "function"
or type(recovery.recover) ~= "function" then
return nil, "Wi-Fi update recovery is not ready; reopen KOReader or reconnect for repair"
end
return recovery
end
function Dashboard:installWifiUpdate(manifest, active, parent, current_version)
if device_serial() ~= DEVICE_SERIAL then return nil, "This Kindle serial is not authorized" end
if not UPDATE_PLUGIN_DIRS[active] or active ~= parent .. "/kindleprinter.koplugin" then
return nil, "Wi-Fi update plugin path is outside approved folders"
end
local validated, manifest_error = validate_update_manifest(manifest, current_version)
if not validated then return nil, manifest_error end
if compare_update_versions(validated.version, current_version) ~= 1 then
return nil, "Update is no longer newer than the installed version"
end
local ok_sha, sha2 = pcall(require, "ffi/sha2")
if not ok_sha or type(sha2.sha256) ~= "function" then
return nil, "KOReader SHA-256 support is unavailable"
end
local sha256 = sha2.sha256
local old_version = exact_version_file(read_update_file(active .. "/VERSION", 64))
local original_hashes = plugin_file_hashes(active, sha256)
if old_version ~= current_version or not original_hashes then
return nil, "Installed plugin changed; update was not applied"
end
local recovery, recovery_error = load_file_ota_recovery(sha256)
if not recovery then return nil, recovery_error end
local bodies = {}
for _, name in ipairs(UPDATE_FILES) do
local path = "/api/client-update/file/" .. validated.version .. "/" .. name
local body, code = self:requestRemote(path, "GET", self.settings.token_file,
nil, "application/octet-stream", MAX_UPDATE_FILE_BYTES, nil, true)
if body == nil then return nil, "Update download failed: " .. tostring(code) end
if code ~= 200 or #body ~= validated.files[name].size
or sha256(body) ~= validated.files[name].sha256 then
return nil, "Downloaded " .. name .. " did not match the update manifest"
end
if name ~= "VERSION" and not loadstring(body, "@" .. name) then
return nil, "Downloaded " .. name .. " has invalid Lua syntax"
end
bodies[name] = body
end
if exact_version_file(bodies.VERSION) ~= validated.version then
return nil, "Downloaded VERSION does not match the manifest"
end
if sha256(bodies["_meta.lua"]) ~= original_hashes["_meta.lua"] then
return nil, "This update changes plugin metadata; reconnect for a reviewed installation"
end
local suffix = tostring(os.time()) .. "-" .. tostring(math.random(100000, 999999))
local stage = parent .. "/kindleprinter.ota-stage-" .. validated.version .. "-" .. suffix
if lfs.symlinkattributes(stage, "mode") or not lfs.mkdir(stage)
or lfs.symlinkattributes(stage, "mode") ~= "directory" then
return nil, "Cannot create a safe update staging directory"
end
for _, name in ipairs(UPDATE_FILES) do
local file = io.open(stage .. "/" .. name, "wb")
if not file then
remove_staged_update(stage)
return nil, "Cannot stage the Wi-Fi update"
end
local written = file:write(bodies[name])
local flushed = written and file:flush()
local closed = file:close()
if not written or not flushed or not closed then
remove_staged_update(stage)
return nil, "Cannot finish staging the Wi-Fi update"
end
end
local stage_hashes = plugin_file_hashes(stage, sha256)
local latest_hashes = plugin_file_hashes(active, sha256)
if not stage_hashes or not latest_hashes
or exact_version_file(read_update_file(stage .. "/VERSION", 64)) ~= validated.version
or exact_version_file(read_update_file(active .. "/VERSION", 64)) ~= current_version then
remove_staged_update(stage)
return nil, "Update files changed during staging"
end
for _, name in ipairs(UPDATE_FILES) do
if stage_hashes[name] ~= validated.files[name].sha256
or latest_hashes[name] ~= original_hashes[name] then
remove_staged_update(stage)
return nil, "Update files changed during staging"
end
end
local sync_ok = pcall(function()
local ffi = require("ffi")
pcall(ffi.cdef, "void sync(void);")
ffi.C.sync()
end)
if not sync_ok then
remove_staged_update(stage)
return nil, "Cannot flush staged update to Kindle storage"
end
local record = {
serial = DEVICE_SERIAL, parent = parent,
old_version = current_version, new_version = validated.version,
stage = stage:sub(#parent + 2),
backup = "kindleprinter.ota-backup-" .. current_version .. "-" .. suffix,
old = original_hashes, new = stage_hashes,
}
local ran, installed, outcome = pcall(recovery.install, recovery, record)
if not ran or installed ~= true
or (outcome ~= "installed" and outcome ~= "installed_journal_retained") then
return nil, "Wi-Fi update did not complete; reopen KOReader for verified recovery, or reconnect for inspection"
end
local installed_hashes = plugin_file_hashes(active, sha256)
for _, name in ipairs(UPDATE_FILES) do
if not installed_hashes or installed_hashes[name] ~= validated.files[name].sha256 then
return nil, "Wi-Fi update verification needs recovery; reopen KOReader or reconnect for inspection"
end
end
remove_staged_update(stage)
return true, outcome == "installed_journal_retained" and "journal_pending" or nil
end
function Dashboard:checkWifiUpdate()
if self.ota_in_progress then return end
self.ota_in_progress = true
local serial = device_serial()
if serial ~= DEVICE_SERIAL then
self.ota_in_progress = false
self:notice(serial and "Wi-Fi update is not registered for this Kindle."
or "Wi-Fi update cannot read this Kindle's serial.", 8)
return
end
local active, parent, path_error = plugin_directory(self.path)
if not active then
self.ota_in_progress = false
local messages = {
source = "Wi-Fi update cannot locate the loaded KOReader plugin.",
path = "Wi-Fi update plugin path is outside approved KOReader folders.",
folder = "Wi-Fi update plugin folder is missing or changed.",
}
self:notice(messages[path_error] or "Wi-Fi update plugin folder check failed.", 8)
return
end
local current_version = exact_version_file(read_update_file(active .. "/VERSION", 64))
if not current_version then
self.ota_in_progress = false
self:notice("Wi-Fi update VERSION is missing or invalid in the loaded plugin.", 8)
return
end
if current_version ~= RUNNING_CLIENT_VERSION then
self.ota_in_progress = false
self:notice("Dashboard files " .. current_version .. " are installed. Running client "
.. RUNNING_CLIENT_VERSION .. ". Restart KOReader to load the installed files.", 12)
return
end
local body, code = self:requestRemote(UPDATE_MANIFEST_PATH, "GET",
self.settings.token_file, nil, "application/json", MAX_UPDATE_MANIFEST_BYTES,
nil, true)
self.ota_in_progress = false
if body == nil then
self:notice("Update check failed: " .. tostring(code), 8)
return
end
if code ~= 200 then
self:notice("Update check returned HTTP " .. tostring(code), 8)
return
end
local decode_ok, parsed = pcall(require("json").decode, body)
if not decode_ok then parsed = nil end
local manifest, reason = validate_update_manifest(parsed, current_version)
if not manifest then self:notice(reason, 8); return end
local comparison = compare_update_versions(manifest.version, current_version)
if comparison <= 0 then
self:notice("Dashboard client " .. current_version .. " is current.", 6)
return
end
UIManager:show(ConfirmBox:new {
text = "Install dashboard client " .. manifest.version .. " over Wi-Fi?\n"
.. "Current: " .. current_version .. ". The previous version is kept as a backup. "
.. "Restart KOReader manually after installation.",
ok_text = "Install update",
flush_events_on_show = true,
ok_callback = function()
if self.ota_in_progress then return end
self.ota_in_progress = true
local ok, installed, install_error = pcall(self.installWifiUpdate, self,
parsed, active, parent, current_version)
self.ota_in_progress = false
if not ok or not installed then
self:notice(ok and tostring(install_error)
or "Update failed unexpectedly; inspect the plugin backup.", 12)
return
end
if install_error == "journal_pending" then
self:notice("Dashboard client " .. manifest.version
.. " installed. Recovery cleanup is still pending. Exit and reopen KOReader to finish cleanup and load it.", 16)
else
self:notice("Dashboard client " .. manifest.version
.. " installed. Exit and reopen KOReader to load it.", 12)
end
end,
})
end
function Dashboard:fetchPng(tab)
local cache = self.tab_cache[self.active_tab]
local path = tab.path
if tab.id == "traffic" then path = path .. "?window=" .. (self.settings.traffic_window or "5m") .. "&view=" .. (self.settings.traffic_view or "pages") end
local body, code, headers = self:requestRemote(path, "GET",
self.settings.token_file, nil, "image/png", MAX_IMAGE_BYTES,
cache and cache.etag)
if body == nil then
return nil, code
end
if code == 304 and cache and cache.png then
return "unchanged"
end
if code == 304 then
return nil, "Status image was not in the Kindle cache"
end
if code == 401 or code == 403 then
return nil, "Dashboard token was rejected"
end
if code ~= 200 then
return nil, "Dashboard returned HTTP " .. tostring(code)
end
if not png_size(body) then
return nil, "Dashboard returned an invalid PNG"
end
local etag = headers and (headers.etag or headers.ETag)
if type(etag) ~= "string" or #etag > 200 or etag:find("[%c]") then
etag = nil
end
return body, nil, etag
end
local function safe_label(value, maximum)
if type(value) ~= "string" then return "Unknown" end
value = value:gsub("[%c]", " "):match("^%s*(.-)%s*$")
if value == "" then return "Unknown" end
return value:sub(1, maximum or 80)
end
local function positive_id(value)
return type(value) == "number" and value % 1 == 0
and value >= 1 and value <= 2147483647
end
local function valid_printer_id(value)
return type(value) == "string" and #value >= 1 and #value <= 64
and value:match("^[A-Za-z0-9_-]+$") ~= nil
end
local function printer_job_identity(value)
if type(value) ~= "string" or #value > 82 then return nil end
local epoch, task = value:match("^run:([0-9a-f]+):task:([1-9][0-9]*)$")
if epoch and #epoch == 32 and #task <= 20 then return value end
end
local function doctor_path(printer_id, suffix)
if printer_id ~= "__INKBOARD_PRINTER_ONE__" and printer_id ~= "__INKBOARD_PRINTER_TWO__" then return nil end
local path = "/api/v1/doctor/" .. printer_id .. (suffix or "")
return DOCTOR_PATHS[path] and path or nil
end
local function valid_history_id(value)
return type(value) == "string" and #value >= 16 and #value <= 128
and value:match("^[A-Fa-f0-9%-]+$") ~= nil
end
valid_reprint_history_id = function(value)
if type(value) ~= "string" or #value ~= 36 then return false end
local a, b, c, d, e = value:match(
"^([0-9a-f]+)%-([0-9a-f]+)%-([0-9a-f]+)%-([0-9a-f]+)%-([0-9a-f]+)$")
return a ~= nil and #a == 8 and #b == 4 and #c == 4
and #d == 4 and #e == 12
end
local function decode_json(body)
local JSON = require("json")
local ok, parsed = pcall(JSON.decode, body)
if ok and type(parsed) == "table" then return parsed end
return nil
end
function Dashboard:notice(message, seconds)
UIManager:show(InfoMessage:new { text = message, timeout = seconds or 5 })
end
function Dashboard:getPrinters()
local body, code = self:requestRemote("/api/v1/status", "GET",
self.settings.token_file, nil, "application/json", MAX_JSON_BYTES)
if body == nil then return nil, code end
if code ~= 200 then return nil, "Status returned HTTP " .. tostring(code) end
local parsed = decode_json(body)
if not parsed or type(parsed.printers) ~= "table" then
return nil, "Status response is invalid"
end
local printers = {}
local history = {}
local relay_fresh = type(parsed.relay_age_seconds) == "number"
and parsed.relay_age_seconds >= 0 and parsed.relay_age_seconds < 30
for _, printer in ipairs(parsed.printers) do
if #printers >= 16 then break end
if type(printer) == "table" and valid_printer_id(printer.id) then
local can_control = relay_fresh and printer.online == true
and printer.stale == false
local offered = type(printer.control_capabilities) == "table"
and printer.control_capabilities or {}
printers[#printers + 1] = {
id = printer.id,
name = safe_label(printer.name, 48),
job_name = safe_label(printer.job_name, 64),
job_identity = printer_job_identity(printer.job_identity),
state = safe_label(printer.state, 24),
can_control = can_control,
control_link_ready = can_control and printer.control_link_ready == true,
control_capabilities = {
pause = can_control and offered.pause == true,
resume = can_control and offered.resume == true,
stop = can_control and offered.stop == true,
speed = can_control and offered.speed == true,
},
chamber_light = (printer.chamber_light == "on" or printer.chamber_light == "off")
and printer.chamber_light or nil,
last_seen_at = type(printer.last_seen_at) == "string" and safe_label(printer.last_seen_at, 40) or nil,
stale_seconds = type(printer.stale_seconds) == "number" and printer.stale_seconds >= 0
and printer.stale_seconds <= 31536000 and printer.stale_seconds or nil,
relay_age_seconds = type(parsed.relay_age_seconds) == "number" and parsed.relay_age_seconds >= 0
and parsed.relay_age_seconds <= 31536000 and parsed.relay_age_seconds or nil,
fetched_at = os.time(),
speed_level = type(printer.speed_level) == "number"
and printer.speed_level % 1 == 0
and printer.speed_level >= 1 and printer.speed_level <= 4
and printer.speed_level or nil,
}
local rows = type(parsed.history) == "table" and parsed.history[printer.id]
if type(rows) == "table" then
local entries = {}
for _, entry in ipairs(rows) do
if #entries >= 10 then break end
if type(entry) == "table" and valid_history_id(entry.id) then
entries[#entries + 1] = {
id = entry.id,
name = safe_label(entry.name, 56),
finished_at = safe_label(entry.finished_at, 25),
available = entry.available == true
and entry.outcome == "completed"
and valid_reprint_history_id(entry.id),
}
end
end
history[printer.id] = entries
end
end
end
return printers, nil, history
end
function Dashboard:showCamera(printer)
if not valid_printer_id(printer.id) then return end
if self.camera_view then UIManager:close(self.camera_view) end
UIManager:unschedule(self.camera_poll_task)
self.camera_printer = printer
self.camera_etag = nil
self.camera_changes = 0
self.camera_last_changed_at = nil
self.camera_delay_noticed_at = nil
self.camera_last_captured_at = nil
self:pollCamera()
end
function Dashboard:noteCameraDelay()
local now = os.time()
if self.camera_view and self.camera_last_changed_at
and now - self.camera_last_changed_at >= 30
and (not self.camera_delay_noticed_at
or now - self.camera_delay_noticed_at >= 60) then
self.camera_delay_noticed_at = now
self:notice("Camera frame delayed; showing the last capture while retrying.", 6)
end
end
function Dashboard:scheduleCameraPoll(started_at)
UIManager:unschedule(self.camera_poll_task)
if self.camera_printer and self.camera_view and self.running and not self.suspended then
UIManager:scheduleIn(math.max(1, 10 - (os.time() - started_at)),
self.camera_poll_task)
end
end
function Dashboard:pollCamera()
local printer = self.camera_printer
if not printer or self.suspended or not self.running then return end
if self.camera_view and self:dashboardCovered(self.camera_view) then
self:scheduleCameraPoll(os.time()); return
end
local started_at = os.time()
local body, code, headers = self:requestRemote("/api/v1/camera/" .. printer.id,
"GET", self.settings.token_file, nil, "image/jpeg", MAX_CAMERA_BYTES,
self.camera_etag)
if body == nil then
if not self.camera_view then
self.camera_printer = nil
self:notice("Camera unavailable: " .. tostring(code))
return
end
self:noteCameraDelay()
self:scheduleCameraPoll(started_at)
return
end
if code == 304 and self.camera_view then
local captured = headers and (headers["x-captured-at"] or headers["X-Captured-At"])
if type(captured) == "string" and captured:match("^%d%d%d%d%-%d%d%-%d%dT")
and captured ~= self.camera_last_captured_at then
self.camera_last_captured_at = captured
self.camera_last_changed_at = os.time()
self.camera_delay_noticed_at = nil
end
self:noteCameraDelay()
self:scheduleCameraPoll(started_at)
return
end
if code ~= 200 then
if not self.camera_view then
self.camera_printer = nil
self:notice("Camera unavailable (HTTP " .. tostring(code) .. ")")
return
end
self:noteCameraDelay()
self:scheduleCameraPoll(started_at)
return
end
local content_type = headers and (headers["content-type"] or headers["Content-Type"]) or ""
if type(content_type) ~= "string" or not content_type:lower():match("^image/jpeg") then
if not self.camera_view then
self.camera_printer = nil
self:notice("Camera response is not a JPEG")
return
end
self:noteCameraDelay()
self:scheduleCameraPoll(started_at)
return
end
local width, height = Screen:getWidth(), Screen:getHeight()
local captured = headers and (headers["x-captured-at"] or headers["X-Captured-At"])
local caption_text = "Camera · " .. safe_label(printer.name, 48)
if type(captured) == "string" and captured:match("^%d%d%d%d%-%d%d%-%d%dT") then
caption_text = caption_text .. "\nCaptured " .. safe_label(captured, 32)
end
caption_text = caption_text .. "\nReceived " .. os.date("%H:%M:%S %Z")
.. " · refreshes every 10s. Tap to return."
local caption = TextBoxWidget:new {
text = caption_text, width = math.floor(width * 0.9),
fgcolor = dashboard_color("navy"),
face = Font:getFace("cfont", 24), alignment = "center",
}
local caption_height = math.min(180, math.max(90, caption:getSize().h + 20))
local image_space_height = height - caption_height
local jpeg_width, jpeg_height = jpeg_size(body)
if not jpeg_width then
if not self.camera_view then
self.camera_printer = nil
self:notice("Camera JPEG dimensions are invalid")
return
end
self:noteCameraDelay()
self:scheduleCameraPoll(started_at)
return
end
local scale = math.min(width / jpeg_width, image_space_height / jpeg_height)
local image_width = math.max(1, math.floor(jpeg_width * scale))
local image_height = math.max(1, math.floor(jpeg_height * scale))
local ok, image = pcall(RenderImage.renderImageData, RenderImage, body, #body,
false, image_width, image_height)
if not ok or not image then
if not self.camera_view then
self.camera_printer = nil
self:notice("Camera JPEG could not be displayed")
return
end
self:noteCameraDelay()
self:scheduleCameraPoll(started_at)
return
end
local widget = ImageWidget:new {
image = image, image_disposable = true,
width = image_width, height = image_height, alpha = false,
}
local surface = FrameContainer:new {
width = width, height = height, margin = 0, padding = 0, bordersize = 0,
background = Blitbuffer.COLOR_WHITE,
VerticalGroup:new {
CenterContainer:new {
dimen = Geom:new { x = 0, y = 0, w = width, h = caption_height }, caption,
},
CenterContainer:new {
dimen = Geom:new { x = 0, y = 0, w = width, h = image_space_height }, widget,
},
},
}
local view = InputContainer:new {
dimen = Geom:new { x = 0, y = 0, w = width, h = height },
covers_fullscreen = true,
surface,
}
local range = Geom:new { x = 0, y = 0, w = width, h = height }
view.ges_events = {
CloseCamera = { GestureRange:new { ges = "tap", range = range } },
CloseCameraHold = { GestureRange:new { ges = "hold", range = range } },
}
local close = function()
UIManager:close(view)
return true
end
view.onCloseCamera = close
view.onCloseCameraHold = close
view.onCloseWidget = function()
if self.camera_view == view then
self.camera_view = nil
self.camera_printer = nil
self.camera_etag = nil
UIManager:unschedule(self.camera_poll_task)
if self.running and not self.suspended then self:schedulePoll(2) end
self:deferCleanScreen()
end
end
local previous = self.camera_view
self.camera_view = view
local etag = headers and (headers.etag or headers.ETag)
self.camera_etag = type(etag) == "string" and #etag <= 200
and not etag:find("[%c]") and etag or nil
self.camera_changes = self.camera_changes + 1
self.camera_last_changed_at = os.time()
self.camera_delay_noticed_at = nil
self.camera_last_captured_at = type(captured) == "string" and captured or nil
UIManager:show(view)
if previous then UIManager:close(previous) end
view.dithered = true
self:dirtyDashboard(view, self.camera_changes == 1)
self:scheduleCameraPoll(started_at)
end
local function printer_command_domain(action)
return action == "light" and "light" or "job"
end
local PRINTER_FEEDBACK_LABELS = { sending = "Sending", confirmed = "Confirmed",
uncertain = "Outcome uncertain", rejected = "Rejected", expired = "Expired",
resolved_unknown = "Closed; outcome uncertain" }
local function valid_printer_receipt(row)
return type(row) == "table" and valid_reprint_history_id(row.id)
and valid_printer_id(row.printer_id) and #row.printer_id <= 40
and (row.action == "light" or row.action == "pause" or row.action == "resume"
or row.action == "stop" or row.action == "speed" or row.action == "reprint")
and type(row.label) == "string" and #row.label > 0 and #row.label <= 100
and type(row.started_at) == "number" and row.started_at >= 0
and row.started_at <= 4102444800 and row.started_at % 1 == 0
end
function Dashboard:restorePrinterCommands()
self.printer_commands = {}
self.active_command = nil
self.command_send_tasks = {}
local saved = self.settings.printer_command_receipts
if type(saved) == "table" then
for index = 1, math.min(#saved, 32) do
local row = saved[index]
if valid_printer_receipt(row) then
local restored = { id = row.id, printer_id = row.printer_id, action = row.action,
label = row.label, started_at = row.started_at, value = row.value,
status = PRINTER_FEEDBACK_LABELS[row.status] and row.status or "uncertain",
locked = row.locked ~= false, detail = safe_label(row.detail, 240),
server_state = safe_label(row.server_state, 24),
confirmed_at = type(row.confirmed_at) == "number" and row.confirmed_at >= 0
and row.confirmed_at <= 4102444800 and row.confirmed_at % 1 == 0 and row.confirmed_at or nil }
if type(restored.value) ~= "number" and type(restored.value) ~= "string" then restored.value = nil end
if type(restored.value) == "string" then restored.value = safe_label(restored.value, 128) end
if restored.status == "sending" then restored.status = "uncertain" end
self:rememberPrinterCommand(restored)
end
end
end
local old = self.settings.printer_command_receipt
if valid_printer_receipt(old) and not self:getPendingPrinterCommand(old.printer_id, old.action) then
self:rememberPrinterCommand({ id = old.id, printer_id = old.printer_id, action = old.action,
label = old.label, started_at = old.started_at, status = "uncertain", locked = true,
detail = "Restored saved request. Checking its result without sending it again." })
end
self.settings.printer_command_receipt = nil
self:syncPrinterCommands()
end
function Dashboard:syncPrinterCommands()
self.active_command = nil
for _, row in ipairs(self.printer_commands or {}) do
if row.locked and not self.active_command then self.active_command = row end
end
self.settings.printer_command_receipts = self.printer_commands
self.settings.printer_command_receipt = nil
end
function Dashboard:savePrinterCommands()
self:syncPrinterCommands()
local ok, saved = pcall(function() return self:saveSettings() end)
return ok and saved ~= false
end
function Dashboard:getPendingPrinterCommand(printer_id, action)
for _, row in ipairs(self.printer_commands or {}) do
if row.printer_id == printer_id and printer_command_domain(row.action) == printer_command_domain(action)
and row.locked then return row end
end
local row = self.active_command
if row and row.printer_id == printer_id
and printer_command_domain(row.action) == printer_command_domain(action) then return row end
end
function Dashboard:rememberPrinterCommand(receipt)
self.printer_commands = self.printer_commands or {}
for index, row in ipairs(self.printer_commands) do
if row.id == receipt.id then return row end
if row.printer_id == receipt.printer_id
and printer_command_domain(row.action) == printer_command_domain(receipt.action) and not row.locked then
self.printer_commands[index] = receipt; self:syncPrinterCommands(); return row
end
end
if #self.printer_commands >= 32 then return false end
self.printer_commands[#self.printer_commands + 1] = receipt
self:syncPrinterCommands()
return nil
end
function Dashboard:removePrinterCommand(receipt, previous)
for index, row in ipairs(self.printer_commands or {}) do
if row == receipt then
if previous then self.printer_commands[index] = previous else table.remove(self.printer_commands, index) end
break
end
end
self:syncPrinterCommands()
end
function Dashboard:cancelPrinterSends()
local changed = false
for id, task in pairs(self.command_send_tasks or {}) do
UIManager:unschedule(task)
for _, row in ipairs(self.printer_commands or {}) do
if row.id == id then
row.status, row.locked, row.detail = "rejected", false,
"Not submitted: interrupted before delivery. No command was sent or retried."
changed = true
end
end
end
self.command_send_tasks = {}
if changed then self:savePrinterCommands() end
end
function Dashboard:applyPrinterCommandResult(pending, result)
if type(result) ~= "table" or result.id ~= pending.id or result.printer_id ~= pending.printer_id
or result.action ~= pending.action then return false end
local state, detail = result.state, safe_label(result.detail, 240)
local status, locked = "sending", true
if state == "accepted" then
if detail == "state_confirmed" or detail == "late_state_confirmed" then
status, locked = "confirmed", false
else
status, locked = "uncertain", true
end
elseif state == "unknown" then status = "uncertain"
elseif state == "rejected" or state == "expired" or state == "resolved_unknown" then status, locked = state, false
elseif state ~= "queued" and state ~= "claimed" then return false end
local changed = pending.status ~= status or pending.locked ~= locked
or pending.server_state ~= state or pending.detail ~= detail
pending.status, pending.locked, pending.server_state, pending.detail = status, locked, state, detail
if status == "confirmed" then pending.confirmed_at = pending.confirmed_at or os.time() end
if changed then
self.printer_feedback_revision = (self.printer_feedback_revision or 0) + 1
self:savePrinterCommands()
end
return true
end
function Dashboard:pollCommand()
if not self.running or self.suspended then return end
local revision = self.printer_feedback_revision or 0
local pending = {}
for _, row in ipairs(self.printer_commands or {}) do if row.locked then pending[#pending + 1] = row end end
if #pending == 0 then self:syncPrinterCommands(); return end
self.command_poll_cursor = (self.command_poll_cursor or 0) % #pending
for offset = 1, 1 do
local row = pending[(self.command_poll_cursor + offset - 1) % #pending + 1]
if not (self.command_send_tasks and self.command_send_tasks[row.id]) then
local body, code = self:requestRemote("/api/v1/commands/" .. row.id,
"GET", self.settings.control_token_file, nil, "application/json", MAX_JSON_BYTES)
if not (body and code == 200 and self:applyPrinterCommandResult(row, decode_json(body)))
or row.status == "sending" and os.time() - row.started_at >= 90 then
row.status = "uncertain"
local detail = "No verified result yet. Check the reported printer state; this request is never retried automatically."
if row.detail ~= detail then
row.detail = detail
self.printer_feedback_revision = (self.printer_feedback_revision or 0) + 1
self:savePrinterCommands()
end
end
end
end
self.command_poll_cursor = (self.command_poll_cursor + 1) % #pending
if revision ~= (self.printer_feedback_revision or 0) then self:refreshPrinterFeedbackMenu() end
UIManager:unschedule(self.command_poll_task)
local delay = 10
for _, row in ipairs(self.printer_commands or {}) do if row.locked and row.status == "sending" then delay = 2 end end
if self.active_command then UIManager:scheduleIn(delay, self.command_poll_task) end
end
function Dashboard:printerFeedbackLabel(printer_id, domain)
for _, row in ipairs(self.printer_commands or {}) do
if row.printer_id == printer_id and printer_command_domain(row.action) == domain then
return (domain == "light" and "Light" or "Print") .. ": "
.. (PRINTER_FEEDBACK_LABELS[row.status] or "Outcome uncertain") .. " · " .. row.action
.. ((row.action == "light" or row.action == "speed") and row.value ~= nil and " " .. tostring(row.value) or "")
end
end
return (domain == "light" and "Light" or "Print") .. ": no saved command · feedback details"
end
function Dashboard:printerReportedLabel(printer)
local names = { "Silent", "Standard", "Sport", "Ludicrous" }
local age = printer.stale_seconds
local freshness = printer.can_control and "Fresh" or "Stale / offline"
return "Reported: " .. printer.state .. " · light " .. (printer.chamber_light or "unknown")
.. "\nSpeed: " .. (names[printer.speed_level or 0] or "not reported") .. " · " .. freshness
.. (age and " · " .. tostring(math.floor(age + (printer.relay_age_seconds or 0)
+ math.max(0, os.time() - (printer.fetched_at or os.time())))) .. "s old" or " · age unknown")
end
function Dashboard:showPrinterCommandReport(printer_id, domain)
local lines = { self:printerFeedbackLabel(printer_id, domain),
"Only the affected control group is held while a request is unresolved. Other printers, the light / job group, camera and Print Doctor remain usable.",
"A saved command is never resent automatically after a timeout or restart." }
for _, row in ipairs(self.printer_commands or {}) do
if row.printer_id == printer_id and printer_command_domain(row.action) == domain then
lines[#lines + 1] = "Request: " .. row.id
lines[#lines + 1] = "Requested: " .. row.label .. (row.value ~= nil and " · " .. tostring(row.value) or "")
lines[#lines + 1] = "Started: " .. os.date("%Y-%m-%d %H:%M:%S", row.started_at)
lines[#lines + 1] = "Receipt state: " .. (row.server_state or "awaiting receipt")
lines[#lines + 1] = "Detail: " .. (row.detail or "Waiting for evidence")
lines[#lines + 1] = row.confirmed_at and "Confirmed at: " .. os.date("%Y-%m-%d %H:%M:%S", row.confirmed_at)
or "A delivery acknowledgement alone is not confirmation of the printer's reported state."
end
end
local printers, reason = self:getPrinters()
for _, printer in ipairs(printers or {}) do
if printer.id == printer_id then lines[#lines + 1] = ""; lines[#lines + 1] = self:printerReportedLabel(printer)
lines[#lines + 1] = "Report timestamp: " .. (printer.last_seen_at or "not reported") end
end
if not printers then lines[#lines + 1] = "Current printer report unavailable: " .. tostring(reason) end
self:showMediaInsightsText("Printer command feedback", lines)
end
function Dashboard:showPrinterCommandFeedback(printer_id, domain)
local pending = self:getPendingPrinterCommand(printer_id, domain == "light" and "light" or "pause")
local items = {
{ text = self:printerFeedbackLabel(printer_id, domain), enabled_func = function() return false end },
{ text = "Full request and reported-state details", callback = function() self:showPrinterCommandReport(printer_id, domain) end },
{ text = "Check saved request result", callback = function() self:pollCommand() end },
}
if pending and pending.action == "light" and os.time() - pending.started_at >= 130 then
items[#items + 1] = { text = "I checked the light; close uncertain request", callback = function()
self:confirmClearPendingPrinterCommand(printer_id)
end }
end
self:showQuickMenu("Printer command feedback", items)
end
function Dashboard:closePrinterControls()
self:closePrinterControlChildren()
if self.printer_command_confirm then UIManager:close(self.printer_command_confirm) end
if self.printer_controls_task then UIManager:unschedule(self.printer_controls_task) end
self.printer_controls_task = nil
local menu = self.printer_controls_menu
self.printer_controls_menu = nil
if menu then UIManager:close(menu) end
end
function Dashboard:closePrinterControlChildren()
local children = self.printer_controls_children or {}
self.printer_controls_children = {}
for index = #children, 1, -1 do UIManager:close(children[index]) end
end
function Dashboard:showPrinterConfirmation(box)
local dialog = ConfirmBox:new(box)
self.printer_command_confirm = dialog
local original = dialog.onCloseWidget
dialog.onCloseWidget = function(widget)
if self.printer_command_confirm == widget then self.printer_command_confirm = nil end
if original then original(widget) end
end
UIManager:show(dialog)
end
function Dashboard:schedulePrinterControls(menu)
if self.printer_controls_task then UIManager:unschedule(self.printer_controls_task) end
if not self.running or self.suspended or self.printer_controls_menu ~= menu then return end
local task
task = function()
if self.printer_controls_task ~= task or self.printer_controls_menu ~= menu then return end
self.printer_controls_task = nil
if not self.running or self.suspended then return end
if (self.quick_menu_count or 0) > (self.printer_controls_depth or 1) or self.camera_view
or self.media_insights_view or self.printer_command_confirm then
self:schedulePrinterControls(menu)
else self:showPrinterControls(self.printer_controls_id) end
end
self.printer_controls_task = task
UIManager:scheduleIn(15, task)
end
function Dashboard:refreshPrinterFeedbackMenu()
if self.printer_controls_menu and (self.quick_menu_count or 0) <= (self.printer_controls_depth or 1)
and not self.camera_view and not self.media_insights_view and not self.printer_command_confirm then
self:showPrinterControls(self.printer_controls_id)
end
end
function Dashboard:showPrinterControls(printer_id)
self:closePrinterControls()
local rows = self:buildPrinterMenu()
for _, row in ipairs(rows) do
if row.printer and row.printer.id == printer_id then
local menu = self:showQuickMenu(row.text, row.sub_item_table)
self.printer_controls_menu, self.printer_controls_id, self.printer_controls_depth = menu, printer_id, self.quick_menu_count
local original = menu.onCloseWidget
menu.onCloseWidget = function(widget)
if self.printer_controls_menu == widget then
self.printer_controls_menu = nil
if self.printer_controls_task then UIManager:unschedule(self.printer_controls_task) end
self.printer_controls_task = nil
end
if original then original(widget) end
end
self:schedulePrinterControls(menu)
return menu
end
end
self:notice("Printer controls unavailable. Reopen once a fresh report is available.", 8)
end
function Dashboard:sendCommand(printer, action, value, confirmation)
if self:getPendingPrinterCommand(printer.id, action) then
self:notice("This printer's " .. printer_command_domain(action)
.. " request is still sending or uncertain. Other controls remain usable.", 8)
return
end
if not valid_printer_id(printer.id) then return end
if action == "light" then
if value ~= "on" and value ~= "off" then return end
elseif action == "pause" or action == "resume" or action == "stop"
or action == "speed" or action == "reprint" then
local rows, reason, history = self:getPrinters()
if not rows then
self:notice("Cannot verify printer status: " .. tostring(reason), 8)
return
end
local current
for _, row in ipairs(rows) do
if row.id == printer.id then current = row; break end
end
if not current or current.job_name ~= printer.job_name or current.job_identity ~= printer.job_identity
or current.state ~= printer.state then
self:notice("Printer controls or job state changed. Open controls again.", 8)
return
end
if action == "reprint" then
if not current.can_control
or (current.state ~= "idle" and current.state ~= "finished")
or not valid_reprint_history_id(value)
or confirmation ~= "BED_CLEAR" then
self:notice("Reprint is not ready. Check printer state and history.", 8)
return
end
local available = false
for _, entry in ipairs(history and history[current.id] or {}) do
if entry.id == value and entry.available == true then
available = true
break
end
end
if not available then
self:notice("That completed print is not verified for reprint.", 8)
return
end
elseif not current.control_capabilities[action] or not current.job_identity then
self:notice("Printer controls changed. Open controls again.", 8)
return
end
if action == "speed" and (type(value) ~= "number" or value % 1 ~= 0
or value < 1 or value > 4) then return end
if action == "speed" and current.speed_level == value then
self:notice("That print speed is already selected.")
return
end
if action ~= "speed" and action ~= "reprint" and value ~= nil then return end
if action == "stop" then
if confirmation ~= "STOP" then return end
elseif action ~= "reprint" and confirmation ~= nil then return end
printer = current
else
return
end
if not NetworkMgr:isConnected() then
self:notice("Wi-Fi is disconnected. No command was sent.")
return
end
local _, token_error = read_bearer_token(self.settings.control_token_file)
if token_error then
self:notice("Control token unavailable: " .. token_error)
return
end
local base = clean_base_url(self.settings.base_url)
if not base or not allowed_target(base, self.settings.proxy_mode) then
self:notice("Configure a supported dashboard connection route first.")
return
end
local id = require("random").uuid(true):lower()
local command = {
request_id = id,
printer_id = printer.id,
action = action,
}
if action=="pause" or action=="resume" or action=="stop" or action=="speed" then command.job_identity=printer.job_identity end
if value ~= nil then command.value = value end
if confirmation then command.confirm = confirmation end
local JSON = require("json")
local encoded = JSON.encode(command)
local label = safe_label(printer.name, 48) .. " " .. action
if action == "speed" then
label = label .. " " .. tostring(value)
end
local receipt = { id = id, printer_id = printer.id, action = action,
label = label, started_at = os.time(), status = "sending", locked = true,
value = value, detail = "Waiting for delivery and a later printer report." }
local previous = self:rememberPrinterCommand(receipt)
if previous == false then self:notice("Saved command capacity reached. Review existing requests.", 8); return end
local saved, flush_result = pcall(function() return self:savePrinterCommands() end)
if not saved or flush_result == false then
self:removePrinterCommand(receipt, previous)
self:notice("Could not save the command receipt. No command was sent.", 8)
return
end
self:notice("Sending: " .. label .. ". Other control groups remain usable.", 3)
self:closePrinterControlChildren()
self:refreshPrinterFeedbackMenu()
local task
task = function()
if not self.command_send_tasks or self.command_send_tasks[id] ~= task then return end
self.command_send_tasks[id] = nil
local rows = self.running and not self.suspended and NetworkMgr:isConnected() and self:getPrinters()
local current
for _, row in ipairs(rows or {}) do if row.id == printer.id then current = row end end
local elapsed = os.time() - receipt.started_at
if not current or not current.can_control or elapsed < 0 or elapsed > 10
or action ~= "light" and (current.state ~= printer.state or current.job_name ~= printer.job_name
or current.job_identity ~= printer.job_identity) then
receipt.status, receipt.locked, receipt.detail = "rejected", false,
"Not submitted: connection, printer state or delivery window changed before dispatch. No command was sent."
self:savePrinterCommands()
else
local body, code = self:requestRemote("/api/v1/commands", "POST",
self.settings.control_token_file, encoded, "application/json", MAX_JSON_BYTES)
local response = body and decode_json(body)
local definitive_rejection = body and (code == 400 or code == 409) and type(response) == "table"
and type(response.error) == "string" and #response.error > 0 and #response.error <= 240
if definitive_rejection then
for key in pairs(response) do if key ~= "error" then definitive_rejection = false end end
end
if definitive_rejection then
receipt.status, receipt.locked, receipt.server_state, receipt.detail = "rejected", false, "rejected",
"The relay rejected this submission (HTTP " .. tostring(code) .. "). No retry was attempted."
self:savePrinterCommands()
elseif body and code == 202 and self:applyPrinterCommandResult(receipt, response) then
else
receipt.status = "uncertain"
receipt.detail = "Delivery receipt unavailable or unverified. Checking the saved request ID; no automatic retry."
self:savePrinterCommands()
end
end
self:refreshPrinterFeedbackMenu()
UIManager:unschedule(self.command_poll_task)
if self.running and not self.suspended then UIManager:scheduleIn(2, self.command_poll_task) end
end
self.command_send_tasks = self.command_send_tasks or {}
self.command_send_tasks[id] = task
UIManager:scheduleIn(0.2, task)
end
function Dashboard:historyMenu(printer, entries)
local items = {}
for _, entry in ipairs(entries or {}) do
local selected = entry
local ready = printer.can_control
and (printer.state == "idle" or printer.state == "finished")
and selected.available == true and not self:getPendingPrinterCommand(printer.id, "reprint")
items[#items + 1] = {
text = selected.name .. " · " .. selected.finished_at
.. (ready and " · Reprint" or " · Reprint unavailable"),
enabled_func = function() return ready end,
callback = function() self:confirmReprint(printer, selected) end,
}
end
if #items == 0 then
return {{ text = "No recent print history", enabled_func = function() return false end }}
end
return items
end
function Dashboard:confirmReprint(printer, entry)
if self:getPendingPrinterCommand(printer.id, "reprint") then
self:notice("This printer has an unresolved job request. Check its result before reprinting.", 8)
return
end
if not printer.can_control
or (printer.state ~= "idle" and printer.state ~= "finished")
or entry.available ~= true or not valid_reprint_history_id(entry.id) then
self:notice("This completed print is not ready for reprint.", 8)
return
end
self:showPrinterConfirmation({
text = "Start a new print of " .. safe_label(entry.name, 56)
.. " on " .. safe_label(printer.name, 48) .. "?\n"
.. "Remove the previous print and check that the bed is clear."
.. " The printer may heat and move as soon as you confirm.",
ok_text = "Bed clear; start print",
flush_events_on_show = true,
ok_callback = function()
self:sendCommand(printer, "reprint", entry.id, "BED_CLEAR")
end,
})
end
function Dashboard:confirmStop(printer)
local name, job = safe_label(printer.name, 48), safe_label(printer.job_name, 64)
self:showPrinterConfirmation({
text = "Stop " .. name .. "?\nCurrent job: " .. job .. "\nThis cannot be undone.",
ok_text = "Stop print",
flush_events_on_show = true,
ok_callback = function()
local current, reason = self:getPrinters()
if not current then
self:notice("Cannot verify current job: " .. tostring(reason), 8)
return
end
for _, row in ipairs(current) do
if row.id == printer.id then
if not row.can_control then
self:notice("Printer status is offline or stale. Stop was not sent.", 8)
return
end
if row.job_name ~= printer.job_name or row.state ~= printer.state or row.job_identity ~= printer.job_identity then
self:notice("Printer job changed. Open controls again before stopping.", 8)
return
end
self:sendCommand(row, "stop", nil, "STOP")
return
end
end
self:notice("Printer is no longer in the status list.", 8)
end,
})
end
function Dashboard:confirmClearPendingPrinterCommand(printer_id)
local pending = printer_id and self:getPendingPrinterCommand(printer_id, "light") or self.active_command
if not pending or pending.action ~= "light" or os.time() - pending.started_at < 130 then
self:notice("Only a light request can be closed after its result window and a fresh physical check. Job requests require server verification.", 10)
return
end
self:showPrinterConfirmation({
text = "Close this saved light request only after checking the light itself. This does not cancel or retry a command, and does not prove its outcome.",
ok_text = "I checked the light", flush_events_on_show = true,
ok_callback = function()
if self:getPendingPrinterCommand(pending.printer_id, "light") ~= pending
or os.time() - pending.started_at < 130 then return end
local fresh = false
for _, printer in ipairs(self:getPrinters() or {}) do
if printer.id == pending.printer_id and printer.can_control then fresh = true end
end
if not fresh then self:notice("Fresh printer status is required before closing this light request.", 8); return end
local status, detail = pending.status, pending.detail
pending.status, pending.locked, pending.detail = "resolved_unknown", false,
"Operator checked the light and closed this local receipt; outcome remains uncertain. No command was resent."
local ok, saved = pcall(function() return self:savePrinterCommands() end)
if not ok or saved == false then
pending.status, pending.locked, pending.detail = status, true, detail
self:syncPrinterCommands()
self:notice("Could not save the closed light receipt.", 8)
return
end
self:closePrinterControlChildren()
self:refreshPrinterFeedbackMenu()
self:notice("Light request closed after your check; printer outcome remains uncertain.", 8)
end,
})
end
function Dashboard:getDoctorState(printer)
local path = doctor_path(printer.id)
if not path then return nil, "Print Doctor is not configured for this printer" end
local body, code = self:requestRemote(path, "GET", self.settings.token_file,
nil, "application/json", MAX_JSON_BYTES)
if body == nil then return nil, code end
if code == 401 or code == 403 then return nil, "Dashboard token was rejected" end
if code ~= 200 then return nil, "Print Doctor returned HTTP " .. tostring(code) end
local state = decode_json(body)
if not state or state.printer_id ~= printer.id
or type(state.enabled) ~= "boolean"
or type(state.interval_minutes) ~= "number"
or type(state.state) ~= "string" then
return nil, "Print Doctor response is invalid"
end
return state
end
function Dashboard:showDoctorReport(printer, current_state)
local state, reason = current_state, nil
if not state then state, reason = self:getDoctorState(printer) end
if not state then
self:notice("Print Doctor unavailable: " .. tostring(reason), 8)
return
end
local lines = {
"Printer: " .. safe_label(printer.name, 48),
"Check status: " .. safe_label(state.state, 20),
"Automatic checks: " .. (state.enabled
and ("On · every " .. doctor_interval_label(state.interval_minutes) .. " while printing")
or ("Off · saved frequency " .. doctor_interval_label(state.interval_minutes))),
"Analysis attempts today: " .. tostring(tonumber(state.checks_today) or 0)
.. "/" .. tostring(tonumber(state.daily_limit) or 48),
"Last check: " .. safe_label(state.last_checked_at, 32),
"Camera frame: " .. safe_label(state.camera_captured_at, 32),
}
if type(state.detail) == "string" and state.detail ~= "" then
lines[#lines + 1] = "\nStatus detail: " .. safe_label(state.detail, 120)
end
local result = state.last_result
if type(result) == "table" then
lines[#lines + 1] = "\nLATEST COMPLETED DIAGNOSIS"
lines[#lines + 1] = "Summary: " .. safe_label(result.summary, 280)
if type(result.print_quality_score) == "number" then
if type(result.confidence) == "number" and result.confidence < 0.3 then
lines[#lines + 1] = "Quality score: inconclusive (model returned "
.. tostring(result.print_quality_score) .. "/10)"
else
lines[#lines + 1] = "Quality score: " .. tostring(result.print_quality_score) .. "/10"
end
end
if type(result.confidence) == "number" then
lines[#lines + 1] = "Confidence: " .. tostring(math.floor(result.confidence * 100 + 0.5)) .. "%"
if result.confidence < 0.3 then
lines[#lines + 1] = "Low confidence. Check camera lighting and visibility; inspect the print before acting."
end
end
if type(result.estimated_cost_usd) == "number" then
lines[#lines + 1] = "Estimated AI cost: $" .. string.format("%.4f", result.estimated_cost_usd)
end
if type(result.issues) == "table" then
for index, issue in ipairs(result.issues) do
if index > 6 then break end
if type(issue) == "table" then
lines[#lines + 1] = "\nIssue " .. index .. ": "
.. safe_label(issue.name, 70) .. " (" .. safe_label(issue.severity, 20) .. ")"
lines[#lines + 1] = safe_label(issue.description, 300)
if type(issue.fixes) == "table" then
for fix_index, fix in ipairs(issue.fixes) do
if fix_index > 4 then break end
if type(fix) == "table" then
lines[#lines + 1] = "Fix " .. fix_index .. " · "
.. safe_label(fix.setting, 160)
if type(fix.current_likely) == "string" and fix.current_likely ~= "" then
lines[#lines + 1] = "Likely now: "
.. safe_label(fix.current_likely, 160)
end
lines[#lines + 1] = "Recommended: "
.. safe_label(fix.recommended, 160)
if type(fix.explanation) == "string" and fix.explanation ~= "" then
lines[#lines + 1] = safe_label(fix.explanation, 160)
end
end
end
end
end
end
end
if type(result.general_tips) == "table" then
local count = 0
for _, tip in ipairs(result.general_tips) do
if count >= 5 then break end
if type(tip) == "string" then
if count == 0 then lines[#lines + 1] = "\nGENERAL TIPS" end
lines[#lines + 1] = "• " .. safe_label(tip, 180)
count = count + 1
end
end
end
else
lines[#lines + 1] = "\nNo completed diagnosis yet. Choose Analyze camera now to run one."
end
lines[#lines + 1] = "\nAI camera analysis is advisory; inspect the printer before acting."
UIManager:show(TextViewer:new {
title = "Print Doctor · " .. safe_label(printer.name, 48),
text = table.concat(lines, "\n"),
height = math.floor(Screen:getHeight() * 0.9),
})
end
function Dashboard:setDoctorSettings(printer, enabled, interval_minutes)
local path = doctor_path(printer.id, "/settings")
if not path or type(enabled) ~= "boolean" then return end
local allowed = false
for _, interval in ipairs(DOCTOR_INTERVALS) do
if interval_minutes == interval then allowed = true; break end
end
if not allowed then return end
local payload = require("json").encode {
enabled = enabled, interval_minutes = interval_minutes,
}
local body, code = self:requestRemote(path, "POST",
self.settings.control_token_file, payload, "application/json", MAX_JSON_BYTES)
if body == nil then
self:notice("Auto check setting uncertain: " .. tostring(code)
.. ". Open Print Doctor status before retrying.", 9)
return
end
if code ~= 200 then
local error_body = decode_json(body)
local detail = error_body and safe_label(error_body.error, 120) or "Request rejected"
self:notice("Auto check setting rejected (HTTP " .. tostring(code)
.. "): " .. detail, 8)
return
end
local state = decode_json(body)
if not state or state.printer_id ~= printer.id
or state.enabled ~= enabled or state.interval_minutes ~= interval_minutes then
self:notice("Auto check response is invalid; open Print Doctor status.", 8)
return
end
self:notice("Automatic Print Doctor checks " .. (enabled and "on" or "off")
.. " · " .. doctor_interval_label(interval_minutes) .. " interval.", 8)
end
function Dashboard:pollDoctor()
local pending = self.active_doctor
if not pending or not self.running or self.suspended then return end
local state = self:getDoctorState(pending.printer)
if state and state.request_id == pending.id then
if state.state == "completed" or state.state == "failed" or state.state == "unknown" then
self.active_doctor = nil
self:showDoctorReport(pending.printer, state)
return
end
end
if os.time() - pending.started_at >= 140 then
self.active_doctor = nil
self:notice("Print Doctor outcome uncertain. Open its status before trying again.", 9)
return
end
UIManager:scheduleIn(3, self.doctor_poll_task)
end
function Dashboard:analyzeWithDoctor(printer)
if self.active_doctor then
self:notice("Wait for the previous Print Doctor result.", 7)
return
end
local path = doctor_path(printer.id, "/analyze")
if not path then return end
if not NetworkMgr:isConnected() then
self:notice("Wi-Fi is disconnected. No analysis was requested.", 7)
return
end
local _, token_error = read_bearer_token(self.settings.control_token_file)
if token_error then
self:notice("Control token unavailable: " .. token_error, 7)
return
end
local id = require("random").uuid(true):lower()
local payload = require("json").encode { request_id = id, confirm = "ANALYZE" }
local body, code = self:requestRemote(path, "POST",
self.settings.control_token_file, payload, "application/json", MAX_JSON_BYTES)
if body and code ~= 202 then
local error_body = decode_json(body)
local detail = error_body and safe_label(error_body.error, 120) or "Request rejected"
self:notice("Print Doctor request rejected (HTTP " .. tostring(code)
.. "): " .. detail, 8)
return
end
self.active_doctor = { id = id, printer = printer, started_at = os.time() }
if body then
local response = decode_json(body)
if not response or response.request_id ~= id then
self:notice("Print Doctor receipt was invalid. Checking the same request ID.", 8)
else
self:notice("Print Doctor is analyzing the latest camera frame.", 8)
end
else
self:notice("Print Doctor receipt uncertain. Checking the same request ID.", 8)
end
UIManager:scheduleIn(3, self.doctor_poll_task)
end
function Dashboard:showDoctorMenu(printer)
local state, reason = self:getDoctorState(printer)
if not state then
self:notice("Print Doctor unavailable: " .. tostring(reason), 8)
return
end
local interval = state.interval_minutes
local interval_items = {}
for _, candidate in ipairs(DOCTOR_INTERVALS) do
local minutes = candidate
interval_items[#interval_items + 1] = {
text = doctor_interval_label(minutes) .. (minutes == interval and " (current)" or ""),
close_on_select = true,
callback = function()
local latest, error_message = self:getDoctorState(printer)
if not latest then
self:notice("Print Doctor unavailable: " .. tostring(error_message), 8)
return
end
self:setDoctorSettings(printer, latest.enabled, minutes)
end,
}
end
local auto_label = state.enabled and "Turn automatic checks off"
or "Turn automatic checks on"
local result_label = "Last completed: No diagnosis yet"
if type(state.last_result) == "table" then
local result = state.last_result
local issues = type(result.issues) == "table" and #result.issues or 0
local score = ""
if type(result.confidence) == "number" and result.confidence < 0.3 then
score = "inconclusive · "
elseif type(result.print_quality_score) == "number" then
score = tostring(result.print_quality_score) .. "/10 · "
end
result_label = "Last completed: " .. score .. tostring(issues)
.. (issues == 1 and " reported issue" or " reported issues")
end
local items = {
{ text = "Auto checks: " .. (state.enabled
and ("On · every " .. doctor_interval_label(interval) .. " while printing")
or ("Off · saved every " .. doctor_interval_label(interval))),
enabled_func = function() return false end },
{ text = "Current check: " .. safe_label(state.state, 20),
enabled_func = function() return false end },
{ text = result_label, enabled_func = function() return false end },
{ text = "Read full diagnosis", callback = function()
self:showDoctorReport(printer, state)
end },
{ text = "Analyze camera now (paid AI check)",
enabled_func = function() return printer.can_control end,
callback = function()
UIManager:show(ConfirmBox:new {
text = "Analyze the latest camera frame from " .. safe_label(printer.name, 48)
.. "? This makes one paid AI vision call."
.. " A fresh camera frame is required."
.. " The result is advice; it does not stop the print.",
ok_text = "Analyze camera",
flush_events_on_show = true,
ok_callback = function() self:analyzeWithDoctor(printer) end,
})
end },
{ text = auto_label, close_on_select = true, callback = function()
local latest, error_message = self:getDoctorState(printer)
if not latest then
self:notice("Print Doctor unavailable: " .. tostring(error_message), 8)
return
end
if latest.enabled then
self:setDoctorSettings(printer, false, latest.interval_minutes)
else
UIManager:show(ConfirmBox:new {
text = "Enable automatic Print Doctor camera checks for "
.. safe_label(printer.name, 48) .. " every "
.. doctor_interval_label(latest.interval_minutes)
.. " while it is printing? Each check may incur an AI cost."
.. " The server caps this at 48 attempts per printer per UTC day."
.. " Automatic checks do not stop the print.",
ok_text = "Enable auto checks",
flush_events_on_show = true,
ok_callback = function()
self:setDoctorSettings(printer, true, latest.interval_minutes)
end,
})
end
end },
{ text = "Change auto-check frequency", sub_item_table = interval_items },
{ text = "Analysis attempts today: " .. tostring(tonumber(state.checks_today) or 0)
.. "/" .. tostring(tonumber(state.daily_limit) or 48),
enabled_func = function() return false end },
}
self:showQuickMenu("Print Doctor · " .. safe_label(printer.name, 48), items)
end
function Dashboard:buildPrinterMenu()
local printers, reason, history = self:getPrinters()
if not printers then
return {{ text = "Controls unavailable: " .. tostring(reason),
enabled_func = function() return false end }}
end
local items = {}
for _, printer in ipairs(printers) do
local p = printer
local caps = p.control_capabilities or {}
local print_controls_ready = caps.pause or caps.resume or caps.stop or caps.speed
local no_active_print = p.can_control and p.control_link_ready == true
and (p.state == "finished" or p.state == "idle" or p.state == "ready")
local control_label = print_controls_ready and "Print controls"
or (no_active_print and "No active print" or "Print control connection unavailable (details)")
items[#items + 1] = {
printer = p,
text = p.name .. " (" .. p.state .. (p.can_control and "" or ", stale/offline") .. ")",
sub_item_table = {
{ text = self:printerReportedLabel(p), enabled_func = function() return false end },
{ text = self:printerFeedbackLabel(p.id, "job"), callback = function() self:showPrinterCommandFeedback(p.id, "job") end },
{ text = self:printerFeedbackLabel(p.id, "light"), callback = function() self:showPrinterCommandFeedback(p.id, "light") end },
{ text = "Refresh state and command feedback", close_on_select = true,
callback = function() self:pollCommand(); self:showPrinterControls(p.id) end },
{ text = "Camera snapshot", callback = function() self:showCamera(p) end },
{ text = "Print Doctor", enabled_func = function()
return doctor_path(p.id) ~= nil end,
callback = function() self:showDoctorMenu(p) end },
{ text = "Recent prints (last 10)",
sub_item_table = self:historyMenu(p, history and history[p.id]) },
{ text = control_label,
callback = print_controls_ready and nil
or function() self:notice(no_active_print
and "No active print. Pause, resume, stop, and speed controls appear during a print."
or SECURE_CONTROL_MESSAGE, 10) end,
sub_item_table = print_controls_ready and {
{ text = "Pause print", enabled_func = function() return caps.pause and not self:getPendingPrinterCommand(p.id, "pause") end,
callback = function() self:sendCommand(p, "pause") end },
{ text = "Resume print", enabled_func = function() return caps.resume and not self:getPendingPrinterCommand(p.id, "resume") end,
callback = function() self:sendCommand(p, "resume") end },
{ text = "Print speed", enabled_func = function() return caps.speed and not self:getPendingPrinterCommand(p.id, "speed") end,
sub_item_table = {
{ text = "Silent (1)" .. (p.speed_level == 1 and " · current" or ""),
enabled_func = function() return p.speed_level ~= 1 end,
callback = function() self:sendCommand(p, "speed", 1) end },
{ text = "Standard (2)" .. (p.speed_level == 2 and " · current" or ""),
enabled_func = function() return p.speed_level ~= 2 end,
callback = function() self:sendCommand(p, "speed", 2) end },
{ text = "Sport (3)" .. (p.speed_level == 3 and " · current" or ""),
enabled_func = function() return p.speed_level ~= 3 end,
callback = function() self:sendCommand(p, "speed", 3) end },
{ text = "Ludicrous (4)" .. (p.speed_level == 4 and " · current" or ""),
enabled_func = function() return p.speed_level ~= 4 end,
callback = function() self:sendCommand(p, "speed", 4) end },
} },
{ text = "Stop print", enabled_func = function() return caps.stop and not self:getPendingPrinterCommand(p.id, "stop") end,
callback = function() self:confirmStop(p) end },
} or nil },
{ text = "Chamber light", enabled_func = function() return p.can_control and not self:getPendingPrinterCommand(p.id, "light") end,
sub_item_table = {
{ text = "On", callback = function() self:sendCommand(p, "light", "on") end },
{ text = "Off", callback = function() self:sendCommand(p, "light", "off") end },
} },
},
}
end
if #items == 0 then
return {{ text = "No configured printers", enabled_func = function() return false end }}
end
return items
end
function Dashboard:showPrinterActionAt(pos)
local x,y=self:imageTapCoordinates(pos)
if not x then self:showQuickControls();return end
local items=self:buildPrinterMenu()
if #items~=2 or not items[1].printer or not items[2].printer then self:showQuickControls();return end
for index=1,2 do
local top=238+(index-1)*576
if x>=35 and x<1229 and y>=top and y<top+550 then
self:showPrinterControls(items[index].printer.id);return
end
end
self:showQuickControls()
end

function Dashboard:imageTapCoordinates(pos)
local rect = self.image_rect
if self.view_kind ~= "png" or not rect or not pos
or type(pos.x) ~= "number" or type(pos.y) ~= "number"
or rect.png_w ~= 1264 or rect.png_h ~= 1680
or pos.x < rect.x or pos.x >= rect.x + rect.w
or pos.y < rect.y or pos.y >= rect.y + rect.h then
return nil, nil
end
return (pos.x - rect.x) * rect.png_w / rect.w,
(pos.y - rect.y) * rect.png_h / rect.h
end
function Dashboard:showQuickMenu(title, items)
local dialog
local buttons = {}
for _, item in ipairs(items) do
local row = item
local enabled = not row.enabled_func or row.enabled_func()
buttons[#buttons + 1] = {{
text = row.text,
background = enabled and dashboard_color_enabled() and dashboard_color("canvas") or nil,
enabled = enabled,
callback = function()
if row.close_on_select then UIManager:close(dialog) end
if row.printer then
self:showPrinterControls(row.printer.id)
elseif row.sub_item_table then
self:showQuickMenu(row.text, row.sub_item_table)
elseif row.callback then
row.callback()
end
end,
}}
end
buttons[#buttons + 1] = {{
text = self.quick_menu_count == 0 and "Back to dashboard" or "Back",
callback = function() UIManager:close(dialog) end,
}}
dialog = ButtonDialog:new {
title = title,
title_align = "center", use_info_style = false,
buttons = buttons,
}
dialog.dithered = dashboard_color_enabled()
local original_close = dialog.onCloseWidget
dialog.onCloseWidget = function(widget)
self.quick_menu_count = math.max(0, self.quick_menu_count - 1)
for index, child in ipairs(self.printer_controls_children or {}) do
if child == widget then table.remove(self.printer_controls_children, index); break end
end
original_close(widget)
if type(UIManager.nextTick) == "function" then self:deferCleanScreen() end
end
self.quick_menu_count = self.quick_menu_count + 1
if self.printer_controls_menu then
self.printer_controls_children = self.printer_controls_children or {}
self.printer_controls_children[#self.printer_controls_children + 1] = dialog
end
UIManager:show(dialog)
self:dirtyDashboard(dialog)
return dialog
end
function Dashboard:getPlexStatus()
local body, code = self:requestRemote("/api/v1/plex/status", "GET",
self.settings.token_file, nil, "application/json", MAX_JSON_BYTES)
if body == nil then return nil, tostring(code) end
if code ~= 200 then return nil, "HTTP " .. tostring(code) end
local state = decode_json(body)
if type(state) ~= "table" or state.schema_version ~= 1
or type(state.plex) ~= "table" or type(state.seerr) ~= "table"
or type(state.drives) ~= "table" or type(state.services) ~= "table" then
return nil, "Invalid Plex status"
end
return state
end
local INSIGHT_STAGES = { pending = "Requested", searching = "Searching",
downloading = "Downloading", importing = "Importing", available = "Available (reported)",
blocked = "Blocked", unknown = "Progress unknown" }
local INSIGHT_REASONS = {
pending_approval = "Waiting for request approval", search_not_started = "Search has not started",
no_indexer_results = "No matching indexer results", download_client_unavailable = "Download client unavailable",
download_paused = "Download paused", download_stalled = "Download stalled",
import_pending = "Waiting for import", import_failed = "Import needs attention",
plex_refresh_pending = "Waiting for Plex library refresh", media_unavailable = "Media not available yet",
source_unavailable = "A data source is unavailable", access_denied = "Data source access denied",
drive_missing = "Destination drive missing", unknown = "Reason not reported",
seerr_available = "Requested items are available in Seerr; Plex playback not independently verified",
awaiting_release = "Waiting for a future episode / release",
}
local INSIGHT_SOURCES = { seerr = "Seerr", sonarr = "Sonarr", radarr = "Radarr",
qbittorrent = "qBittorrent", sabnzbd = "SABnzbd" }
local INSIGHT_STATES = { online = "Online", partial = "Partial coverage", unavailable = "Unavailable",
denied = "Access denied", unsupported = "Unsupported" }
local INSIGHT_CAPABILITIES = { supported = "Reported", unsupported = "Unsupported by this connection",
denied = "Access denied", unavailable = "Unavailable" }
local function json_is_null(value)
if value == nil or type(value) == "userdata" then return true end
local JSON = require("json")
if JSON.null ~= nil and rawequal(value, JSON.null) then return true end
return type(JSON.util) == "table" and JSON.util.null ~= nil
and rawequal(value, JSON.util.null) or false
end
local function insight_number(value, maximum, minimum)
return type(value) == "number" and value == value and value >= (minimum or 0) and value <= maximum and value or nil
end
local function insight_time(value)
if type(value) == "string" and #value == 20
and value:match("^%d%d%d%d%-%d%d%-%d%dT%d%d:%d%d:%d%dZ$") then return value end
return "Unknown"
end
local function insight_label(value, maximum)
if type(value) ~= "string" or #value > 640 or value:find("[\\]")
or value:match("^/") or value:match("%a+://") or value:match("^%a:[/\\]")
or value:lower():match("^magnet:") then
return "Title withheld"
end
local chars = {}
for char in safe_label(value, 640):gmatch("[%z\1-\127\194-\244][\128-\191]*") do
if #chars >= maximum then break end
chars[#chars + 1] = char
end
return #chars > 0 and table.concat(chars) or "Unknown"
end
local function insight_text(value, maximum)
local chars = {}
for char in safe_label(value, maximum * 4):gmatch("[%z\1-\127\194-\244][\128-\191]*") do
if #chars >= maximum then break end
chars[#chars + 1] = char
end
return table.concat(chars)
end
local function insight_duration(value)
value = insight_number(value, 31536000)
if not value then return "Unknown" end
if value < 60 then return math.floor(value) .. "s" end
if value < 3600 then return math.floor(value / 60) .. "m" end
if value < 86400 then return math.floor(value / 3600) .. "h " .. math.floor(value % 3600 / 60) .. "m" end
return math.floor(value / 86400) .. "d " .. math.floor(value % 86400 / 3600) .. "h"
end
local function insight_capacity(value)
value = insight_number(value, 1125899906842624)
if not value then return "Unknown" end
if value >= 1099511627776 then return string.format("%.2f TiB", value / 1099511627776) end
return string.format("%.1f GiB", value / 1073741824)
end
local function insight_array(value, maximum)
if type(value) ~= "table" or #value > maximum then return false end
local count = 0
for key in pairs(value) do
if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > #value then return false end
count = count + 1
end
return count == #value
end
local function insight_stage(row)
if row.stage == "available" then
for _, reason in ipairs(row.reasons) do if reason == "seerr_available" then return "Available · Seerr" end end
elseif row.stage == "searching" then
for _, reason in ipairs(row.reasons) do if reason == "awaiting_release" then return "Waiting for release" end end
end
return INSIGHT_STAGES[row.stage]
end
local function insight_tracker(row)
local tracker = row.tracker
if json_is_null(tracker) then return nil end
if type(tracker) ~= "table" or tracker.schema_version ~= 1
or insight_time(tracker.stage_since) == "Unknown"
or (not json_is_null(tracker.requested_at) and insight_time(tracker.requested_at) == "Unknown")
or type(tracker.explanation) ~= "string" or #tracker.explanation > 2800
or not insight_array(tracker.next_steps, 3) or type(tracker.selection) ~= "table"
or not insight_array(tracker.selection.seasons, 100) then return nil end
for _, step in ipairs(tracker.next_steps) do
if type(step) ~= "string" or #step > 960 then return nil end
end
for _, season in ipairs(tracker.selection.seasons) do
if not insight_number(season, 10000, 1) or season % 1 ~= 0 then return nil end
end
for _, key in ipairs({ "files_present", "files_expected" }) do
local count = tracker.selection[key]
if not json_is_null(count) and (not insight_number(count, 10000000) or count % 1 ~= 0) then return nil end
end
local destination = tracker.destination
if not json_is_null(destination) and (type(destination) ~= "table"
or not ({ c = true, m = true, n = true })[destination.id]
or type(destination.label) ~= "string" or #destination.label > 160
or not ({ mounted = true, missing = true, unknown = true })[destination.state]) then return nil end
return tracker
end
local function insight_destination(row)
local tracker = insight_tracker(row)
local destination = tracker and tracker.destination
if json_is_null(destination) then return "SSD destination not reported" end
return destination.id:upper() .. ": " .. insight_label(destination.label, 40)
.. (destination.state == "missing" and " · DISCONNECTED"
or destination.state == "unknown" and " · mount unknown" or "")
end
local function insight_coverage(block)
local count = #block.requests
local unknown = "Showing " .. count .. " requests · total coverage unknown"
local coverage = block.coverage
if type(coverage) ~= "table" or not insight_number(coverage.sample_limit, 80, 1)
or coverage.sample_limit % 1 ~= 0 or coverage.sample_count ~= count
or not insight_number(coverage.observed_count, coverage.sample_limit * 4, count)
or coverage.observed_count % 1 ~= 0 or not insight_array(coverage.filters, 4) then return unknown end
local seen, limited, incomplete = {}, coverage.observed_count > count, false
for _, filter in ipairs(coverage.filters) do
if type(filter) ~= "table" or not ({ processing = true, pending = true, failed = true, all = true })[filter.name]
or seen[filter.name] or not insight_number(filter.observed_count, coverage.sample_limit)
or filter.observed_count % 1 ~= 0 then return unknown end
seen[filter.name] = true
if not json_is_null(filter.reported_count) and (not insight_number(filter.reported_count, 2147483647)
or filter.reported_count % 1 ~= 0) then return unknown end
if json_is_null(filter.complete) then incomplete = true
elseif filter.complete == true then
if filter.reported_count ~= filter.observed_count then return unknown end
elseif filter.complete == false then
if not insight_number(filter.reported_count, 2147483647, filter.observed_count + 1) then return unknown end
limited = true
else return unknown end
end
local expected = (#coverage.filters ~= 4 or incomplete) and "unknown" or (limited and "limited" or "complete")
if coverage.state ~= expected or expected == "unknown" then return unknown end
if expected == "limited" then return "Showing " .. count .. " requests · more requests outside this window (up to "
.. coverage.sample_limit .. " shown)" end
return "Showing all " .. count .. " reported requests"
end
local function insight_valid(value)
if type(value) ~= "table" or value.schema_version ~= 1
or type(value.available) ~= "boolean" or type(value.stale) ~= "boolean"
or type(value.source_ages) ~= "table" then return false end
if not value.available then return type(value.snapshot) ~= "table" end
local snapshot = value.snapshot
if type(snapshot) ~= "table" or snapshot.schema_version ~= 1
or snapshot.source ~= "windows-media-insights" or insight_time(snapshot.generated_at) == "Unknown"
or type(snapshot.acquisition) ~= "table" or type(snapshot.storage) ~= "table"
or not INSIGHT_STATES[snapshot.acquisition.state] or not INSIGHT_STATES[snapshot.storage.state]
or insight_time(snapshot.acquisition.checked_at) == "Unknown" or insight_time(snapshot.storage.checked_at) == "Unknown"
or not insight_array(snapshot.acquisition.requests, 80) or not insight_array(snapshot.acquisition.sources, 5)
or not insight_array(snapshot.storage.drives, 3) then return false end
local sources = {}
for _, row in ipairs(snapshot.acquisition.sources) do
if type(row) ~= "table" or not INSIGHT_SOURCES[row.source] or sources[row.source]
or not INSIGHT_STATES[row.state] or insight_time(row.checked_at) == "Unknown" then return false end
sources[row.source] = true
end
for _, row in ipairs(snapshot.acquisition.requests) do
if type(row) ~= "table" or type(row.title) ~= "string"
or not INSIGHT_STAGES[row.stage] or not insight_array(row.history, 6)
or not insight_array(row.reasons, 3) then return false end
for _, event in ipairs(row.history) do
if type(event) ~= "table" or not INSIGHT_STAGES[event.stage] or insight_time(event.at) == "Unknown" then return false end
end
for _, reason in ipairs(row.reasons) do if not INSIGHT_REASONS[reason] then return false end end
end
local volumes = {}
for _, row in ipairs(snapshot.storage.drives) do
if type(row) ~= "table" or (row.volume_id ~= "c" and row.volume_id ~= "m" and row.volume_id ~= "n")
or volumes[row.volume_id] or type(row.capabilities) ~= "table"
or not ({ mounted = true, missing = true, unknown = true })[row.mount_state]
or not ({ healthy = true, warning = true, critical = true, unknown = true })[row.health_state]
or not ({ healthy = true, warning = true, critical = true, unknown = true })[row.provider_health]
or not insight_array(row.disconnects, 8) then return false end
for _, key in ipairs({ "smart", "wear", "temperature", "media_errors" }) do
if not INSIGHT_CAPABILITIES[row.capabilities[key]] then return false end
end
for _, event in ipairs(row.disconnects) do
if type(event) ~= "table" or (event.event ~= "disconnected" and event.event ~= "reconnected")
or insight_time(event.at) == "Unknown" then return false end
end
volumes[row.volume_id] = true
end
return true
end
function Dashboard:getMediaInsights()
local body, code = self:requestRemote("/api/v1/plex/insights", "GET",
self.settings.token_file, nil, "application/json", MAX_JSON_BYTES, nil, true)
local value = body and code == 200 and decode_json(body) or nil
if insight_valid(value) then
if value.available then
self.media_insights_cache = { data = value, fetched_at = os.time() }
return self.media_insights_cache
end
local failure = value.error_code == "invalid_store" and "Stored observations are unavailable"
or "Waiting for the first collector snapshot"
if self.media_insights_cache then return { data = self.media_insights_cache.data,
fetched_at = self.media_insights_cache.fetched_at, failure = failure } end
return { data = value, fetched_at = os.time(), failure = failure }
end
local failure = (code == 401 or code == 403) and "Reader access rejected"
or (body and code == 200 and "Collector response could not be read")
or (type(code) == "number" and "Refresh failed (HTTP " .. tostring(code) .. ")")
or "Refresh unavailable; check Wi-Fi and the relay"
if self.media_insights_cache then return { data = self.media_insights_cache.data,
fetched_at = self.media_insights_cache.fetched_at, failure = failure } end
return { failure = failure, fetched_at = os.time() }
end
function Dashboard:mediaInsightsSummary(context)
local value = context.data
if not value or not value.available then return context.failure or "No snapshot available" end
local elapsed = math.max(0, os.time() - context.fetched_at)
local age = insight_number(value.age_seconds, 31536000)
local stale = context.failure ~= nil or value.stale or age == nil or age + elapsed > 180
return (stale and "Saved / stale" or "Latest reported") .. " · snapshot age "
.. insight_duration(age and age + elapsed) .. (context.failure and " · refresh unavailable" or "")
end
function Dashboard:mediaInsightsObservation(context, section)
local value = context.data
local block = value and value.available and value.snapshot[section] or nil
local age = value and insight_number(value.source_ages[section], 31536000)
local elapsed = math.max(0, os.time() - context.fetched_at)
return "Observation: " .. insight_time(block and block.checked_at)
.. " · source age " .. insight_duration(age and age + elapsed)
end
function Dashboard:showMediaInsightsText(title, lines)
if self.media_insights_view then UIManager:close(self.media_insights_view) end
local viewer = TextViewer:new { title = title, text = table.concat(lines, "\n"),
height = math.floor(Screen:getHeight() * 0.9) }
local original_close = viewer.onCloseWidget
viewer.onCloseWidget = function(widget)
if self.media_insights_view == widget then
self.media_insights_view = nil
self.quick_menu_count = math.max(0, (self.quick_menu_count or 1) - 1)
end
if original_close then original_close(widget) end
end
self.media_insights_view = viewer
self.quick_menu_count = (self.quick_menu_count or 0) + 1
UIManager:show(viewer)
end
function Dashboard:showMediaInsightSources(context)
local value = context.data
local snapshot = value and value.available and value.snapshot or nil
local lines = { self:mediaInsightsSummary(context),
"Captured: " .. insight_time(snapshot and snapshot.generated_at),
"Relay received: " .. insight_time(value and value.received_at),
"", "Source ages describe observations, not proof that every title is current." }
if snapshot then lines[#lines + 1] = insight_coverage(snapshot.acquisition) end
local ages = value and value.source_ages or {}
local elapsed = math.max(0, os.time() - context.fetched_at)
for _, key in ipairs({ "acquisition", "storage", "seerr", "sonarr", "radarr", "qbittorrent", "sabnzbd" }) do
local age = insight_number(ages[key], 31536000)
lines[#lines + 1] = (INSIGHT_SOURCES[key] or (key == "storage" and "Storage" or "Acquisition"))
.. " age: " .. insight_duration(age and age + elapsed)
end
if context.failure then lines[#lines + 1] = "\nRefresh: " .. context.failure end
for _, source in ipairs(snapshot and snapshot.acquisition.sources or {}) do
if type(source) == "table" and INSIGHT_SOURCES[source.source] then
lines[#lines + 1] = "\n" .. INSIGHT_SOURCES[source.source] .. ": "
.. (INSIGHT_STATES[source.state] or "Unknown") .. " · checked " .. insight_time(source.checked_at)
end
end
self:showMediaInsightsText("Observation freshness", lines)
end
function Dashboard:showMediaRequestDetail(context, row)
local tracker = insight_tracker(row)
local lines = { self:mediaInsightsSummary(context), self:mediaInsightsObservation(context, "acquisition"),
"", insight_label(row.title, 160),
"Current stage: " .. insight_stage(row),
"Download: " .. (insight_number(row.progress_pct, 100) and string.format("%.1f%%", row.progress_pct) or "Not reported"),
"ETA: " .. insight_duration(row.eta_seconds),
"Progress / ETA describe the matched download batch, not completion of every requested episode.",
"Destination SSD: " .. insight_destination(row),
"Stage observed: " .. insight_time(tracker and tracker.stage_since or row.stage_at) }
if tracker then
local selection = tracker.selection
if #selection.seasons > 0 then
local seasons = {}
for _, number in ipairs(selection.seasons) do seasons[#seasons + 1] = tostring(number) end
lines[#lines + 1] = "Requested seasons: " .. table.concat(seasons, ", ")
end
lines[#lines + 1] = (#selection.seasons > 0 and "Aired episode files in requested seasons: " or "Movie files: ")
.. (insight_number(selection.files_present, 10000000)
and tostring(selection.files_present) or "Unknown") .. " / "
.. (insight_number(selection.files_expected, 10000000) and tostring(selection.files_expected) or "Unknown")
end
lines[#lines + 1] = "\nRequested → searching → downloading → importing → available"
local observed = {}
for _, event in ipairs(row.history) do observed[event.stage] = event.at end
if tracker and not json_is_null(tracker.requested_at) then observed.pending = tracker.requested_at end
for _, stage in ipairs({ "pending", "searching", "downloading", "importing", "available" }) do
lines[#lines + 1] = (stage == row.stage and "▶ " or "• ") .. (stage == "available" and "Available" or INSIGHT_STAGES[stage])
.. ": " .. (stage == row.stage and ("CURRENT · " .. insight_time(tracker and tracker.stage_since or row.stage_at))
or observed[stage] and ("observed " .. insight_time(observed[stage])) or "not observed")
end
if tracker then
lines[#lines + 1] = "\nWhat is happening / why it is waiting:"
lines[#lines + 1] = insight_text(tracker.explanation, 700)
if #tracker.next_steps > 0 then
lines[#lines + 1] = "\nWhat to do next:"
for index, step in ipairs(tracker.next_steps) do
lines[#lines + 1] = tostring(index) .. ". " .. insight_text(step, 240)
end
end
end
lines[#lines + 1] = "\nObserved timeline:"
if #row.history == 0 then lines[#lines + 1] = "No stage history reported." end
for _, event in ipairs(row.history) do
if type(event) == "table" and INSIGHT_STAGES[event.stage] then
lines[#lines + 1] = "• " .. INSIGHT_STAGES[event.stage] .. " · " .. insight_time(event.at)
end
end
lines[#lines + 1] = "\nWaiting / blocked reasons:"
if #row.reasons == 0 then lines[#lines + 1] = "None reported; this does not guarantee completion." end
for _, reason in ipairs(row.reasons) do lines[#lines + 1] = "• " .. (INSIGHT_REASONS[reason] or "Reason not reported") end
lines[#lines + 1] = "\nStages reflect matched collector observations. A download or import is not by itself Plex availability."
lines[#lines + 1] = "The request list refreshes every 15 seconds. This report is a captured view; close it to see updated progress."
if context.failure then lines[#lines + 1] = "Refresh: " .. context.failure end
self:showMediaInsightsText("Request progress", lines)
end
function Dashboard:closeMediaTracker()
if self.media_tracker_poll_task then UIManager:unschedule(self.media_tracker_poll_task) end
self.media_tracker_poll_task = nil
local menu = self.media_tracker_menu
self.media_tracker_menu = nil
if menu then UIManager:close(menu) end
end
function Dashboard:scheduleMediaTrackerRefresh(menu, offset)
if self.media_tracker_poll_task then UIManager:unschedule(self.media_tracker_poll_task) end
if self.suspended or not self.running or self.media_tracker_menu ~= menu then return end
local task
task = function()
if self.media_tracker_poll_task ~= task or self.media_tracker_menu ~= menu then return end
self.media_tracker_poll_task = nil
if self.suspended or not self.running then return end
if self.media_insights_view or (self.quick_menu_count or 0) > (self.media_tracker_menu_depth or 1) then
self:scheduleMediaTrackerRefresh(menu, offset)
return
end
self:showMediaInsights("acquisition", offset)
end
self.media_tracker_poll_task = task
if UIManager.scheduleIn then UIManager:scheduleIn(15, task) end
end
function Dashboard:showMediaDriveDetail(context, row)
local caps = row.capabilities
local lines = { self:mediaInsightsSummary(context), self:mediaInsightsObservation(context, "storage"),
"", "Drive " .. row.volume_id:upper() .. ":",
"Mount: " .. (({ mounted = "Mounted", missing = "Missing / disconnected" })[row.mount_state] or "Unknown") }
lines[#lines + 1] = "Capacity: " .. insight_capacity(row.free_bytes) .. " free / " .. insight_capacity(row.total_bytes) .. " total (last reported)"
local labels = { healthy = "Healthy", warning = "Warning", critical = "Critical", unknown = "Unknown" }
lines[#lines + 1] = "Windows provider: " .. labels[row.provider_health]
lines[#lines + 1] = "SMART hardware health: " .. (caps.smart == "supported" and labels[row.health_state] or "Unknown")
local function metric(label, key, value, maximum, suffix, minimum)
local number = insight_number(value, maximum, minimum)
lines[#lines + 1] = label .. ": " .. (caps[key] == "supported" and number and (tostring(number) .. suffix)
or (caps[key] == "supported" and "Not reported" or INSIGHT_CAPABILITIES[caps[key]]) or "Unavailable")
end
metric("Wear used", "wear", row.wear_pct, 100, "%")
metric("Temperature", "temperature", row.temp_c, 150, " °C", -20)
metric("Uncorrected errors", "media_errors", row.media_errors, 9007199254740991, "")
lines[#lines + 1] = "SMART access: " .. (INSIGHT_CAPABILITIES[caps.smart] or "Unavailable")
lines[#lines + 1] = "Disk identity: " .. (type(row.disk_identity) == "string" and "Recorded (opaque identifier)" or "Unavailable")
lines[#lines + 1] = "\nObserved connection changes:"
if #row.disconnects == 0 then lines[#lines + 1] = "None in this collector history; not a lifetime guarantee." end
for _, event in ipairs(row.disconnects) do
if type(event) == "table" then
local label = ({ disconnected = "Disconnected", reconnected = "Reconnected" })[event.event] or "Connection changed"
lines[#lines + 1] = "• " .. label .. " · " .. insight_time(event.at)
end
end
lines[#lines + 1] = "\nUnknown or access-denied metrics are not a clean bill of health. Data is observational; no disk operation is performed here."
if context.failure then lines[#lines + 1] = "Refresh: " .. context.failure end
self:showMediaInsightsText("SSD " .. row.volume_id:upper() .. ": health", lines)
end
function Dashboard:showMediaInsights(section, offset, context)
section = section == "storage" and "storage" or "acquisition"
if section == "acquisition" then self:closeMediaTracker() end
offset = type(offset) == "number" and math.max(0, math.floor(offset)) or 0
context = context or self:getMediaInsights()
local value = context.data
local snapshot = value and value.available and value.snapshot or nil
local items = {
{ text = self:mediaInsightsSummary(context), enabled_func = function() return false end },
{ text = "Refresh from collector", close_on_select = true,
callback = function() self:showMediaInsights(section, 0) end },
{ text = "Freshness and data sources", callback = function() self:showMediaInsightSources(context) end },
}
if section == "acquisition" then items[#items + 1] = {
text = "Auto-refresh: every 15s while this list is open · tap a title for its full report",
enabled_func = function() return false end } end
if section == "acquisition" and snapshot then items[#items + 1] = {
text = insight_coverage(snapshot.acquisition), enabled_func = function() return false end } end
if snapshot then
local data = snapshot[section]
items[#items + 1] = { text = (INSIGHT_STATES[data.state] or "Unknown coverage")
.. " · captured " .. insight_time(data.checked_at), enabled_func = function() return false end }
local rows = section == "storage" and data.drives or data.requests
if section == "acquisition" then
local priority = { blocked = 1, downloading = 2, importing = 3, searching = 4,
pending = 5, unknown = 6, available = 7 }
local ordered = {}
for index, row in ipairs(rows) do ordered[#ordered + 1] = { row = row, index = index } end
table.sort(ordered, function(a, b)
if priority[a.row.stage] == priority[b.row.stage] then return a.index < b.index end
return priority[a.row.stage] < priority[b.row.stage]
end)
rows = {}
for _, entry in ipairs(ordered) do rows[#rows + 1] = entry.row end
end
local per_page = section == "storage" and 3 or 6
offset = math.min(offset, math.max(0, math.floor((#rows - 1) / per_page) * per_page))
for index = offset + 1, math.min(#rows, offset + per_page) do
local row = rows[index]
if section == "storage" then
local mount = ({ mounted = "Mounted", missing = "Missing", unknown = "Unknown" })[row.mount_state] or "Unknown"
local provider = ({ healthy = "healthy", warning = "warning", critical = "critical", unknown = "unknown" })[row.provider_health]
local smart = row.capabilities.smart == "supported" and "SMART " .. row.health_state
or "SMART " .. (row.capabilities.smart == "denied" and "access denied" or "unavailable")
items[#items + 1] = { text = row.volume_id:upper() .. ": " .. mount .. " · " .. insight_capacity(row.free_bytes) .. " free\n"
.. "Windows " .. provider .. " · " .. smart, callback = function() self:showMediaDriveDetail(context, row) end }
else
local progress = insight_number(row.progress_pct, 100)
items[#items + 1] = { text = insight_label(row.title, 72) .. "\n" .. insight_stage(row)
.. (progress and " · " .. string.format("%.0f%%", progress) or "")
.. (insight_number(row.eta_seconds, 2592000) and " · ETA " .. insight_duration(row.eta_seconds) or "")
.. "\n" .. insight_destination(row)
.. (row.reasons[1] and "\n" .. (row.reasons[1] == "seerr_available" and "Requested items available in Seerr"
or INSIGHT_REASONS[row.reasons[1]]) or ""),
callback = function() self:showMediaRequestDetail(context, row) end }
end
end
if #rows == 0 then items[#items + 1] = { text = section == "storage" and "No drive observations available"
or (data.state == "online" and "No active acquisitions reported" or "Request progress unavailable"),
enabled_func = function() return false end } end
if offset > 0 then items[#items + 1] = { text = "Previous page", close_on_select = true,
callback = function() self:showMediaInsights(section, math.max(0, offset - per_page), context) end } end
if #rows > offset + per_page then items[#items + 1] = { text = "More requests", close_on_select = true,
callback = function() self:showMediaInsights(section, offset + per_page, context) end } end
else
items[#items + 1] = { text = "No observations yet; existing Plex controls are unchanged", enabled_func = function() return false end }
end
local menu = self:showQuickMenu(section == "storage" and "SSD health" or "Media request tracker", items)
if section == "acquisition" and menu then
self.media_tracker_menu = menu
self.media_tracker_offset = offset
self.media_tracker_menu_depth = self.quick_menu_count
local original_close = menu.onCloseWidget
menu.onCloseWidget = function(widget)
if self.media_tracker_menu == widget then
self.media_tracker_menu = nil
if self.media_tracker_poll_task then UIManager:unschedule(self.media_tracker_poll_task) end
self.media_tracker_poll_task = nil
end
if original_close then original_close(widget) end
end
self:scheduleMediaTrackerRefresh(menu, offset)
end
end
local WINDOWS_STATES = { online = "Online", partial = "Partial coverage", unavailable = "Unavailable",
denied = "Access denied", unsupported = "Unsupported" }
local WINDOWS_SOURCE_CODES = { source_unavailable = "Source unavailable", access_denied = "Access denied",
unsupported = "Unsupported", request_failed = "Source request failed", invalid_response = "Source response invalid",
not_observed = "Not observed" }
local WINDOWS_JOB_STATES = { queued = "Queued", running = "Running", completed = "Completed",
failed = "Failed", partial = "Partly completed", cancelled = "Cancelled", unknown = "Unknown" }
local WINDOWS_COMPUTE_EVIDENCE = { none = "Not observed", gpu_reported = "GPU capability only",
runtime_metadata = "Observed runtime metadata", completed_receipt = "Completed job receipt" }
local function windows_number(value, maximum, minimum)
return insight_number(value, maximum, minimum)
end
local function windows_optional_number(value, maximum, minimum)
return json_is_null(value) or windows_number(value, maximum, minimum) ~= nil
end
local function windows_valid(value)
if type(value) ~= "table" or value.schema_version ~= 1 or type(value.available) ~= "boolean"
or type(value.stale) ~= "boolean" or type(value.source_ages) ~= "table" then return false end
if not value.available then return type(value.snapshot) ~= "table" end
local snapshot = value.snapshot
if type(snapshot) ~= "table" or snapshot.schema_version ~= 1 or snapshot.source ~= "windows-telemetry"
or insight_time(snapshot.generated_at) == "Unknown" then return false end
for _, key in ipairs({ "host", "gpu", "subtitles" }) do
local block = snapshot[key]
if type(block) ~= "table" or not WINDOWS_STATES[block.state]
or insight_time(block.captured_at) == "Unknown" then return false end
if not json_is_null(block.code)
and (type(block.code) ~= "string" or not WINDOWS_SOURCE_CODES[block.code]) then return false end
end
local host = snapshot.host
if not windows_optional_number(host.cpu_percent, 100) or not windows_optional_number(host.ram_used_bytes, 1125899906842624)
or not windows_optional_number(host.ram_total_bytes, 1125899906842624)
or not windows_optional_number(host.uptime_seconds, 315576000) then return false end
local host_used, host_total = windows_number(host.ram_used_bytes, 1125899906842624), windows_number(host.ram_total_bytes, 1125899906842624)
if (host_used == nil) ~= (host_total == nil) or host_total and (host_total <= 0 or host_used > host_total) then return false end
if not insight_array(snapshot.gpu.devices, 4) or not insight_array(snapshot.subtitles.jobs, 6) then return false end
local seen = {}
for _, row in ipairs(snapshot.gpu.devices) do
if type(row) ~= "table" or type(row.id) ~= "string" or not row.id:match("^gpu%-[0-3]$")
or seen[row.id] or type(row.name) ~= "string" or #row.name > 400 then return false end
seen[row.id] = true
for _, metric in ipairs({ { "utilization_percent", 100 }, { "vram_used_bytes", 1125899906842624 },
{ "vram_total_bytes", 1125899906842624 }, { "temperature_c", 150, -20 },
{ "power_watts", 2000 }, { "power_limit_watts", 2000 } }) do
if not windows_optional_number(row[metric[1]], metric[2], metric[3]) then return false end
end
local used, total = windows_number(row.vram_used_bytes, 1125899906842624), windows_number(row.vram_total_bytes, 1125899906842624)
if (used == nil) ~= (total == nil) or total and (total <= 0 or used > total) then return false end
end
seen = {}
for _, row in ipairs(snapshot.subtitles.jobs) do
if type(row) ~= "table" or type(row.id) ~= "string" or #row.id < 16 or #row.id > 64
or not row.id:match("^[0-9a-f]+$") or seen[row.id] or type(row.title) ~= "string"
or #row.title > 640 or not WINDOWS_JOB_STATES[row.state]
or (row.target_type ~= "movie" and row.target_type ~= "show" and row.target_type ~= "season"
and row.target_type ~= "episode" and row.target_type ~= "unknown")
or insight_time(row.updated_at) == "Unknown"
or (row.compute_device ~= "cuda" and row.compute_device ~= "cpu" and row.compute_device ~= "unknown")
or not WINDOWS_COMPUTE_EVIDENCE[row.compute_evidence] then return false end
if row.compute_device ~= "unknown" and row.compute_evidence ~= "runtime_metadata"
and row.compute_evidence ~= "completed_receipt" then return false end
if (row.compute_evidence == "runtime_metadata" or row.compute_evidence == "completed_receipt")
and row.compute_device == "unknown" then return false end
if row.compute_evidence == "completed_receipt" and row.state ~= "completed"
and row.state ~= "partial" and row.state ~= "failed" then return false end
seen[row.id] = true
for _, metric in ipairs({ { "completed", 1000000 }, { "total", 1000000 }, { "failed", 1000000 },
{ "percent", 100 }, { "eta_seconds", 2592000 } }) do
if not windows_optional_number(row[metric[1]], metric[2]) then return false end
end
local completed, total, failed = windows_number(row.completed, 1000000), windows_number(row.total, 1000000), windows_number(row.failed, 1000000)
local percent = windows_number(row.percent, 100)
if (completed == nil) ~= (failed == nil) or completed and (not total or completed + failed > total)
or completed and completed % 1 ~= 0 or total and total % 1 ~= 0 or failed and failed % 1 ~= 0 then return false end
if percent and (not completed or not total or total == 0 or math.abs(percent - (completed + failed) * 100 / total) > 0.11) then return false end
end
return true
end
local function windows_metric(value, maximum, format, suffix, minimum)
local number = windows_number(value, maximum, minimum)
return number and (string.format(format or "%.0f", number) .. (suffix or "")) or "Not reported"
end
local function windows_capacity(value)
return windows_number(value, 1125899906842624) and insight_capacity(value) or "Not reported"
end
local function windows_source_age(context, key)
local value = context.data
local age = value and windows_number(value.source_ages[key], 31536000)
return age and age + math.max(0, os.time() - context.fetched_at) or nil
end
local function windows_source_suffix(context, key)
local age = windows_source_age(context, key)
return " · " .. ((not age or age > 180) and "stale " or "") .. insight_duration(age) .. " old"
end
function Dashboard:getWindowsStatus()
local body, code = self:requestRemote("/api/v1/windows/status", "GET",
self.settings.token_file, nil, "application/json", 64 * 1024, nil, true)
local value = body and code == 200 and decode_json(body) or nil
if windows_valid(value) then
if value.available then
self.windows_status_cache = { data = value, fetched_at = os.time() }
return self.windows_status_cache
end
local failure = value.error_code == "invalid_store" and "Stored Windows observations are unavailable"
or "Waiting for the first Windows snapshot"
if self.windows_status_cache then return { data = self.windows_status_cache.data,
fetched_at = self.windows_status_cache.fetched_at, failure = failure } end
return { data = value, fetched_at = os.time(), failure = failure }
end
local failure = (code == 401 or code == 403) and "Reader access rejected"
or (body and code == 200 and "Windows response could not be read")
or (type(code) == "number" and "Refresh failed (HTTP " .. tostring(code) .. ")")
or "Refresh unavailable; check Wi-Fi and the relay"
if self.windows_status_cache then return { data = self.windows_status_cache.data,
fetched_at = self.windows_status_cache.fetched_at, failure = failure } end
return { failure = failure, fetched_at = os.time() }
end
function Dashboard:windowsStatusSummary(context)
local value = context.data
if not value or not value.available then return context.failure or "No Windows snapshot available" end
local elapsed = math.max(0, os.time() - context.fetched_at)
local age = windows_number(value.age_seconds, 31536000)
local stale = context.failure ~= nil or value.stale or age == nil or age + elapsed > 180
return (stale and "Saved / stale" or "Latest reported") .. " · snapshot age "
.. insight_duration(age and age + elapsed) .. (context.failure and " · refresh unavailable" or "")
end
function Dashboard:windowsSourceSummary(context, key)
local value = context.data
local block = value and value.available and value.snapshot[key] or nil
if not block then return "No source observation" end
local age = windows_source_age(context, key)
return (WINDOWS_STATES[block.state] or "Unknown") .. " · " .. ((not age or age > 180) and "stale source" or "source")
.. " age " .. insight_duration(age)
.. "\nCaptured: " .. insight_time(block.captured_at)
.. (type(block.code) == "string" and (" · " .. (WINDOWS_SOURCE_CODES[block.code] or "Unknown source state")) or "")
end
function Dashboard:showWindowsText(title, lines)
if self.windows_status_view then UIManager:close(self.windows_status_view) end
local viewer = TextViewer:new { title = title, text = table.concat(lines, "\n"),
height = math.floor(Screen:getHeight() * 0.9) }
local original_close = viewer.onCloseWidget
viewer.onCloseWidget = function(widget)
if self.windows_status_view == widget then
self.windows_status_view = nil
self.quick_menu_count = math.max(0, (self.quick_menu_count or 1) - 1)
end
if original_close then original_close(widget) end
end
self.windows_status_view = viewer
self.quick_menu_count = (self.quick_menu_count or 0) + 1
UIManager:show(viewer)
end
function Dashboard:showWindowsSources(context)
local value = context.data
local lines = { self:windowsStatusSummary(context),
"Relay received: " .. insight_time(value and value.received_at) }
for _, key in ipairs({ "host", "gpu", "subtitles" }) do
lines[#lines + 1] = "\n" .. ({ host = "Windows host", gpu = "GPU sensors", subtitles = "Subtitle jobs" })[key]
lines[#lines + 1] = self:windowsSourceSummary(context, key)
end
if context.failure then lines[#lines + 1] = "\nRefresh: " .. context.failure end
lines[#lines + 1] = "\nMissing or stale measurements do not mean zero usage. GPU activity alone does not prove a subtitle job uses CUDA."
self:showWindowsText("Windows observation freshness", lines)
end
function Dashboard:showWindowsGpuDetail(context, row)
self:showWindowsText(insight_label(row.name, 100), {
self:windowsStatusSummary(context), self:windowsSourceSummary(context, "gpu"), "",
"GPU use: " .. windows_metric(row.utilization_percent, 100, "%.0f", "%"),
"VRAM: " .. windows_capacity(row.vram_used_bytes) .. " used / " .. windows_capacity(row.vram_total_bytes) .. " total",
"Temperature: " .. windows_metric(row.temperature_c, 150, "%.0f", " °C", -20),
"Power draw: " .. windows_metric(row.power_watts, 5000, "%.1f", " W"),
"Power limit: " .. windows_metric(row.power_limit_watts, 5000, "%.1f", " W"), "",
"Read-only GPU sensors. These readings cover all GPU work; subtitle-job device evidence is shown separately."
})
end
function Dashboard:showWindowsSubtitleDetail(context, row)
local completed = windows_number(row.completed, 1000000)
local total = windows_number(row.total, 1000000)
local lines = { self:windowsStatusSummary(context), self:windowsSourceSummary(context, "subtitles"), "",
insight_label(row.title, 160), "State: " .. WINDOWS_JOB_STATES[row.state],
"Scope: " .. row.target_type, "Files processed: " .. windows_metric(row.percent, 100, "%.1f", "%"),
"Items: " .. (completed and tostring(completed) or "Unknown") .. " completed / " .. (total and tostring(total) or "Unknown") .. " total",
"Failed items: " .. windows_metric(row.failed, 1000000),
"ETA: " .. insight_duration(row.eta_seconds), "Job updated: " .. insight_time(row.updated_at),
"Compute device: " .. (row.compute_device == "cuda" and "CUDA (observed)" or row.compute_device == "cpu" and "CPU (observed)" or "Unknown / not observed"),
"Device evidence: " .. WINDOWS_COMPUTE_EVIDENCE[row.compute_evidence],
"Model: " .. (type(row.model) == "string" and insight_label(row.model, 100) or "Not reported") }
if type(row.current_title) == "string" then lines[#lines + 1] = "Current item: " .. insight_label(row.current_title, 160) end
lines[#lines + 1] = "\nProgress counts processed files, not video transcription progress. Completed status does not establish subtitle accuracy or alignment quality."
self:showWindowsText("Subtitle job progress", lines)
end
function Dashboard:showWindowsStatus(offset, context)
offset = type(offset) == "number" and math.max(0, math.floor(offset)) or 0
context = context or self:getWindowsStatus()
local value = context.data
local snapshot = value and value.available and value.snapshot or nil
local items = {
{ text = self:windowsStatusSummary(context), enabled_func = function() return false end },
{ text = "Refresh Windows / GPU / subtitle jobs", close_on_select = true,
callback = function() self:showWindowsStatus(0) end },
{ text = "Freshness and data sources", callback = function() self:showWindowsSources(context) end },
}
if snapshot then
local host = snapshot.host
items[#items + 1] = { text = "Windows · " .. WINDOWS_STATES[host.state] .. windows_source_suffix(context, "host") .. "\nCPU "
.. windows_metric(host.cpu_percent, 100, "%.0f", "%") .. " · RAM " .. windows_capacity(host.ram_used_bytes)
.. " / " .. windows_capacity(host.ram_total_bytes), callback = function()
self:showWindowsText("Windows host", { self:windowsStatusSummary(context), self:windowsSourceSummary(context, "host"), "",
"CPU: " .. windows_metric(host.cpu_percent, 100, "%.1f", "%"),
"RAM: " .. windows_capacity(host.ram_used_bytes) .. " used / " .. windows_capacity(host.ram_total_bytes) .. " total",
"Uptime: " .. insight_duration(host.uptime_seconds) })
end }
for _, row in ipairs(snapshot.gpu.devices) do
items[#items + 1] = { text = insight_label(row.name, 56) .. "\nGPU "
.. windows_metric(row.utilization_percent, 100, "%.0f", "%") .. " · "
.. windows_metric(row.temperature_c, 150, "%.0f", " °C", -20) .. " · "
.. windows_metric(row.power_watts, 5000, "%.0f", " W") .. windows_source_suffix(context, "gpu"),
callback = function() self:showWindowsGpuDetail(context, row) end }
end
if #snapshot.gpu.devices == 0 then items[#items + 1] = { text = "GPU sensors · " .. WINDOWS_STATES[snapshot.gpu.state],
callback = function() self:showWindowsSources(context) end } end
local jobs = snapshot.subtitles.jobs
offset = math.min(offset, math.max(0, math.floor((#jobs - 1) / 3) * 3))
for index = offset + 1, math.min(#jobs, offset + 3) do
local row = jobs[index]
items[#items + 1] = { text = insight_label(row.title, 64) .. "\nSubtitle " .. WINDOWS_JOB_STATES[row.state]
.. (windows_number(row.percent, 100) and " · " .. windows_metric(row.percent, 100, "%.0f", "%") or "")
.. " · " .. (row.compute_device == "cuda" and "CUDA observed" or row.compute_device == "cpu" and "CPU observed" or "Compute unknown")
.. windows_source_suffix(context, "subtitles"),
callback = function() self:showWindowsSubtitleDetail(context, row) end }
end
if #jobs == 0 then items[#items + 1] = { text = snapshot.subtitles.state == "online"
and "No subtitle jobs reported" or "Subtitle job observations unavailable",
callback = function() self:showWindowsSources(context) end } end
if offset > 0 then items[#items + 1] = { text = "Previous subtitle jobs", close_on_select = true,
callback = function() self:showWindowsStatus(math.max(0, offset - 3), context) end } end
if #jobs > offset + 3 then items[#items + 1] = { text = "More subtitle jobs", close_on_select = true,
callback = function() self:showWindowsStatus(offset + 3, context) end } end
end
self:showQuickMenu("Windows / GPU / subtitle jobs", items)
end
do
local sections = { printers = "Printers", plex = "Media", storage = "Storage", services = "Services", subtitles = "Subtitles", system = "System" }
local kinds = { monitoring_started=true, print_completed=true, print_failed=true, media_available=true, media_failed=true, drive_missing=true,
service_unavailable=true, source_stale=true, subtitle_failed=true, subtitle_completed=true }
local severities = { info="Info", warning="Warning", critical="Critical" }
local ai_states = { queued="Queued", pending="Analyzing", complete="Ready", unavailable="Unavailable",
uncertain="Uncertain", budget_limited="Daily limit reached", disabled="Disabled" }
local navigation = { open_printer=true, open_media=true, open_storage=true, open_services=true, open_subtitles=true }
local single_actions = { mark_read=true, mark_unread=true, acknowledge=true, snooze=true,
mute=true, unmute=true, retry_ai=true }
local filters = { "Unread", "Active", "All", "Printers", "Media", "System" }
local function uuid(value)
return type(value)=="string" and #value==36 and value:match("^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$")
and value==value:lower()
end
local function text(value, maximum)
return type(value)=="string" and #value<=maximum*4 and not value:find("[%z\1-\8\11\12\14-\31]")
end
local function label(value, maximum)
if not text(value, 1600) then return "Not reported" end
local out={}
for char in value:gsub("[%c]", " "):gmatch("[%z\1-\127\194-\244][\128-\191]*") do
if #out>=maximum then break end
out[#out+1]=char
end
return table.concat(out)
end
local function array(value, maximum, validate)
if not insight_array(value, maximum) then return false end
for _,item in ipairs(value) do if not validate(item) then return false end end
return true
end
local function timestamp(value, nullable)
return nullable and json_is_null(value) or insight_time(value)~="Unknown"
end
local function quiet(value)
return type(value)=="table" and type(value.enabled)=="boolean"
and insight_number(value.start_hour,23) and value.start_hour%1==0
and insight_number(value.end_hour,23) and value.end_hour%1==0
and value.start_hour~=value.end_hour and value.timezone=="__INKBOARD_TIMEZONE__"
end
local function exact(value, fields)
if type(value)~="table" then return false end
for key in pairs(value) do if not fields[key] then return false end end
for key in pairs(fields) do if value[key]==nil then return false end end
return true
end
local function report_text(value, maximum)
if not text(value,maximum) or #value==0 then return false end
local index,count=1,0
while index<=#value do
local first=value:byte(index);local size=1
if first>=194 and first<=223 then size=2
elseif first>=224 and first<=239 then size=3
elseif first>=240 and first<=244 then size=4
elseif first>127 then return false end
if index+size-1>#value then return false end
for at=index+1,index+size-1 do
local part=value:byte(at)
if part<128 or part>191 then return false end
end
local second=size>1 and value:byte(index+1) or 0
if first==224 and second<160 or first==237 and second>159
or first==240 and second<144 or first==244 and second>143 then return false end
count=count+1;if count>maximum then return false end
index=index+size
end
return true
end
local function report_valid(value)
if not exact(value,{version=true,what_happened=true,impact=true,facts=true,likely_causes=true,
investigation=true,recovery=true,verification=true,unknowns=true,escalation=true})
or value.version~=1 or not report_text(value.what_happened,2400) or not report_text(value.impact,1600)
or not report_text(value.escalation,1200) then return false end
if not array(value.facts,8,function(v) return exact(v,{basis=true,detail=true})
and ({initial_event=true,initial_diagnostics=true,current_followup=true})[v.basis]
and report_text(v.detail,700) end)
or not array(value.likely_causes,4,function(v) return exact(v,{cause=true,support=true,confidence=true})
and report_text(v.cause,700) and report_text(v.support,700)
and ({low=true,medium=true,high=true,unknown=true})[v.confidence] end)
or not array(value.investigation,6,function(v) return exact(v,{location=true,check=true,expected=true})
and ({Printers=true,Plex=true,Storage=true,Services=true,Subtitles=true,Alerts=true,
["LLM status"]=true,["Site status"]=true,["Physical device"]=true})[v.location]
and report_text(v.check,800) and report_text(v.expected,600) end)
or not array(value.recovery,4,function(v) return exact(v,{action=true,prerequisite=true,caution=true})
and report_text(v.action,800) and report_text(v.prerequisite,600) and report_text(v.caution,600) end)
or not array(value.verification,4,function(v) return exact(v,{check=true,expected=true})
and report_text(v.check,600) and report_text(v.expected,600) end)
or not array(value.unknowns,6,function(v) return report_text(v,600) end) then return false end
local ok,encoded=pcall(function() return require("json").encode(value) end)
return ok and type(encoded)=="string" and #encoded<=18000
end
local function clarification_valid(value)
return exact(value,{summary=true,at=true,kind=true}) and value.kind=="policy_correction"
and report_text(value.summary,280) and timestamp(value.at)
end
local function incident_valid(v,row,detail)
if v==nil then return true end
local fields={version=true,cutoff=true,root_id=true,member_count=true,sections=true}
if type(v)=="table" and v.members~=nil then fields.members=true end
if not exact(v,fields) or v.version~=1 or not uuid(v.cutoff) or v.root_id~=row.id
or not insight_number(v.member_count,60,2) or v.member_count%1~=0 then return false end
local tags,ids={}, {[row.id]=true}
if not array(v.sections,6,function(k) if not sections[k] or tags[k] then return false end;tags[k]=true;return true end)
or not tags[row.section] then return false end
if v.members==nil then return not detail end
return type(v.members)=="table" and #v.members==v.member_count-1 and array(v.members,59,function(m)
if not exact(m,{id=true,title=true,section=true,severity=true,state=true}) or not uuid(m.id)
or ids[m.id] or not report_text(m.title,120) or not tags[m.section] or not severities[m.severity]
or m.state~="open" and m.state~="resolved" then return false end
ids[m.id]=true;return true
end)
end
local function incident_options(row,minutes)
local value={minutes=minutes}
if row.incident then value.incident_cutoff=row.incident.cutoff end
return value
end
local function alert_section(row,key)
if row.section==key then return true end
for _,section in ipairs(row.incident and row.incident.sections or {}) do if section==key then return true end end
return false
end
local function row_valid(row, detail)
if type(row)~="table" or not uuid(row.id) or not kinds[row.kind] or not sections[row.section]
or not severities[row.severity] or (row.state~="open" and row.state~="resolved")
or not text(row.title,120) or not text(row.summary,320)
or not timestamp(row.occurred_at) or not timestamp(row.last_seen_at)
or not insight_number(row.occurrences,1000000000,1) or row.occurrences%1~=0
or type(row.unread)~="boolean" or type(row.acknowledged)~="boolean"
or type(row.muted)~="boolean" or type(row.notify)~="boolean"
or not timestamp(row.snoozed_until,true) or type(row.ai)~="table" or not ai_states[row.ai.status]
or type(row.target)~="table" or not sections[row.target.section]
or not array(row.actions,5,function(v) return navigation[v]==true end)
or not incident_valid(row.incident,row,detail) then return false end
if row.archived~=nil and type(row.archived)~="boolean" then return false end
if not json_is_null(row.target.entity_id) and not text(row.target.entity_id,100) then return false end
local ai=row.ai
if not ({ low=true,medium=true,high=true,unknown=true })[ai.confidence]
or not timestamp(ai.analyzed_at,true)
or (not json_is_null(ai.summary) and not text(ai.summary,1200))
or (not json_is_null(ai.likely_cause) and not text(ai.likely_cause,600))
or not array(ai.suggested_checks,6,function(v) return text(v,240) end) then return false end
if detail and (not array(row.evidence,12,function(v) return type(v)=="table" and text(v.label,80) and text(v.value,320) end)
or not array(row.checks,8,function(v) return text(v,240) end)) then return false end
return true
end
local function list_valid(value)
if type(value)~="table" or value.schema_version~=1 or not timestamp(value.generated_at)
or not quiet(value.quiet_hours) or type(value.quiet_hours.active)~="boolean" or type(value.counts)~="table"
or not array(value.source_status,16,function(v) return type(v)=="table" and text(v.id,80)
and ({online=true,stale=true,unavailable=true})[v.state] and timestamp(v.checked_at,true)
and (json_is_null(v.age_seconds) or insight_number(v.age_seconds,315360000)) end)
or not array(value.alerts,60,function(v) return row_valid(v,false) end) then return false end
if value.archive_cutoff~=nil and not uuid(value.archive_cutoff) then return false end
if value.view~=nil and value.view~="history" and value.view~="inbox" then return false end
if value.includes_archived~=nil and type(value.includes_archived)~="boolean" then return false end
if value.archived_count~=nil and (not insight_number(value.archived_count,1000000000) or value.archived_count%1~=0) then return false end
for _,key in ipairs({"unread","open","total","attention"}) do
if not insight_number(value.counts[key],1000000000) or value.counts[key]%1~=0 then return false end
end
if value.counts.unread>value.counts.total or value.counts.open>value.counts.total or value.counts.attention>value.counts.unread then return false end
local ids={}
for _,row in ipairs(value.alerts) do if ids[row.id] then return false end;ids[row.id]=true end
return true
end
function Dashboard:validAlertUuid(value) return uuid(value)~=nil and uuid(value)~=false end
function Dashboard:validAlertAction(payload)
if type(payload)~="table" or not uuid(payload.request_id) then return false end
local fields={request_id=true,action=true}
if single_actions[payload.action] then
if not uuid(payload.alert_id) then return false end
fields.alert_id=true
if payload.incident_cutoff~=nil then
if payload.action=="retry_ai" or not uuid(payload.incident_cutoff) then return false end
fields.incident_cutoff=true
end
if payload.action=="snooze" then
if not ({[15]=true,[60]=true,[240]=true,[1440]=true})[payload.minutes] then return false end
fields.minutes=true
end
elseif payload.action=="set_quiet_hours" then
if not quiet(payload.quiet_hours) then return false end
for key in pairs(payload.quiet_hours) do if not ({enabled=true,start_hour=true,end_hour=true,timezone=true})[key] then return false end end
fields.quiet_hours=true
elseif payload.action=="archive_all" then
if not uuid(payload.cutoff) then return false end
fields.cutoff=true
elseif payload.action~="mark_all_read" then return false end
for key in pairs(payload) do if not fields[key] then return false end end
return true
end
function Dashboard:getAlerts(background)
self.alert_badge_checked_at=os.time()
local body,code=self:requestRemote("/api/v1/alerts","GET",self.settings.token_file,nil,"application/json",65536,nil,true,background and true or nil)
local value=body and code==200 and decode_json(body) or nil
if list_valid(value) then
self.alerts_cache={data=value,fetched_at=os.time()}
self.alerts_badge_stale=false
return self.alerts_cache
end
local local_failures = {
["Wi-Fi is disconnected"] = "Alerts need Wi-Fi; connect and refresh",
["KOReader CA bundle is missing"] = "Alerts need the KOReader CA bundle; repair KOReader",
["KOReader LuaSec HTTPS support is unavailable"] = "Alerts need KOReader HTTPS support; repair KOReader",
["Dashboard TLS hostname check failed; check the device clock and certificate"] = "Alerts TLS identity check failed; check the device clock",
["Dashboard TLS chain check failed; check the device clock and KOReader CA bundle"] = "Alerts TLS certificate check failed; check the clock and KOReader CA bundle",
["Dashboard request timed out; check Wi-Fi and retry"] = "Alerts timed out; check Wi-Fi and refresh",
}
local failure = (code==401 or code==403) and "Reader access rejected; restore dashboard access"
or (body and code==200 and (value and "Alert response format is incompatible; update the dashboard"
or "Alert response could not be read; refresh or update the dashboard"))
or (type(code)=="number" and code>=100 and code<=599 and code%1==0 and "Alerts request failed (HTTP "..tostring(code)..")")
or local_failures[code]
or "Alerts connection failed; check Wi-Fi and refresh"
self.alerts_badge_stale=true
return {data=self.alerts_cache and self.alerts_cache.data,fetched_at=self.alerts_cache and self.alerts_cache.fetched_at or os.time(),failure=failure}
end
function Dashboard:getAlertHistory()
local body,code=self:requestRemote("/api/v1/alerts/history","GET",self.settings.token_file,nil,
"application/json",65536,nil,true)
local value=body and code==200 and decode_json(body) or nil
if list_valid(value) and value.view=="history" and value.includes_archived==true then
self.alerts_history_cache={data=value,fetched_at=os.time(),history=true}
return self.alerts_history_cache
end
local failure=(code==404 or code==405) and "Alert history is not enabled on the server yet; the inbox still works"
or (code==401 or code==403) and "History reader access rejected; restore dashboard access"
or "Alert history could not refresh; showing saved history if available"
local cached=self.alerts_history_cache
return {data=cached and cached.data,fetched_at=cached and cached.fetched_at or os.time(),history=true,failure=failure}
end
function Dashboard:getAlertView()
return self.alerts_mode=="history" and self:getAlertHistory() or self:getAlerts()
end
function Dashboard:showAlertHistory()
self.alerts_mode="history";self.alerts_filter="All";self.alerts_offset=0
self:renderAlerts(self:getAlertHistory(), true)
end
function Dashboard:showAlertInbox()
self.alerts_mode="inbox";self.alerts_filter="Unread";self.alerts_offset=0
self:renderAlerts(self:getAlerts(), true)
end
function Dashboard:alertSummary(context)
if not context.data then return context.failure and label(context.failure,120) or "No alerts snapshot yet" end
local summary = ((context.failure or os.time()-context.fetched_at>180) and "Saved / stale · " or "Updated · ") .. insight_time(context.data.generated_at)
.. " · " .. tostring(context.data.counts.unread) .. " unread"
if context.failure then summary = summary .. "\n" .. label(context.failure,120) end
return summary
end
function Dashboard:alertCoverage(context)
local sources = context.data and context.data.source_status
if type(sources) ~= "table" then return nil end
local total, stale, unavailable = 0, 0, 0
for _, source in ipairs(sources) do
total = total + 1
if source.state == "stale" then stale = stale + 1
elseif source.state == "unavailable" then unavailable = unavailable + 1 end
end
if total == 0 then return "Source coverage unknown · no sources reported" end
if stale + unavailable > 0 then
return "Coverage degraded · " .. tostring(stale) .. " stale / " .. tostring(unavailable)
.. " unavailable of " .. tostring(total) .. " sources"
end
return nil
end
function Dashboard:filteredAlerts(context)
local rows={}
local filter=self.alerts_filter or "Unread"
for _,row in ipairs(context.data and context.data.alerts or {}) do
if filter=="All" or filter=="Unread" and row.unread
or filter=="Active" and row.state=="open" and row.severity~="info" and not row.acknowledged
or filter=="Printers" and alert_section(row,"printers")
or filter=="Media" and (alert_section(row,"plex") or alert_section(row,"storage") or alert_section(row,"subtitles"))
or filter=="System" and (alert_section(row,"services") or alert_section(row,"system")) then rows[#rows+1]=row end
end
return rows
end
function Dashboard:scheduleAlertBadgeRefresh()
if self.alert_badge_task or os.time()-(self.alert_badge_checked_at or 0)<60 then return end
self.alert_badge_task=function()
self.alert_badge_task=nil
if not self.running or self.suspended or self.active_tab==6 or self.quick_menu_count>0
or self.camera_view or self.active_command or self.active_plex_command or self.active_doctor
or self.active_ebook_job or self.active_subtitle_job or not NetworkMgr:isConnected() then return end
self.alert_badge_checked_at=os.time()
local previous=self.alerts_cache and self.alerts_cache.data
local previous_count=previous and previous.counts.attention
local previous_quiet=previous and previous.quiet_hours.active
local stale=self.alerts_badge_stale
self:getAlerts(true)
local current=self.alerts_cache and self.alerts_cache.data
if current and (previous_count~=current.counts.attention or previous_quiet~=current.quiet_hours.active
or stale~=self.alerts_badge_stale) then
local cache=self.tab_cache[self.active_tab]
if cache and cache.png and self.view_kind=="png" then self:showPng(cache.png) end
end
end
UIManager:scheduleIn(.3,self.alert_badge_task)
end
local function alert_local_time(value)
if insight_time(value)=="Unknown" then return "Time unavailable" end
local y,m,d,h,n=value:match("^(%d+)%-(%d+)%-(%d+)T(%d+):(%d+)")
y,m,d=tonumber(y),tonumber(m),tonumber(d)
y=y-(m<=2 and 1 or 0)
local era=math.floor(y/400);local year=y-era*400
local days=era*146097+year*365+math.floor(year/4)-math.floor(year/100)
+math.floor((153*(m+(m>2 and -3 or 9))+2)/5)+d-1-719468
return os.date("%b %d · %H:%M",days*86400+tonumber(h)*3600+tonumber(n)*60).." local"
end
local function alert_card_text(row)
local summary=row.ai.status=="complete" and type(row.ai.summary)=="string" and row.ai.summary or row.summary
local state=row.archived and "Cleared" or row.state=="resolved" and "Resolved"
or row.muted and "Muted" or row.acknowledged and "Acknowledged"
or row.severity=="info" and "Notice" or "Needs attention"
return label(row.title,120),label(summary,360),alert_local_time(row.last_seen_at).." · "..state
..(row.incident and " · "..tostring(row.incident.member_count).." related signals"
or row.occurrences>1 and " · "..tostring(row.occurrences).." occurrences" or "")
end
local function alert_accent(row)
if row.severity=="critical" then return "red" end
if row.severity=="warning" then return "amber" end
return (row.state=="resolved" or row.kind=="print_completed" or row.kind=="media_available") and "green" or "blue"
end
local function alert_slot(text,w,h,size,color,bold,paper,alignment)
local bg=paper and dashboard_color(paper,Blitbuffer.COLOR_WHITE) or Blitbuffer.COLOR_WHITE
local box=TextBoxWidget:new {text=text,width=w-24,height=h-8,
height_overflow_show_ellipsis=true,face=dashboard_face(size),bold=bold,
fgcolor=dashboard_color(color or "ink"),bgcolor=bg,alignment=alignment or "left"}
return FrameContainer:new {width=w,height=h,margin=0,padding=0,bordersize=0,background=bg,
CenterContainer:new {dimen=Geom:new {x=0,y=0,w=w,h=h},box}}
end
function Dashboard:alertRenderKey(context)
local values={}
local function add(value)
value=tostring(value or "")
values[#values+1]=tostring(#value)..":"..value
end
add(Screen:getWidth());add(Screen:getHeight())
add(self.alerts_filter or "Unread");add(self.alerts_offset or 0);add(context.history and "history" or "inbox")
local summary=self:alertSummary(context)
local generated=context.data and context.data.generated_at
if type(generated)=="string" then
local first,last=summary:find(generated,1,true)
if first then summary=summary:sub(1,first-1)..generated:sub(1,16)..summary:sub(last+1) end
end
add(summary);add(self:alertCoverage(context));add(self.alerts_badge_stale and "stale" or "fresh")
local provenance=self:getClientProvenance()
add(provenance.restart_required and provenance.installed_version or "")
local data=context.data
add(data and data.counts and data.counts.attention);add(data and data.quiet_hours and data.quiet_hours.active and "quiet" or "normal")
local rows=self:filteredAlerts(context)
add(#rows)
local offset=self.alerts_offset or 0
for index=offset+1,math.min(#rows,offset+(self.alerts_per_page or 4)) do
local row=rows[index]
local title,summary,meta=alert_card_text(row)
add(row.id);add(title);add(summary);add(meta);add(row.unread);add(row.severity);add(row.section);add(row.kind)
end
return table.concat(values)
end
function Dashboard:renderAlerts(context, health_fresh)
self.alerts_context=context or self.alerts_context or {fetched_at=os.time()}
context=self.alerts_context
local width,height=Screen:getWidth(),Screen:getHeight()
local scale=math.min(1,width/1264)
local function px(n) return math.max(1,math.floor(n*scale)) end
local function slot(text,w,h,size,color,bold,paper,alignment)
return alert_slot(text,w,h,math.max(12,px(size)),color,bold,paper,alignment)
end
local alert_banner=context.failure and (context.history
and (context.data and "SAVED HISTORY · refresh failed" or "HISTORY UNAVAILABLE")
or (context.data and "SAVED ALERTS · refresh failed" or "INBOX UNAVAILABLE")) or nil
if alert_banner and context.data and context.fetched_at then
alert_banner=alert_banner.." · received "..os.date("%Y-%m-%d %H:%M:%S %Z",context.fetched_at)
end
local header,header_height=self:makeTabHeader(alert_banner)
local rows=VerticalGroup:new {header}
local data=context.data
local unread=data and data.counts and data.counts.unread or 0
local quiet_state=data and data.quiet_hours
local top=VerticalGroup:new {}
local title_width=math.floor(width*.73)
top[#top+1]=HorizontalGroup:new {allow_mirroring=false,
slot(context.history and "ALERT HISTORY" or "ALERT INBOX",title_width,px(66),32,"white",true,"magenta"),
slot(tostring(unread).." UNREAD",width-title_width,px(66),24,"ink",true,"magenta","center")}
local alerts=self:filteredAlerts(context)
top[#top+1]=slot((self.alerts_filter or "Unread").." · "..tostring(#alerts)
..(#alerts==1 and " alert" or " alerts").."   /   "
..(quiet_state and quiet_state.active and "Quiet hours on" or "Quiet hours off"),width,px(48),24,"ink",true)
local summary=data and ((context.failure or os.time()-context.fetched_at>180) and "Saved view" or "Checked")
.." · "..alert_local_time(data.generated_at) or "No alerts snapshot yet"
if context.failure then summary=summary.."\n"..label(context.failure,120) end
top[#top+1]=slot(summary,width,px(context.failure and 76 or 42),20)
local coverage=self:alertCoverage(context)
local provenance=self:getClientProvenance()
if provenance.restart_required then coverage=(coverage and coverage.." · " or "")
.."Reopen KOReader to load "..provenance.installed_version end
if coverage then top[#top+1]=slot(coverage,width,px(66),20,"ink",true,"amber_paper") end
rows[#rows+1]=top
local top_height=top:getSize().h
local footer_height=px(112)
local gap=px(14)
local available=height-header_height-top_height-footer_height
local per_page=math.max(1,math.min(4,math.floor((available+gap)/px(244))))
local card_height=math.floor((available-gap*(per_page-1))/per_page)
local offset=math.min(self.alerts_offset or 0,math.max(0,math.floor((#alerts-1)/per_page)*per_page))
self.alerts_offset=offset;self.alerts_per_page=per_page;self.alerts_rects={}
local y=header_height+top_height
local function space(h)
return WidgetContainer:new {dimen=Geom:new {x=0,y=0,w=width,h=h}}
end
for index=offset+1,math.min(#alerts,offset+per_page) do
local row=alerts[index]
local title,summary,meta=alert_card_text(row)
local accent=alert_accent(row)
local card=VerticalGroup:new {}
local card_width=width-px(32)-2
local badge_width=math.floor(card_width*.78)
local state=row.unread and "NEW" or "READ"
local kind=row.kind=="print_completed" and "Complete" or row.kind=="media_available" and "Available" or severities[row.severity]
card[#card+1]=HorizontalGroup:new {allow_mirroring=false,
slot(string.upper(sections[row.section].." · "..kind),badge_width,px(40),20,"ink",true,accent),
slot(state,card_width-badge_width,px(40),20,"ink",true,accent,"right")}
card[#card+1]=slot(title,card_width,px(74),30,"ink",true)
card[#card+1]=slot(summary,card_width,card_height-px(154)-2,26)
card[#card+1]=slot(meta,card_width,px(40),21,"ink",false)
local frame=FrameContainer:new {width=card_width+2,height=card_height,margin=0,padding=0,bordersize=1,
color=dashboard_color(accent),
background=Blitbuffer.COLOR_WHITE,card}
local card_slot=CenterContainer:new {dimen=Geom:new {x=0,y=0,w=width,h=frame:getSize().h},frame}
rows[#rows+1]=card_slot
local measured=card_slot:getSize().h
self.alerts_rects[#self.alerts_rects+1]={y=y,h=measured,row=row}
y=y+measured
if index<math.min(#alerts,offset+per_page) then rows[#rows+1]=space(gap);y=y+gap end
end
local remaining=height-footer_height-y
if remaining>0 then
local hint=#alerts==0 and (context.data and "No alerts in this filter.\nChoose All, history or refresh below."
or "Waiting for the alert inbox.\nUse Filters & actions to refresh.")
or #alerts-offset<=per_page and "End of this page.\nTap an alert for its full report and actions." or ""
rows[#rows+1]=remaining>=px(100) and slot(hint,width,remaining,24,"ink",false,nil,"center") or space(remaining)
y=y+remaining
end
self.alerts_footer_y=y
rows[#rows+1]=slot("Filters & actions   ·   Page "..tostring(math.floor(offset/per_page)+1)
.." / "..tostring(math.max(1,math.ceil(#alerts/per_page))),width,px(56),24,"ink",true,"cyan","center")
rows[#rows+1]=slot(quiet_state and quiet_state.active and "Quiet hours on · alerts are still stored"
or "Tap a card for its report, evidence & actions",width,px(40),20,"ink",false,nil,"center")
rows[#rows+1]=space(footer_height-px(96))
local surface=FrameContainer:new {width=width,height=height,margin=0,padding=0,bordersize=0,
background=Blitbuffer.COLOR_WHITE,rows}
self.image_rect=nil;self.alerts_render_key=self:alertRenderKey(context)
if self:replaceView(surface,"alerts","ui") then self:noteAlertHealth(context, health_fresh) end
end
function Dashboard:pollAlerts()
if not self.running or self.suspended or self.active_tab~=6 then return end
self:cancelPoll()
local started_at=os.time()
local disconnected=not NetworkMgr:isConnected()
local context=self:getAlertView()
if not self.running or self.suspended or self.active_tab~=6 then return end
if self.view_kind=="alerts" and self.alerts_render_key==self:alertRenderKey(context) then
self.alerts_context=context
local rows=self:filteredAlerts(context)
for index,rect in ipairs(self.alerts_rects or {}) do
rect.row=rows[(self.alerts_offset or 0)+index]
end
self:noteAlertHealth(context, true)
else self:renderAlerts(context, true) end
if context.failure then
self:noteHealthFailure()
self.failure_count=(self.failure_count or 0)+1
self:schedulePoll(disconnected and self:retryPollDelay(true) or 15)
else
self.failure_count=0
self:schedulePoll(math.max(1,12-(os.time()-started_at)))
end
end
function Dashboard:showAlertAt(pos)
for _,rect in ipairs(self.alerts_rects or {}) do
if pos.y>=rect.y and pos.y<rect.y+rect.h then self:showAlertDetail(rect.row);return end
end
self:showAlertsMenu()
end
function Dashboard:showAlertText(title, lines)
if self.alerts_view then UIManager:close(self.alerts_view) end
local viewer=TextViewer:new {title=title,text=table.concat(lines,"\n"),height=math.floor(Screen:getHeight()*.9)}
local original=viewer.onCloseWidget
viewer.onCloseWidget=function(widget)
if self.alerts_view==widget then self.alerts_view=nil;self.quick_menu_count=math.max(0,(self.quick_menu_count or 1)-1) end
if original then original(widget) end
end
self.alerts_view=viewer;self.quick_menu_count=(self.quick_menu_count or 0)+1;UIManager:show(viewer)
end
function Dashboard:showAlertExplanation(row,detail_fresh)
local lines={row.title,severities[row.severity].." · "..sections[row.section].." · "..row.state,
row.archived and "Cleared from the inbox · retained in history; this does not establish recovery" or "",
"First observed: "..insight_time(row.occurred_at),"Last observed: "..insight_time(row.last_seen_at),
(row.incident and "Signals in incident: " or "Occurrences grouped: ")..tostring(row.incident and row.incident.member_count or row.occurrences),"",
detail_fresh==false and "Detail refresh unavailable. This is the last validated observation, not a current health check." or "",
"OBSERVED SUMMARY",row.summary,"","Observed evidence"}
for _,item in ipairs(row.evidence or {}) do lines[#lines+1]=item.label..": "..item.value end
if not row.evidence then lines[#lines+1]="Detailed evidence unavailable; showing the last list observation." end
for _,check in ipairs(row.checks or {}) do lines[#lines+1]="Check: "..check end
if clarification_valid(row.clarification) then
lines[#lines+1]="\nOBSERVATION CLARIFICATION · DETERMINISTIC POLICY REVIEW"
lines[#lines+1]="Clarified at: "..insight_time(row.clarification.at)
lines[#lines+1]=row.clarification.summary
end
if row.state=="resolved" then lines[#lines+1]="Original incident is closed. Inspect the observed evidence and current status; closure alone does not establish physical recovery. Any AI analysis explains the initial incident, not the current health check." end
local disabled=row.ai.status=="disabled"
lines[#lines+1]=disabled and "\nOBSERVATION ONLY · AI analysis is disabled"
or ("\nAI analysis of the original alert · "..ai_states[row.ai.status].." · confidence "..row.ai.confidence)
if not disabled then lines[#lines+1]="Analysis time: "..insight_time(row.ai.analyzed_at) end
local report=not disabled and row.ai.report or nil
if report_valid(report) then
lines[#lines+1]="\nWHAT HAPPENED";lines[#lines+1]=report.what_happened
lines[#lines+1]="\nIMPACT";lines[#lines+1]=report.impact
lines[#lines+1]="\nFACTS AND THEIR SOURCE"
local basis={initial_event="Original event",initial_diagnostics="Original diagnostics",current_followup="Current follow-up"}
for _,fact in ipairs(report.facts) do lines[#lines+1]=basis[fact.basis]..": "..fact.detail end
lines[#lines+1]="\nPOSSIBLE CAUSES · AI INFERENCE"
for index,cause in ipairs(report.likely_causes) do
lines[#lines+1]=tostring(index)..". "..cause.cause.." ("..cause.confidence.." confidence)"
lines[#lines+1]="Supporting evidence: "..cause.support
end
lines[#lines+1]="\nINVESTIGATE IN ORDER"
for index,step in ipairs(report.investigation) do
lines[#lines+1]=tostring(index)..". Open "..step.location..": "..step.check
lines[#lines+1]="Expected result: "..step.expected
end
lines[#lines+1]="\nRECOVERY OPTIONS · REVIEW BEFORE ACTING"
for index,step in ipairs(report.recovery) do
lines[#lines+1]=tostring(index)..". "..step.action
lines[#lines+1]="Prerequisite: "..step.prerequisite
lines[#lines+1]="Caution: "..step.caution
end
lines[#lines+1]="\nVERIFY THE RESULT"
for index,step in ipairs(report.verification) do
lines[#lines+1]=tostring(index)..". "..step.check
lines[#lines+1]="Expected result: "..step.expected
end
lines[#lines+1]="\nWHAT IS STILL UNKNOWN"
for _,unknown in ipairs(report.unknowns) do lines[#lines+1]="• "..unknown end
lines[#lines+1]="\nWHEN TO ESCALATE";lines[#lines+1]=report.escalation
else
if report~=nil and not json_is_null(report) then
lines[#lines+1]="The extended AI report could not be validated. The saved summary and observed evidence remain available."
end
if disabled then
lines[#lines+1]="Use the observed summary, evidence and current service status above. This observation is not an AI diagnosis."
else
if type(row.ai.summary)=="string" then lines[#lines+1]=row.ai.summary end
if type(row.ai.likely_cause)=="string" and #row.ai.likely_cause>0 then lines[#lines+1]="Possible cause (AI): "..row.ai.likely_cause end
for _,check in ipairs(row.ai.suggested_checks) do lines[#lines+1]="AI suggestion: "..check end
if row.ai.status~="complete" then lines[#lines+1]="AI analysis is "..ai_states[row.ai.status]..". Investigate the observed evidence above; a missing analysis does not mean the problem is resolved." end
end
end
local history=row.ai_history
if array(history,2,function(v) return exact(v,{status=true,summary=true,confidence=true,analyzed_at=true,has_report=true})
and v.status=="complete" and text(v.summary,1200) and timestamp(v.analyzed_at,true)
and ({low=true,medium=true,high=true,unknown=true})[v.confidence] and type(v.has_report)=="boolean" end) then
lines[#lines+1]="\nPREVIOUS ANALYSES · HISTORICAL CONTEXT"
for index,entry in ipairs(history) do lines[#lines+1]=tostring(index)..". "..insight_time(entry.analyzed_at)
.." · "..entry.confidence.." confidence\n"..entry.summary end
end
lines[#lines+1]="\nAI text is advice, not a verified root cause. It cannot run commands or change services."
self:showAlertText("Full alert report · scroll to read all sections",lines)
end
function Dashboard:openAlertTarget(action,row)
if action=="open_printer" then
local items=self:buildPrinterMenu()
for _,item in ipairs(items) do
if item.printer and item.printer.id==row.target.entity_id then self:showQuickMenu(item.text,item.sub_item_table);return end
end
self:showQuickMenu("Printers",items)
elseif action=="open_media" then self:showMediaInsights("acquisition")
elseif action=="open_storage" then self:showMediaInsights("storage")
elseif action=="open_services" then
self:showQuickMenu("Investigate service health",{
{text="Media storage and service health",close_on_select=true,callback=function()
local state=self:getPlexStatus()
if state then self:showPlexHealth(state) else self:showPlexMenu() end
end},
{text="Media pipeline readiness",close_on_select=true,callback=function()
local state=self:getPlexStatus()
if state then self:showPlexPipeline(state) else self:showPlexMenu() end
end},
{text="LLM service status",close_on_select=true,callback=function() self:showStatusMenu("llm") end},
{text="Site service status",close_on_select=true,callback=function() self:showStatusMenu("site") end},
{text="Media recovery and restart controls",close_on_select=true,callback=function() self:showPlexMaintenance() end},
})
elseif action=="open_subtitles" then self:showWindowsStatus() end
end
function Dashboard:showIncidentMembers(row,offset)
local members=row.incident.members;offset=offset or 0;local items={}
for index=offset+1,math.min(#members,offset+4) do
local member=members[index]
items[#items+1]={text=label(member.title,80).."\n"..sections[member.section].." · "..severities[member.severity].." · "..member.state,
callback=function()
local body,code=self:requestRemote("/api/v1/alerts/"..member.id,"GET",self.settings.token_file,nil,"application/json",MAX_JSON_BYTES,nil,true)
local v=body and code==200 and decode_json(body)
if type(v)=="table" and v.schema_version==1 and row_valid(v.alert,true) and v.alert.id==member.id then
self:showAlertExplanation(v.alert,true)
else self:showAlertText(member.title,{"Detail refresh unavailable. Saved related observation:",sections[member.section].." · "..severities[member.severity].." · "..member.state,"This is not a current health check."}) end
end}
end
if offset>0 then items[#items+1]={text="Previous signals",close_on_select=true,callback=function() self:showIncidentMembers(row,offset-4) end} end
if offset+4<#members then items[#items+1]={text="More signals",close_on_select=true,callback=function() self:showIncidentMembers(row,offset+4) end} end
self:showQuickMenu("Related signals · "..tostring(#members),items)
end
function Dashboard:showAlertDetail(previous)
local body,code=self:requestRemote("/api/v1/alerts/"..previous.id,"GET",self.settings.token_file,nil,"application/json",MAX_JSON_BYTES,nil,true)
local value=body and code==200 and decode_json(body) or nil
local row=type(value)=="table" and value.schema_version==1 and row_valid(value.alert,true)
and value.alert.id==previous.id and value.alert or previous
local options=incident_options(row)
local items={
{text=label(row.title,85),enabled_func=function() return false end},
{text=row.ai.status=="disabled" and "Read explanation and observation clarification" or "Read explanation and full AI report",
callback=function() self:showAlertExplanation(row,row~=previous) end},
{text=row.incident and (row.unread and "Mark incident read" or "Mark incident unread") or (row.unread and "Mark as read" or "Mark unread"),close_on_select=true,
callback=function() self:sendAlertAction(row.unread and "mark_read" or "mark_unread",row.id,options) end},
{text=row.acknowledged and "Acknowledged" or (row.incident and "Acknowledge incident · keep history" or "Acknowledge · keep the alert in history"),enabled_func=function() return not row.acknowledged end,
close_on_select=true,callback=function() self:sendAlertAction("acknowledge",row.id,options) end},
{text="Snooze / mute / explanation",close_on_select=true,callback=function() self:showAlertOptions(row) end},
}
if row.incident then items[#items+1]={text="Related signals · "..tostring(row.incident.member_count-1),
enabled_func=function() return row.incident.members~=nil end,callback=function() self:showIncidentMembers(row) end} end
local titles={open_printer="Printer controls / camera / Print Doctor",open_media="Downloads and request progress",
open_storage="SSD health and missing drives",open_services="Service and pipeline health",open_subtitles="Subtitle jobs and GPU"}
for _,action in ipairs(row.actions) do
local selected=action
items[#items+1]={text="Investigate · "..titles[selected],close_on_select=true,callback=function() self:openAlertTarget(selected,row) end}
end
if row==previous then table.insert(items,2,{text="Detail refresh unavailable · last observed list item",enabled_func=function() return false end}) end
self:showQuickMenu("Alert · "..severities[row.severity],items)
end
function Dashboard:showAlertOptions(row)
local items={}
local scope=row.incident and "incident" or "alert"
for _,minutes in ipairs({15,60,240,1440}) do
local selected=minutes
items[#items+1]={text=(row.incident and "Snooze incident for " or "Snooze for ")..insight_duration(minutes*60),close_on_select=true,
callback=function() self:sendAlertAction("snooze",row.id,incident_options(row,selected)) end}
end
items[#items+1]={text=row.muted and ("Unmute this "..scope) or ("Mute this "..scope),close_on_select=true,
callback=function() self:sendAlertAction(row.muted and "unmute" or "mute",row.id,incident_options(row)) end}
if row.ai and row.ai.status~="disabled" then
items[#items+1]={text=row.incident and "Retry primary observation AI (daily limit)" or "Retry AI explanation (within the daily limit)",close_on_select=true,
callback=function() self:sendAlertAction("retry_ai",row.id) end}
end
self:showQuickMenu("Alert delivery and explanation",items)
end
function Dashboard:confirmClearAlerts()
if self.settings.alert_action_receipt then
self:notice("Recover the saved alert action first. No alerts were cleared.",8);return
end
local context=self:getAlerts()
if context.failure or not context.data then
self:notice("Refresh the inbox successfully before clearing alerts. Nothing was sent.",8);return
end
local cutoff=context.data.archive_cutoff
if not uuid(cutoff) then
self:notice("Clear-all is not enabled on the server yet. Alerts remain available; nothing was sent.",8);return
end
if context.data.counts.total==0 then self:notice("The inbox is already clear. History is retained.",6);return end
local count=context.data.counts.total
UIManager:show(ConfirmBox:new {
text="Clear "..tostring(count).." existing inbox alerts?\n\nThey will be archived in History, not deleted or marked recovered. New incidents and later escalations after this snapshot stay in the inbox.\n\nThis sends no printer, media or service command.",
ok_text="Clear inbox · keep history",flush_events_on_show=true,
ok_callback=function() self:sendAlertAction("archive_all",nil,{cutoff=cutoff}) end,
})
end
function Dashboard:showAlertsMenu()
local context=self.alerts_context or {fetched_at=os.time()}
local q=context.data and context.data.quiet_hours
local items={
{text=context.history and "Refresh history" or "Refresh inbox",close_on_select=true,callback=function() self:renderAlerts(self:getAlertView(), true) end},
{text="Filter · "..(self.alerts_filter or "Unread"),close_on_select=true,sub_item_table={}},
{text="Quiet hours · "..(q and q.enabled and (tostring(q.start_hour)..":00–"..tostring(q.end_hour)..":00") or "Off / unknown"),close_on_select=true,
callback=function() self:showAlertQuietHours(q) end},
{text="Sources and delivery status",callback=function() self:showAlertSources(context) end},
{text="Mark all inbox alerts read",close_on_select=true,callback=function() self:sendAlertAction("mark_all_read") end},
}
if context.history then
items[#items+1]={text="Back to current inbox",close_on_select=true,callback=function() self:showAlertInbox() end}
else
items[#items+1]={text="Clear all inbox alerts · keep history",close_on_select=true,callback=function() self:confirmClearAlerts() end}
items[#items+1]={text="History · including cleared alerts",close_on_select=true,callback=function() self:showAlertHistory() end}
end
for _,name in ipairs(filters) do
local selected=name
items[2].sub_item_table[#items[2].sub_item_table+1]={text=name,close_on_select=true,callback=function()
self.alerts_filter=selected;self.alerts_offset=0;self:renderAlerts(context) end}
end
local count=#self:filteredAlerts(context)
local per_page=self.alerts_per_page or 4
if (self.alerts_offset or 0)>0 then items[#items+1]={text="Previous alerts",close_on_select=true,callback=function()
self.alerts_offset=math.max(0,self.alerts_offset-per_page);self:renderAlerts(context) end} end
if (self.alerts_offset or 0)+per_page<count then items[#items+1]={text="Next alerts",close_on_select=true,callback=function()
self.alerts_offset=(self.alerts_offset or 0)+per_page;self:renderAlerts(context) end} end
if self.settings.alert_action_receipt then items[#items+1]={text="Saved alert action · inspect / recover",close_on_select=true,
callback=function() self:showSavedAlertAction() end} end
self:showQuickMenu(context.history and "Alert history" or "Alerts inbox",items)
end
function Dashboard:showAlertSources(context)
local provenance = self:getClientProvenance()
local lines={self:alertSummary(context),"Running client: " .. provenance.running_version,
"Installed files: " .. (provenance.installed_version or "Could not read version"),
provenance.restart_required and "Restart KOReader to load the installed files."
or (provenance.installed_version and "Running the installed client." or "Installed version could not be verified."),
"Runtime loaded " .. insight_duration(math.max(0,os.time()-provenance.loaded_at)) .. " ago.",
self:alertCoverage(context) or (context.data and "Source coverage has no reported degradation." or "Source coverage unavailable; inbox not received."),
"Quiet hours use __INKBOARD_TIMEZONE__, including daylight saving time.",
"Quiet hours suppress delivery, not recording. Duplicate observations update one alert group.",
"Alert explanations are advice. This inbox does not execute recovery advice or automatically control devices.",
"Clear-all archives only the confirmed inbox snapshot. It does not prove recovery or erase history.",""}
for _,source in ipairs(context.data and context.data.source_status or {}) do
lines[#lines+1]=label(source.id,80)..": "..source.state.." · age "..insight_duration(source.age_seconds)
end
if not context.data then lines[#lines+1]="No source report received yet." end
self:showAlertText("Alert sources and delivery",lines)
end
function Dashboard:showAlertQuietHours(q)
q=q or {enabled=false,start_hour=22,end_hour=8,timezone="__INKBOARD_TIMEZONE__"}
local function set(enabled,start_hour,end_hour)
self:sendAlertAction("set_quiet_hours",nil,{quiet_hours={enabled=enabled,start_hour=start_hour,end_hour=end_hour,timezone="__INKBOARD_TIMEZONE__"}})
end
self:showQuickMenu("Quiet hours · __INKBOARD_TIMEZONE__",{
{text="Off · record and deliver at all hours",close_on_select=true,callback=function() set(false,q.start_hour,q.end_hour) end},
{text="22:00–08:00",close_on_select=true,callback=function() set(true,22,8) end},
{text="23:00–07:00",close_on_select=true,callback=function() set(true,23,7) end},
{text="Choose hours",close_on_select=true,callback=function()
local dialog
dialog=MultiInputDialog:new {title="Quiet hours · __INKBOARD_TIMEZONE__",
fields={{text=tostring(q.start_hour),hint="Start hour (0–23)",input_type="number"},
{text=tostring(q.end_hour),hint="End hour (0–23)",input_type="number"}},
buttons={{{text="Cancel",callback=function() UIManager:close(dialog) end},
{text="Save",callback=function()
local f=dialog:getFields();local first,last=tonumber(f[1]),tonumber(f[2])
if not quiet({enabled=true,start_hour=first,end_hour=last,timezone="__INKBOARD_TIMEZONE__"}) then
self:notice("Choose two different whole hours from 0 to 23.",7);return end
UIManager:close(dialog);set(true,first,last)
end}}}}
local original=dialog.onCloseWidget
dialog.onCloseWidget=function(widget)
if self.alerts_quiet_dialog==widget then
self.alerts_quiet_dialog=nil;self.quick_menu_count=math.max(0,(self.quick_menu_count or 1)-1)
end
if original then original(widget) end
end
self.alerts_quiet_dialog=dialog
self.quick_menu_count=(self.quick_menu_count or 0)+1
UIManager:show(dialog)
end},
})
end
function Dashboard:clearAlertReceipt()
local previous=self.settings.alert_action_receipt
self.settings.alert_action_receipt=nil
local ok,result=pcall(function() return self:saveSettings() end)
if not ok or result==false then self.settings.alert_action_receipt=previous;return false end
return true
end
function Dashboard:applyAlertReceipt(value,pending)
if type(value)~="table" or value.schema_version~=1 or value.request_id~=pending.payload.request_id
or value.action~=pending.payload.action or value.status~="applied"
or not uuid(value.receipt_id)
or pending.payload.alert_id~=nil and value.alert_id~=pending.payload.alert_id
or pending.payload.alert_id==nil and not json_is_null(value.alert_id) then return false end
if pending.payload.action=="archive_all" and (value.cutoff~=pending.payload.cutoff
or not insight_number(value.archived_count,1000000000) or value.archived_count%1~=0) then return false end
if pending.payload.incident_cutoff and (value.incident_cutoff~=pending.payload.incident_cutoff
or not insight_number(value.affected_count,60) or value.affected_count%1~=0) then return false end
if not self:clearAlertReceipt() then self:notice("Alert updated; local receipt cleanup will retry.",7);return true end
self:notice(pending.payload.action=="archive_all" and (tostring(value.archived_count).." alerts cleared. They remain in History.") or pending.payload.incident_cutoff and (value.affected_count==0 and "No displayed signals changed. Refresh this incident."
or tostring(value.affected_count).." displayed signals updated. Newer alerts were kept.") or "Alert inbox updated.",4)
if pending.payload.action=="archive_all" then self.alerts_mode="inbox";self.alerts_filter="Unread";self.alerts_offset=0 end
self.alerts_context=self:getAlerts()
if self.alerts_mode=="history" then self.alerts_context=self:getAlertHistory() end
if self.running and self.active_tab==6 then self:renderAlerts(self.alerts_context, true) end
return true
end
function Dashboard:recoverAlertAction()
local pending=self.settings.alert_action_receipt
if type(pending)~="table" or not self:validAlertAction(pending.payload) then
self:notice("Saved alert receipt needs storage recovery. No action sent.",8);return end
local id=pending.payload.request_id
local body,code=self:requestRemote("/api/v1/alerts/actions/"..id,"GET",self.settings.control_token_file,nil,"application/json",16384,nil,true)
if body and code==200 and self:applyAlertReceipt(decode_json(body),pending) then return end
if code~=404 then self:notice("Alert receipt unavailable. It remains saved; other dashboard controls still work.",8);return end
local started=insight_number(pending.started_at,32503680000)
local age=started and os.time()-started
if not age or age < -300 or age > 7*86400 then
self:notice("This saved action is too old or its clock is uncertain. An absent server receipt may have expired. Inspect it before forgetting; nothing was resent.",10)
return
end
self:postAlertReceipt(pending)
end
function Dashboard:showSavedAlertAction()
local pending=self.settings.alert_action_receipt
if type(pending)~="table" or not self:validAlertAction(pending.payload) then
self:notice("Saved alert receipt needs storage recovery. Nothing was sent.",8);return
end
self:showQuickMenu("Saved alert action",{
{text="Check the same server receipt",close_on_select=true,callback=function() self:recoverAlertAction() end},
{text="Inspect saved receipt",callback=function()
self:showAlertText("Saved alert action",{
"Action: "..pending.payload.action,"Request ID: "..pending.payload.request_id,
pending.payload.action=="archive_all" and ("Confirmed snapshot: "..pending.payload.cutoff) or "",
"Saved device time: "..tostring(pending.started_at),"",
"A server receipt confirms the result. An absent receipt permits the exact same request only for seven days with a plausible device clock.",
"Older server receipts may have expired. Inspect the inbox and quiet-hour settings before forgetting the local receipt.",
"Forgetting does not cancel or undo a server action. No printer or media operation is part of this receipt."})
end},
{text="Forget local receipt after reviewing inbox",close_on_select=true,callback=function()
UIManager:show(ConfirmBox:new {
text="Have you checked the inbox and quiet-hour settings for this saved "..pending.payload.action.." action?\n\nForgetting clears this Kindle's receipt only. It does not prove failure, cancel or undo a server action. Nothing will be resent.",
ok_text="I checked · forget local receipt",flush_events_on_show=true,ok_callback=function()
if self.settings.alert_action_receipt~=pending then return end
if self:clearAlertReceipt() then self:notice("Local alert receipt forgotten after your review. Nothing was resent.",7)
else self:notice("The local receipt could not be cleared. It remains saved.",7) end
end,
})
end},
})
end
function Dashboard:postAlertReceipt(pending)
local body,code=self:requestRemote("/api/v1/alerts/actions","POST",self.settings.control_token_file,
require("json").encode(pending.payload),"application/json",16384,nil,true)
if body and code==200 and self:applyAlertReceipt(decode_json(body),pending) then return end
self:notice(code==400 and pending.payload.action=="archive_all" and "The server rejected this clear-all snapshot. The saved receipt remains for inspection; no new snapshot or action was substituted."
or code==409 and "Alert action conflicts with a stored receipt; retained for investigation."
or "Alert action receipt is saved. Recover it from the inbox menu; no duplicate action will be created.",8)
end
function Dashboard:sendAlertAction(action,id,options)
if self.settings.alert_action_receipt then self:notice("Recover the saved alert action first. Printer and media controls remain available.",8);return end
local payload={request_id=require("random").uuid(true):lower(),action=action,alert_id=id}
for key,value in pairs(options or {}) do payload[key]=value end
if not self:validAlertAction(payload) then self:notice("Invalid alert action. Nothing sent.",6);return end
local pending={schema=1,payload=payload,started_at=os.time()}
self.settings.alert_action_receipt=pending
local ok,result=pcall(function() return self:saveSettings() end)
if not ok or result==false then self.settings.alert_action_receipt=nil;self:notice("Could not save the alert receipt. Nothing sent.",8);return end
self:postAlertReceipt(pending)
end
end
function Dashboard:restoreOptionalEbookReceipt()
local saved = self.settings.optional_ebook_receipt
if type(saved) == "table" and type(saved.id) == "string" and #saved.id == 36
and saved.id:match("^[0-9a-f%-]+$")
and type(saved.started_at) == "number"
and (saved.kind == "ebook_health" or (saved.kind == "command"
and (saved.operation == "start" or saved.operation == "stop"))) then
self.active_ebook_job = saved
else
self.settings.optional_ebook_receipt = nil
end
end
function Dashboard:optionalEbookHealthText(health)
if type(health) ~= "table" then return "Not checked" end
local label = ({ healthy = "HEALTHY", stopped = "STOPPED",
degraded = "NEEDS ATTENTION", unavailable = "UNAVAILABLE" })[health.state] or "UNKNOWN"
if health.state ~= "unavailable" and type(health.running_containers) == "number" then
label = label .. " · " .. tostring(health.running_containers) .. "/5 running"
end
return label
end
function Dashboard:showOptionalEbooks()
local observation = self.last_ebook_health
local health = observation and observation.health
local fresh = observation and type(observation.observed_at) == "number"
and os.time() - observation.observed_at >= 0
and os.time() - observation.observed_at <= 120
local busy = self.active_ebook_job ~= nil
local uncertain = self.settings.optional_ebook_uncertain ~= nil
local items = {
{ text = "Optional ebooks: " .. self:optionalEbookHealthText(health),
enabled_func = function() return false end },
{ text = "Plex continues independently when ebooks are off.",
enabled_func = function() return false end },
}
if self.last_ebook_result then
local evidence = self.last_ebook_result.optional_ebooks or {}
items[#items + 1] = { text = "Before: " .. self:optionalEbookHealthText(evidence.before),
enabled_func = function() return false end }
items[#items + 1] = { text = "After: " .. self:optionalEbookHealthText(evidence.after),
enabled_func = function() return false end }
items[#items + 1] = { text = "Last action: " .. safe_label(self.last_ebook_result.state, 24)
.. " · " .. safe_label(self.last_ebook_result.detail, 80),
enabled_func = function() return false end }
end
if uncertain then
items[#items + 1] = { text = "Previous action uncertain; verify Stop before starting.",
enabled_func = function() return false end }
end
if busy then
items[#items + 1] = { text = self.active_ebook_job.kind == "ebook_health"
and "Checking ebook health…" or "Ebook action in progress; receipt saved",
enabled_func = function() return false end }
items[#items + 1] = { text = "Check the saved receipt", close_on_select = true,
callback = function() self:pollOptionalEbooks() end }
end
items[#items + 1] = { text = "Check health", close_on_select = true,
enabled_func = function() return not busy end,
callback = function() self:submitOptionalEbookJob("ebook_health") end }
items[#items + 1] = { text = "Start ebooks", close_on_select = true,
enabled_func = function() return not busy and not uncertain and fresh and health.state ~= "unavailable"
and health.state ~= "healthy" end,
callback = function() self:confirmOptionalEbookOperation("start") end }
items[#items + 1] = { text = "Stop ebooks", close_on_select = true,
enabled_func = function() return not busy and fresh end,
callback = function() self:confirmOptionalEbookOperation("stop") end }
self:showQuickMenu("Optional ebooks", items)
end
function Dashboard:confirmOptionalEbookOperation(operation)
local observation = self.last_ebook_health
if (operation ~= "start" and operation ~= "stop") or not observation
or type(observation.id) ~= "string" or os.time() - observation.observed_at > 120
or self.active_ebook_job or (operation == "start" and self.settings.optional_ebook_uncertain) then
self:notice("Check ebook health before changing it.", 7)
return
end
local verb = operation == "start" and "Start" or "Stop"
local health_id = observation.id
UIManager:show(ConfirmBox:new {
text = verb .. " optional ebooks?\nBefore: " .. self:optionalEbookHealthText(observation.health)
.. "\nThe desktop ebook command checks health again before and after."
.. " Plex continues independently. Starting can take several minutes.",
ok_text = verb .. " ebooks", flush_events_on_show = true,
ok_callback = function()
if not self.last_ebook_health or self.last_ebook_health.id ~= health_id
or os.time() - self.last_ebook_health.observed_at > 120 then
self:notice("Ebook health changed or expired. Check health again.", 8)
return
end
self:submitOptionalEbookJob("command", operation, health_id)
end,
})
end
function Dashboard:submitOptionalEbookJob(kind, operation, health_id)
if self.active_ebook_job then self:notice("Wait for the saved ebook receipt.", 7); return end
if kind ~= "ebook_health" and (kind ~= "command" or
(operation ~= "start" and operation ~= "stop") or type(health_id) ~= "string") then return end
if operation == "start" and self.settings.optional_ebook_uncertain then
self:notice("Verify an explicit ebook Stop before starting again.", 8); return
end
if not NetworkMgr:isConnected() then self:notice("Wi-Fi is disconnected. No ebook action was sent.", 7); return end
local _, token_error = read_bearer_token(self.settings.control_token_file)
if token_error then self:notice("Control token unavailable: " .. token_error, 7); return end
local id = require("random").uuid(true):lower()
local payload = { request_id = id }
local path = "/api/v1/plex/ebooks/health"
if kind == "command" then
path = "/api/v1/plex/commands"
payload.action, payload.operation, payload.health_request_id = "ebook_stack", operation, health_id
payload.confirm = operation == "start" and "START_EBOOKS" or "STOP_EBOOKS"
end
local receipt = { id = id, kind = kind, operation = operation, started_at = os.time() }
self.settings.optional_ebook_receipt = receipt
self:saveSettings()
self.active_ebook_job = receipt
local _, code = self:requestRemote(path, "POST", self.settings.control_token_file,
require("json").encode(payload), "application/json", MAX_JSON_BYTES)
if code == 400 or code == 409 then
self.active_ebook_job, self.settings.optional_ebook_receipt = nil, nil
self:saveSettings()
self:notice("Ebook request was not queued. Check health and the saved action history.", 8)
return
end
self:notice("Ebook receipt saved. Checking the same request without resending it.", 7)
UIManager:unschedule(self.ebook_poll_task)
UIManager:scheduleIn(2, self.ebook_poll_task)
end
function Dashboard:pollOptionalEbooks()
local pending = self.active_ebook_job
if not pending or not self.running or self.suspended then return end
local prefix = pending.kind == "ebook_health" and "/api/v1/plex/ebooks/health/"
or "/api/v1/plex/commands/"
local body, code = self:requestRemote(prefix .. pending.id, "GET",
self.settings.control_token_file, nil, "application/json", MAX_JSON_BYTES)
if body and code == 200 then
local result = decode_json(body)
if type(result) == "table" and result.id == pending.id and result.kind == pending.kind
and (pending.kind == "ebook_health" or (result.action == "ebook_stack"
and result.operation == pending.operation)) then
if result.state == "completed" or result.state == "accepted" or result.state == "rejected"
or result.state == "unknown" or result.state == "expired" then
self.active_ebook_job, self.settings.optional_ebook_receipt = nil, nil
self:saveSettings()
if pending.kind == "ebook_health" and result.state == "completed"
and type(result.optional_ebooks) == "table" then
self.last_ebook_health = { id = pending.id, health = result.optional_ebooks,
observed_at = result.health_stale == false and type(result.health_age_seconds) == "number"
and os.time() - result.health_age_seconds or 0 }
elseif pending.kind == "command" then
self.last_ebook_result = result
self.last_ebook_health = nil
if result.state == "unknown" then
self.settings.optional_ebook_uncertain = pending
elseif result.state == "accepted" and pending.operation == "stop"
and result.optional_ebooks and result.optional_ebooks.after
and result.optional_ebooks.after.state == "stopped" then
self.settings.optional_ebook_uncertain = nil
end
self:saveSettings()
self:notice("Ebook action: " .. safe_label(result.state, 24)
.. ". Before: " .. self:optionalEbookHealthText(result.optional_ebooks and result.optional_ebooks.before)
.. "; after: " .. self:optionalEbookHealthText(result.optional_ebooks and result.optional_ebooks.after), 12)
else
self:notice("Ebook health check: " .. safe_label(result.state, 24), 8)
end
self:showOptionalEbooks()
return
end
end
end
if code == 404 and os.time() - pending.started_at >= 30 then
if pending.kind == "command" then self.settings.optional_ebook_uncertain = pending end
self.active_ebook_job, self.settings.optional_ebook_receipt = nil, nil
self:saveSettings()
self:notice(pending.kind == "command"
and "Ebook receipt unavailable. Check health and verify Stop before starting again."
or "Ebook health receipt unavailable. You can check health again.", 10)
self:showOptionalEbooks()
return
end
UIManager:scheduleIn(10, self.ebook_poll_task)
end
function Dashboard:submitPlexCommand(action, details, label)
if self.plex_receipt_error then
self:notice("Saved Plex receipt needs storage recovery. No action was sent.", 9)
return
end
if self.active_plex_command then
self:notice("Wait for the previous Plex action result.", 7)
return
end
if not NetworkMgr:isConnected() then
self:notice("Wi-Fi is disconnected. No Plex action was sent.", 7)
return
end
local _, token_error = read_bearer_token(self.settings.control_token_file)
if token_error then
self:notice("Plex control token unavailable: " .. token_error, 7)
return
end
local id = require("random").uuid(true):lower()
local confirmations = {
approve = "APPROVE", scan = "SCAN", request = "REQUEST",
restart_service = "RESTART",
refresh_metadata = "REFRESH_METADATA",
flush_seerr_cache = "FLUSH_CACHE",
delete_media = "DELETE_MEDIA",
terminate_stream = "TERMINATE_STREAM",
}
if not confirmations[action] then
self:notice("Unsupported Plex action.", 7)
return
end
local payload = { request_id = id, action = action,
confirm = confirmations[action] }
for key, value in pairs(details) do payload[key] = value end
if action ~= "delete_media" then
local pending = { schema = 1, state = "pending", id = id, action = action,
label = label, started_at = os.time(), payload = payload }
self.active_plex_command = pending
if not write_plex_receipt(pending) then
pending.never_dispatched = true
self.plex_receipt_error = true
self:notice("Cannot save a private Plex receipt. No action was sent."
.. " Open Saved Plex action for recovery.", 9)
return
end
end
if action == "delete_media" then
self.settings.plex_delete_command = { id = id, label = label }
self:saveSettings()
end
local body, code = self:requestRemote("/api/v1/plex/commands", "POST",
self.settings.control_token_file, require("json").encode(payload),
"application/json", MAX_JSON_BYTES)
if action == "delete_media" and (code == 400 or code == 409) then
self.settings.plex_delete_command = nil
self:saveSettings()
self:notice(code == 400
and "Deletion was not started. Refresh the Plex title list and try again."
or "Deletion was not started because the title or job changed."
.. " Refresh the Plex title list.", 9)
return
end
if action ~= "delete_media" then
if code == 400 or code == 401 or code == 403 or code == 409 then
if write_plex_receipt({ schema = 1, state = "clear" }) then
self.active_plex_command = nil
else
self.active_plex_command.prequeue_refused_code = code
self.plex_receipt_error = true
UIManager:unschedule(self.plex_command_poll_task)
UIManager:scheduleIn(3, self.plex_command_poll_task)
end
self:notice(label .. " was not queued (HTTP " .. tostring(code) .. ")."
.. (self.plex_receipt_error and " Receipt cleanup will retry; open Saved Plex action for recovery." or ""), 9)
return
end
self:notice(code == 202 and (label .. " queued.")
or (label .. " receipt uncertain; checking the saved request ID."), 7)
UIManager:unschedule(self.plex_command_poll_task)
UIManager:scheduleIn(2, self.plex_command_poll_task)
return
end
if body and code ~= 202 then
if action == "delete_media" then
self.active_plex_command = { id = id, action = action,
label = label, started_at = os.time() }
self:notice("Deletion response was unclear. Receipt saved; checking its outcome.", 9)
UIManager:unschedule(self.plex_command_poll_task)
UIManager:scheduleIn(2, self.plex_command_poll_task)
return
end
local response = decode_json(body)
self:notice(label .. " rejected (HTTP " .. tostring(code) .. "): "
.. safe_label(response and response.error, 100), 8)
return
end
self.active_plex_command = { id = id, action = action,
label = label, started_at = os.time() }
self:notice(body and (label .. " queued.")
or (label .. " receipt uncertain; checking the same request ID."), 5)
UIManager:unschedule(self.plex_command_poll_task)
UIManager:scheduleIn(2, self.plex_command_poll_task)
end
function Dashboard:pollPlexCommand()
local pending = self.active_plex_command
if not pending or not self.running or self.suspended then return end
local body, code = self:requestRemote("/api/v1/plex/commands/" .. pending.id,
"GET", self.settings.control_token_file, nil,
"application/json", MAX_JSON_BYTES)
if pending.action ~= "delete_media" and pending.prequeue_refused_code then
if write_plex_receipt({ schema = 1, state = "clear" }) then
self.active_plex_command = nil
self.plex_receipt_error = false
self:notice("The unqueued Plex action receipt was cleared. No action was resent.", 8)
else
self.plex_receipt_error = true
UIManager:scheduleIn(30, self.plex_command_poll_task)
end
return
end
if pending.action ~= "delete_media" then
pending.receipt_absent = code == 404
end
if body and code == 200 then
local result = decode_json(body)
if type(result) == "table" and result.id == pending.id
and result.action == pending.action then
local state = result.state
if pending.action ~= "delete_media" then pending.remote_state = state end
if pending.action ~= "delete_media" and state == "unknown" then
if not pending.uncertain_notice then
pending.uncertain_notice = true
self:notice(pending.label .. " outcome uncertain. Receipt saved;"
.. " operator review is required before another Plex action.", 10)
end
UIManager:scheduleIn(30, self.plex_command_poll_task)
return
end
if state == "accepted" or state == "rejected"
or state == "unknown" or state == "expired"
or pending.action == "terminate_stream" and state == "completed" then
if pending.action ~= "delete_media"
and not write_plex_receipt({ schema = 1, state = "clear" }) then
self.plex_receipt_error = true
self:notice("Plex result received, but receipt storage needs recovery.", 9)
UIManager:scheduleIn(30, self.plex_command_poll_task)
return
end
self.plex_receipt_error = false
self.active_plex_command = nil
if pending.action == "delete_media" then
self.settings.plex_delete_command = nil
self:saveSettings()
end
if pending.action == "delete_media" then
local message
if state == "accepted" then
message = pending.label .. ": Sonarr/Radarr accepted deletion."
.. " Files and Plex may take time to refresh."
elseif state == "rejected" then
message = pending.label .. ": deletion was rejected."
.. " Check the title in Plex and Sonarr/Radarr."
else
message = pending.label .. ": deletion outcome uncertain."
.. " Inspect the title before trying anything else."
end
self:notice(message, 10)
else
local detail = safe_label(result.detail, 120)
if pending.action == "terminate_stream" then detail = detail:gsub("^stream_", ""):gsub("_", " ") end
self:notice(pending.label .. ": " .. state .. ". " .. detail, 8)
end
self.tab_cache[4] = nil
if self.running and self.active_tab == 4 and self.quick_menu_count == 0 then
self:schedulePoll(2)
end
return
end
end
elseif code == 401 or code == 403 then
if pending.action == "delete_media" then
if not pending.auth_notice then
self:notice("Plex control token was rejected. Deletion receipt is saved;"
.. " restore the token to check its outcome.", 9)
pending.auth_notice = true
end
UIManager:scheduleIn(60, self.plex_command_poll_task)
return
end
if not pending.auth_notice then
pending.auth_notice = true
self:notice("Plex control token rejected. Receipt saved; restore access to check its outcome.", 9)
end
UIManager:scheduleIn(60, self.plex_command_poll_task)
return
end
if os.time() - pending.started_at >= 120 then
if pending.action == "delete_media" then
if not pending.uncertain_notice then
self:notice(pending.label .. " outcome uncertain."
.. " Receipt saved; checking without retrying deletion.", 9)
pending.uncertain_notice = true
end
UIManager:scheduleIn(30, self.plex_command_poll_task)
return
end
if not pending.uncertain_notice then
pending.uncertain_notice = true
self:notice(pending.label .. " outcome uncertain. Receipt saved; checking without resending.", 9)
end
UIManager:scheduleIn(30, self.plex_command_poll_task)
return
end
UIManager:scheduleIn(3, self.plex_command_poll_task)
end
function Dashboard:confirmPlexApprove(request)
if type(request) ~= "table" or not positive_id(request.id)
or not positive_id(request.tmdb_id)
or (request.media_type ~= "movie" and request.media_type ~= "tv") then
self:notice("This pending request cannot be approved from Kindle.", 7)
return
end
local title = safe_label(request.title, 72)
local latest, status_error = self:getPlexStatus()
if not latest or latest.stale ~= false or latest.seerr.state ~= "online" then
self:notice("Pending requests are unavailable: "
.. tostring(status_error or "stale media data"), 8)
return
end
local still_pending = false
for _, row in ipairs(type(latest.seerr.pending) == "table" and latest.seerr.pending or {}) do
if type(row) == "table" and row.id == request.id
and row.media_type == request.media_type
and row.tmdb_id == request.tmdb_id then
still_pending = true
break
end
end
if not still_pending then
self:notice("That Seerr request is no longer pending. Refresh the Plex tab.", 8)
return
end
UIManager:show(ConfirmBox:new {
text = "Approve Seerr request for " .. title .. " ("
.. request.media_type .. ", TMDb " .. request.tmdb_id .. ")?"
.. "\nRequested by " .. safe_label(request.requester, 48)
.. ". This may start media downloads.",
ok_text = "Approve request",
flush_events_on_show = true,
ok_callback = function()
self:submitPlexCommand("approve", {
seerr_request_id = request.id,
expected_media_type = request.media_type,
expected_tmdb_id = request.tmdb_id,
}, "Approve " .. title)
end,
})
end
function Dashboard:plexRequestDestinations()
local state, reason = self:getPlexStatus()
if not state then
return nil, "Media status unavailable: " .. tostring(reason)
end
if state.stale ~= false then return nil, "Media status is stale. Try again shortly." end
if state.seerr.state ~= "online" then return nil, "Seerr is not online." end
local staging_ready = false
for _, drive in ipairs(state.drives) do
if type(drive) == "table" and drive.id == "c" and drive.drive == "C:"
and drive.state == "mounted" and type(drive.free_bytes) == "number"
and drive.free_bytes >= 100 * 1073741824
and drive.free_bytes < math.huge then
staging_ready = true
break
end
end
if not staging_ready then
return nil, "C: download staging needs at least 100 GiB free."
end
local destinations = {}
for _, id in ipairs({ "m", "n" }) do
for _, drive in ipairs(state.drives) do
local free = type(drive) == "table" and drive.free_bytes
if type(drive) == "table" and drive.id == id
and drive.drive == id:upper() .. ":" and drive.state == "mounted"
and type(free) == "number" and free >= 100 * 1073741824
and free < math.huge then
destinations[#destinations + 1] = {
id = id, drive = drive.drive,
name = safe_label(drive.name, 38),
label = safe_label(drive.label, 38),
free_bytes = free,
}
break
end
end
end
if #destinations == 0 then
return nil, "No media SSD is mounted with at least 100 GiB free."
end
local pipeline = type(state.pipeline) == "table" and state.pipeline or {}
local components = type(pipeline.components) == "table" and pipeline.components or {}
local age = pipeline.age_seconds
if (pipeline.state ~= "ready" and pipeline.state ~= "failed")
or components.media_ready ~= true
or type(pipeline.checked_at) ~= "string" or pipeline.checked_at == ""
or type(age) ~= "number" or not (age >= 0 and age <= 480)
or state.plex.state ~= "online" then
return nil, "Media services are not ready. Check Plex / Services."
end
return destinations
end
function Dashboard:confirmPlexRequest(item, selected_seasons, destination)
if type(item) ~= "table" or not positive_id(item.tmdb_id)
or (item.media_type ~= "movie" and item.media_type ~= "tv")
or (item.media_type == "movie" and item.status ~= "unknown")
or type(destination) ~= "table"
or (destination.id ~= "m" and destination.id ~= "n") then
self:notice("This search result cannot be requested from Kindle.", 7)
return
end
local title = safe_label(item.title, 72)
local details = { media_type = item.media_type, tmdb_id = item.tmdb_id,
storage_id = destination.id }
local scope = "movie"
if item.media_type == "tv" then
if type(selected_seasons) ~= "table" or #selected_seasons == 0 then
self:notice("Choose at least one season first.", 7)
return
end
details.seasons = selected_seasons
scope = "season" .. (#selected_seasons == 1 and " " or "s ")
.. table.concat(selected_seasons, ", ") .. ", excluding specials"
end
UIManager:show(ConfirmBox:new {
text = "Request " .. title .. " (TMDb " .. item.tmdb_id .. ")?"
.. "\nScope: " .. scope .. ". Finished media: " .. destination.drive
.. " " .. destination.name .. ". Downloads stage on C:."
.. " Your owner request will be auto-approved and may start downloads.",
ok_text = "Request and approve",
flush_events_on_show = true,
ok_callback = function()
local live, reason = self:plexRequestDestinations()
if not live then
self:notice(reason, 8)
return
end
local still_ready = false
for _, row in ipairs(live) do
if row.id == destination.id and row.name == destination.name
and row.label == destination.label then
still_ready = true
break
end
end
if not still_ready then
self:notice("Selected SSD changed or disconnected. Choose it again.", 8)
return
end
self:submitPlexCommand("request", details, "Request " .. title)
end,
})
end
function Dashboard:showPlexDestinationPicker(item, selected_seasons, details, selected, offset)
local destinations, reason = self:plexRequestDestinations()
if not destinations then
self:notice(reason, 8)
return
end
local items = {}
for _, destination in ipairs(destinations) do
local row = destination
items[#items + 1] = {
text = row.drive .. " " .. row.name .. " · "
.. string.format("%.1f GiB free", row.free_bytes / 1073741824),
close_on_select = true,
callback = function()
self:confirmPlexRequest(item, selected_seasons, row)
end,
}
end
if item.media_type == "tv" and type(details) == "table" then
items[#items + 1] = { text = "Back to seasons", close_on_select = true,
callback = function()
self:showPlexSeasonPicker(item, details, selected, offset)
end }
end
self:showQuickMenu("Save finished media on SSD · " .. safe_label(item.title, 44), items)
end
function Dashboard:showPlexSeasonPicker(item, details, selected, offset)
if type(details) ~= "table" or details.tmdb_id ~= item.tmdb_id
or type(details.seasons) ~= "table" then
self:notice("TV season details are invalid.", 8)
return
end
selected = selected or {}
offset = offset or 0
local seasons = details.seasons
local selected_list = {}
for _, season in ipairs(seasons) do
if type(season) == "table" and positive_id(season.number)
and season.requestable == true and selected[season.number] then
selected_list[#selected_list + 1] = season.number
end
end
table.sort(selected_list)
local items = {
{ text = "Request " .. #selected_list .. " selected season"
.. (#selected_list == 1 and "" or "s"),
enabled_func = function() return #selected_list > 0 end,
close_on_select = true,
callback = function()
self:showPlexDestinationPicker(item, selected_list, details, selected, offset)
end },
{ text = "Select all listed seasons", close_on_select = true,
callback = function()
for _, season in ipairs(seasons) do
if type(season) == "table" and positive_id(season.number)
and season.requestable == true then
selected[season.number] = true
end
end
self:showPlexSeasonPicker(item, details, selected, offset)
end },
{ text = "Clear selection", close_on_select = true,
callback = function()
self:showPlexSeasonPicker(item, details, {}, offset)
end },
}
for index = offset + 1, math.min(#seasons, offset + 10) do
local season = seasons[index]
if type(season) == "table" and positive_id(season.number) then
local number = season.number
local episodes = tonumber(season.episode_count) or 0
local requestable = season.requestable == true
items[#items + 1] = {
text = (requestable and (selected[number] and "[x] " or "[ ] ") or "[-] ")
.. "Season " .. number .. " · " .. episodes .. " episodes"
.. (requestable and "" or (episodes == 0 and " · no episodes" or " · covered")),
enabled_func = function() return requestable end,
close_on_select = true,
callback = function()
selected[number] = not selected[number]
self:showPlexSeasonPicker(item, details, selected, offset)
end,
}
end
end
if offset > 0 then
items[#items + 1] = { text = "Previous seasons", close_on_select = true,
callback = function()
self:showPlexSeasonPicker(item, details, selected, math.max(0, offset - 10))
end }
end
if #seasons > offset + 10 then
items[#items + 1] = { text = "More seasons", close_on_select = true,
callback = function()
self:showPlexSeasonPicker(item, details, selected, offset + 10)
end }
end
self:showQuickMenu("Seasons · " .. safe_label(details.title, 60), items)
end
function Dashboard:pollPlexDetails()
local pending = self.active_plex_details
if not pending or not self.running or self.suspended then return end
local body, code = self:requestRemote("/api/v1/plex/details/" .. pending.id,
"GET", self.settings.control_token_file, nil,
"application/json", MAX_JSON_BYTES)
if body and code == 200 then
local result = decode_json(body)
if type(result) == "table" and result.id == pending.id then
if result.state == "completed" then
self.active_plex_details = nil
self:showPlexSeasonPicker(pending.item, result.details)
return
elseif result.state == "rejected" or result.state == "unknown"
or result.state == "expired" then
self.active_plex_details = nil
self:notice("TV season lookup " .. result.state .. ".", 8)
return
end
end
elseif body and (code == 401 or code == 403) then
self.active_plex_details = nil
self:notice("Plex control token was rejected.", 8)
return
end
if os.time() - pending.started_at >= 90 then
self.active_plex_details = nil
self:notice("TV season lookup timed out.", 8)
return
end
UIManager:scheduleIn(3, self.plex_details_poll_task)
end
function Dashboard:startPlexDetails(item)
if self.active_plex_details then
self:notice("Wait for the current TV season lookup.", 7)
return
end
if not NetworkMgr:isConnected() then
self:notice("Wi-Fi is disconnected. Season lookup was not sent.", 7)
return
end
local _, token_error = read_bearer_token(self.settings.control_token_file)
if token_error then
self:notice("Plex control token unavailable: " .. token_error, 7)
return
end
local id = require("random").uuid(true):lower()
local body, code = self:requestRemote("/api/v1/plex/details", "POST",
self.settings.control_token_file,
require("json").encode { request_id = id, media_type = "tv", tmdb_id = item.tmdb_id },
"application/json", MAX_JSON_BYTES)
if body and code ~= 202 then
self:notice("TV season lookup rejected (HTTP " .. tostring(code) .. ").", 8)
return
end
self.active_plex_details = { id = id, item = item, started_at = os.time() }
self:notice("Loading seasons for " .. safe_label(item.title, 60) .. "...", 5)
UIManager:unschedule(self.plex_details_poll_task)
UIManager:scheduleIn(2, self.plex_details_poll_task)
end
function Dashboard:showPlexSearchResults(results)
local items = {}
for _, item in ipairs(type(results) == "table" and results or {}) do
if #items >= 12 then break end
if type(item) == "table" and positive_id(item.tmdb_id)
and (item.media_type == "movie" or item.media_type == "tv") then
local media = item
local label = safe_label(media.title, 64) .. " ("
.. safe_label(tostring(media.year or ""), 8) .. ", "
.. media.media_type .. ") · " .. safe_label(media.status, 20)
items[#items + 1] = { text = label,
enabled_func = function()
return media.media_type == "tv" or media.status == "unknown"
end,
close_on_select = true,
callback = function()
if media.media_type == "tv" then
self:startPlexDetails(media)
else
self:showPlexDestinationPicker(media)
end
end }
end
end
if #items == 0 then
items[1] = { text = "No matching titles", enabled_func = function() return false end }
end
self:showQuickMenu("Seerr search results", items)
end
function Dashboard:pollPlexSearch()
local pending = self.active_plex_search
if not pending or not self.running or self.suspended then return end
local body, code = self:requestRemote("/api/v1/plex/search/" .. pending.id,
"GET", self.settings.control_token_file, nil,
"application/json", MAX_JSON_BYTES)
if body and code == 200 then
local result = decode_json(body)
if type(result) == "table" and result.id == pending.id then
if result.state == "completed" then
self.active_plex_search = nil
self:showPlexSearchResults(result.items)
return
elseif result.state == "rejected" or result.state == "unknown"
or result.state == "expired" then
self.active_plex_search = nil
self:notice("Seerr search " .. result.state .. ".", 8)
return
end
end
elseif body and (code == 401 or code == 403) then
self.active_plex_search = nil
self:notice("Plex control token was rejected.", 8)
return
end
if os.time() - pending.started_at >= 90 then
self.active_plex_search = nil
self:notice("Seerr search timed out. Try a narrower title.", 8)
return
end
UIManager:scheduleIn(3, self.plex_search_poll_task)
end
function Dashboard:startPlexSearch(query)
if self.active_plex_search then
self:notice("Wait for the current Seerr search.", 7)
return
end
if type(query) ~= "string" then return end
query = query:gsub("[%c]", " "):match("^%s*(.-)%s*$")
if #query < 2 or #query > 80 then
self:notice("Enter a title from 2 to 80 characters.", 7)
return
end
if not NetworkMgr:isConnected() then
self:notice("Wi-Fi is disconnected. Search was not sent.", 7)
return
end
local _, token_error = read_bearer_token(self.settings.control_token_file)
if token_error then
self:notice("Plex control token unavailable: " .. token_error, 7)
return
end
local id = require("random").uuid(true):lower()
local body, code = self:requestRemote("/api/v1/plex/search", "POST",
self.settings.control_token_file,
require("json").encode { request_id = id, query = query },
"application/json", MAX_JSON_BYTES)
if body and code ~= 202 then
self:notice("Seerr search rejected (HTTP " .. tostring(code) .. ").", 8)
return
end
self.active_plex_search = { id = id, started_at = os.time() }
self:notice("Searching Seerr for " .. safe_label(query, 60) .. "...", 5)
UIManager:unschedule(self.plex_search_poll_task)
UIManager:scheduleIn(2, self.plex_search_poll_task)
end
function Dashboard:showPlexSearchPrompt()
local dialog
dialog = MultiInputDialog:new {
title = "Search Seerr",
fields = {
{ text = "", hint = "Movie or TV title", input_type = "string" },
},
buttons = {{
{ text = "Cancel", id = "close", callback = function() UIManager:close(dialog) end },
{ text = "Search", is_enter_default = true, callback = function()
local fields = dialog:getFields()
UIManager:close(dialog)
self:startPlexSearch(fields[1])
end },
}},
}
UIManager:show(dialog)
end
function Dashboard:showPlexLibraries(state)
local items = {}
local libraries = type(state.plex.libraries) == "table" and state.plex.libraries or {}
local can_scan = state.stale == false and state.plex.state == "online"
local drives = type(state.drives) == "table" and state.drives or {}
if #drives == 0 then can_scan = false end
for _, drive in ipairs(drives) do
if type(drive) ~= "table" or drive.state ~= "mounted" then can_scan = false end
end
for _, library in ipairs(libraries) do
if type(library) == "table" and type(library.id) == "string"
and #library.id >= 1 and #library.id <= 8
and library.id:match("^%d+$") then
local row = library
items[#items + 1] = {
text = safe_label(row.name, 55) .. " · "
.. tostring(row.items or "?") .. " items · scan files",
enabled_func = function() return can_scan end,
close_on_select = true,
callback = function()
UIManager:show(ConfirmBox:new {
text = "Scan " .. safe_label(row.name, 70)
.. " for added or removed files?",
ok_text = "Start scan",
flush_events_on_show = true,
ok_callback = function()
self:submitPlexCommand("scan", {
library_id = row.id,
expected_name = row.name,
}, "Scan " .. safe_label(row.name, 48))
end,
})
end,
}
end
end
if #items == 0 then
items[1] = { text = "No libraries available", enabled_func = function() return false end }
end
self:showQuickMenu("Plex libraries", items)
end
local PLEX_PLAYBACK = {
states = { playing = "Playing", paused = "Paused", buffering = "Buffering", unknown = "Unknown" },
modes = { directplay = "Direct play", directstream = "Direct stream", transcode = "Transcode", unknown = "Unknown" },
decisions = { directplay = "Direct play", copy = "Copy", transcode = "Transcode", unknown = "Unknown" },
reasons = { { "owner_request", "Operator request" }, { "buffering", "Playback is buffering" },
{ "bandwidth", "Reduce bandwidth use" }, { "maintenance", "Server maintenance" } },
}
function PLEX_PLAYBACK.valid(block)
if type(block) ~= "table" or block.schema_version ~= 1
or type(block.observed_at) ~= "string" or #block.observed_at > 40
or not block.observed_at:match("^%d%d%d%d%-%d%d%-%d%dT%d%d:%d%d:%d%d")
or not insight_array(block.sessions, 16) or block.displayed_sessions ~= #block.sessions
or not insight_number(block.total_sessions, 10000) or not insight_number(block.observed_sessions, 256)
or type(block.truncated) ~= "boolean" or type(block.summary_complete) ~= "boolean"
or type(block.summary) ~= "table" then return false end
local summary = block.summary
for _, key in ipairs({ "playing", "paused", "buffering", "transcoding" }) do
if not insight_number(summary[key], 10000) then return false end
end
if type(summary.bandwidth_complete) ~= "boolean" or not (json_is_null(summary.bandwidth_kbps)
or insight_number(summary.bandwidth_kbps, 1000000000)) then return false end
local seen = {}
for _, row in ipairs(block.sessions) do
if type(row) ~= "table" or type(row.id) ~= "string" or (row.id ~= ""
and (#row.id ~= 67 or not row.id:match("^ps_[0-9a-f]+$") or seen[row.id]))
or not PLEX_PLAYBACK.states[row.state] or not PLEX_PLAYBACK.modes[row.playback_mode]
or not PLEX_PLAYBACK.decisions[row.video_decision] or not PLEX_PLAYBACK.decisions[row.audio_decision]
or not ({ local_ = true, remote = true, relay = true, unknown = true })[row.location == "local" and "local_" or row.location]
or type(row.can_stop) ~= "boolean" or type(row.transcode) ~= "table" or type(row.transcode.active) ~= "boolean" then return false end
if row.id ~= "" then seen[row.id] = true end
for _, key in ipairs({ "title", "type", "show_title", "user", "player", "product", "video_codec", "audio_codec", "video_resolution" }) do
if type(row[key]) ~= "string" or #row[key] > 640 or row[key]:find("[%c]") then return false end
end
for _, pair in ipairs({ { "season", 100000 }, { "episode", 100000 }, { "offset_ms", 315576000000 },
{ "duration_ms", 315576000000 }, { "progress_percent", 100 }, { "bandwidth_kbps", 1000000000 } }) do
if not (json_is_null(row[pair[1]]) or insight_number(row[pair[1]], pair[2])) then return false end
end
for _, key in ipairs({ "hardware_decode", "hardware_encode", "throttled" }) do
if not (json_is_null(row.transcode[key]) or type(row.transcode[key]) == "boolean") then return false end
end
for _, pair in ipairs({ { "progress_percent", 100 }, { "speed", 100000 } }) do
if not (json_is_null(row.transcode[pair[1]]) or insight_number(row.transcode[pair[1]], pair[2])) then return false end
end
end
return true
end
function PLEX_PLAYBACK.bandwidth(value)
return insight_number(value, 1000000000) and string.format("%.2f Mbps", value / 1000) or "Not reported"
end
function PLEX_PLAYBACK.progress(row)
local offset, duration = insight_number(row.offset_ms, 315576000000), insight_number(row.duration_ms, 315576000000)
return (insight_number(row.progress_percent, 100) and string.format("%.1f%%", row.progress_percent) or "Progress unknown")
.. " · " .. (offset and insight_duration(offset / 1000) or "Unknown") .. " / "
.. (duration and insight_duration(duration / 1000) or "Unknown")
end
function Dashboard:getPlexNowPlaying(state)
local failure
if not state then state, failure = self:getPlexStatus() end
if state and PLEX_PLAYBACK.valid(state.plex.now_playing) then
self.plex_stream_cache = { state = state, fetched_at = os.time() }
else failure = failure and "Refresh unavailable" or "Now Playing details not reported" end
local cache = self.plex_stream_cache
return { state = cache and cache.state or state, fetched_at = cache and cache.fetched_at or os.time(), failure = failure }
end
function Dashboard:plexNowPlayingFresh(context)
local state = context and context.state
return state and not context.failure and state.stale == false and state.plex.state == "online"
and insight_number(state.age_seconds, 45) ~= nil and os.time() - context.fetched_at <= 45
end
function Dashboard:closePlexNowPlaying()
if self.plex_stream_poll_task then UIManager:unschedule(self.plex_stream_poll_task) end
self.plex_stream_poll_task = nil
for _, key in ipairs({ "plex_stream_confirm", "plex_stream_report", "plex_stream_reason_menu", "plex_stream_detail_menu", "plex_stream_menu" }) do
local widget = self[key]
self[key] = nil
if widget then UIManager:close(widget) end
end
end
function Dashboard:schedulePlexNowPlaying(menu, offset)
if self.plex_stream_poll_task then UIManager:unschedule(self.plex_stream_poll_task) end
if not self.running or self.suspended or self.plex_stream_menu ~= menu then return end
local task
task = function()
if self.plex_stream_poll_task ~= task or self.plex_stream_menu ~= menu then return end
self.plex_stream_poll_task = nil
if not self.running or self.suspended then return end
if self.plex_stream_report or self.plex_stream_confirm or (self.quick_menu_count or 0) > (self.plex_stream_menu_depth or 1) then
self:schedulePlexNowPlaying(menu, offset)
else self:showPlexStreams(nil, offset) end
end
self.plex_stream_poll_task = task
UIManager:scheduleIn(15, task)
end
function Dashboard:showPlexStreamReport(context, row)
local block = context.state.plex.now_playing
local hardware = function(value) return type(value) == "boolean" and (value and "Yes" or "No") or "Not reported" end
local lines = { insight_text(row.title, 640), "Observed: " .. block.observed_at,
self:plexNowPlayingFresh(context) and "Latest reported session" or "Saved / stale observation; controls unavailable",
"", "Playback: " .. PLEX_PLAYBACK.states[row.state], PLEX_PLAYBACK.progress(row),
"User: " .. insight_text(row.user, 640), "Player: " .. insight_text(row.player, 640),
"Application: " .. insight_text(row.product, 640), "Connection: " .. row.location,
"Reserved bandwidth: " .. PLEX_PLAYBACK.bandwidth(row.bandwidth_kbps),
"Reserved bandwidth is Plex's session reservation, not measured network throughput.",
"", "Playback mode: " .. PLEX_PLAYBACK.modes[row.playback_mode],
"Video: " .. PLEX_PLAYBACK.decisions[row.video_decision] .. " · " .. insight_text(row.video_codec, 80)
.. " · " .. insight_text(row.video_resolution, 40),
"Audio: " .. PLEX_PLAYBACK.decisions[row.audio_decision] .. " · " .. insight_text(row.audio_codec, 80),
"Transcode session: " .. (row.transcode.active and "Active" or "Not active"),
"Hardware decoding: " .. hardware(row.transcode.hardware_decode),
"Hardware encoding: " .. hardware(row.transcode.hardware_encode),
"Transcode throttled: " .. hardware(row.transcode.throttled),
"Transcode buffer progress: " .. (insight_number(row.transcode.progress_percent, 100)
and string.format("%.1f%%", row.transcode.progress_percent) or "Not reported"),
"Transcode speed: " .. (insight_number(row.transcode.speed, 100000)
and string.format("%.2fx", row.transcode.speed) or "Not reported"),
"Transcode progress describes processing/buffering, not the viewer's playback position.",
"", "This is a captured report. Close it to resume the 15-second list refresh.",
"Stop stream sends a Plex termination request; Plex Pass may be required. Universal remote pause/resume is not offered." }
if row.show_title ~= "" then table.insert(lines, 2, insight_text(row.show_title, 640)
.. " · season " .. tostring(insight_number(row.season, 100000) or "?") .. " · episode " .. tostring(insight_number(row.episode, 100000) or "?")) end
self:showMediaInsightsText("Plex session report", lines)
self.plex_stream_report = self.media_insights_view
local viewer, original = self.plex_stream_report, self.plex_stream_report.onCloseWidget
viewer.onCloseWidget = function(widget)
if self.plex_stream_report == widget then self.plex_stream_report = nil end
if original then original(widget) end
end
end
function Dashboard:findPlexStream(id)
local context = self:getPlexNowPlaying()
if not self:plexNowPlayingFresh(context) then return nil, context end
for _, row in ipairs(context.state.plex.now_playing.sessions) do
if row.id == id and id ~= "" then return row, context end
end
return nil, context
end
function Dashboard:confirmPlexStreamStop(id, reason)
local row, context = self:findPlexStream(id)
if not row or row.can_stop ~= true then self:notice("Stream changed, ended, or is not controllable. Refresh Now Playing.", 9); return end
local dialog
dialog = ConfirmBox:new {
text = "Stop " .. insight_text(row.title, 160) .. " for " .. insight_text(row.user, 160)
.. " on " .. insight_text(row.player, 160) .. "?\nReason: " .. reason[2]
.. ". Playback will be interrupted. Plex Pass may be required.",
ok_text = "Stop this stream", flush_events_on_show = true,
ok_callback = function()
local current, fresh = self:findPlexStream(id)
if not current or not current.can_stop then self:notice("Stream changed or session data is stale. No stop was sent.", 9); return end
self:submitPlexCommand("terminate_stream", { session_id = current.id,
observed_at = fresh.state.plex.now_playing.observed_at, reason = reason[1] }, "Stop Plex stream")
end,
}
self.plex_stream_confirm = dialog
local original = dialog.onCloseWidget
dialog.onCloseWidget = function(widget)
if self.plex_stream_confirm == widget then self.plex_stream_confirm = nil end
if original then original(widget) end
end
UIManager:show(dialog)
end
function Dashboard:showPlexStreamDetail(context, row)
if self.plex_stream_detail_menu then UIManager:close(self.plex_stream_detail_menu) end
local items = {
{ text = insight_text(row.title, 100) .. "\n" .. PLEX_PLAYBACK.states[row.state] .. " · " .. PLEX_PLAYBACK.progress(row), enabled_func = function() return false end },
{ text = "Full session report", callback = function() self:showPlexStreamReport(context, row) end },
{ text = "Refresh this session", callback = function()
local current, fresh = self:findPlexStream(row.id)
if current then self:showPlexStreamDetail(fresh, current)
else self:notice("Session ended or fresh data is unavailable. Return to Now Playing for current sessions.", 9) end
end },
{ text = "Stop this stream…", enabled_func = function()
return row.id ~= "" and row.can_stop and self:plexNowPlayingFresh(context) end,
callback = function()
local reasons = {}
for _, value in ipairs(PLEX_PLAYBACK.reasons) do
local reason = value
reasons[#reasons + 1] = { text = reason[2], close_on_select = true,
callback = function() self:confirmPlexStreamStop(row.id, reason) end }
end
local picker = self:showQuickMenu("Reason for stopping stream", reasons)
self.plex_stream_reason_menu = picker
local original = picker.onCloseWidget
picker.onCloseWidget = function(widget)
if self.plex_stream_reason_menu == widget then self.plex_stream_reason_menu = nil end
if original then original(widget) end
end
end },
{ text = "Stop is checked against the current session and confirmed before sending. Plex Pass may be required.", enabled_func = function() return false end },
}
local menu = self:showQuickMenu("Now Playing · session", items)
self.plex_stream_detail_menu = menu
local original = menu.onCloseWidget
menu.onCloseWidget = function(widget)
if self.plex_stream_detail_menu == widget then self.plex_stream_detail_menu = nil end
if original then original(widget) end
end
end
function Dashboard:showPlexStreams(state, offset)
offset = type(offset) == "number" and math.max(0, math.floor(offset)) or 0
self:closePlexNowPlaying()
local context = self:getPlexNowPlaying(state)
state = context.state
local block = state and state.plex.now_playing
local valid = PLEX_PLAYBACK.valid(block)
local items = {
{ text = self:plexNowPlayingFresh(context) and "Latest reported · refresh every 15s" or "Saved / stale or unavailable · controls paused", enabled_func = function() return false end },
{ text = "Refresh stats", close_on_select = true, callback = function() self:showPlexStreams(nil, offset) end },
}
if valid then
local summary = block.summary
items[#items + 1] = { text = tostring(block.total_sessions) .. " sessions · " .. summary.playing .. " playing · "
.. summary.paused .. " paused · " .. summary.buffering .. " buffering\n" .. summary.transcoding
.. " transcoding · Reserved bandwidth " .. PLEX_PLAYBACK.bandwidth(summary.bandwidth_kbps)
.. (summary.bandwidth_complete and "" or " (partial / unknown)")
.. (block.summary_complete and "" or "\nSummary covers observed sessions only"), enabled_func = function() return false end }
items[#items + 1] = { text = "Observed " .. block.observed_at .. (block.truncated and " · showing " .. block.displayed_sessions .. " of " .. block.total_sessions or ""), enabled_func = function() return false end }
offset = math.min(offset, math.max(0, math.floor((#block.sessions - 1) / 4) * 4))
for index = offset + 1, math.min(#block.sessions, offset + 4) do
local row = block.sessions[index]
items[#items + 1] = { text = insight_text(row.title, 72) .. "\n" .. PLEX_PLAYBACK.states[row.state] .. " · "
.. PLEX_PLAYBACK.progress(row) .. "\n" .. insight_text(row.user, 40) .. " · " .. insight_text(row.player, 40)
.. "\n" .. PLEX_PLAYBACK.modes[row.playback_mode] .. " · Reserved " .. PLEX_PLAYBACK.bandwidth(row.bandwidth_kbps),
callback = function() self:showPlexStreamDetail(context, row) end }
end
if #block.sessions == 0 then items[#items + 1] = { text = block.total_sessions == 0
and self:plexNowPlayingFresh(context) and "No active streams at this observation" or "No session details available; activity may be unknown", enabled_func = function() return false end } end
if offset > 0 then items[#items + 1] = { text = "Previous sessions", close_on_select = true, callback = function() self:showPlexStreams(state, offset - 4) end } end
if #block.sessions > offset + 4 then items[#items + 1] = { text = "More sessions", close_on_select = true, callback = function() self:showPlexStreams(state, offset + 4) end } end
else
items[#items + 1] = { text = "Now Playing details unavailable; a fresh collector update is needed.", enabled_func = function() return false end }
for _, row in ipairs(state and type(state.plex.streams) == "table" and state.plex.streams or {}) do
if type(row) == "table" then items[#items + 1] = { text = safe_label(row.title, 72) .. " · " .. safe_label(row.state, 20) .. " · " .. safe_label(row.player, 60), enabled_func = function() return false end } end
end
end
local menu = self:showQuickMenu("Plex Now Playing", items)
self.plex_stream_menu, self.plex_stream_offset, self.plex_stream_menu_depth = menu, offset, self.quick_menu_count
local original = menu.onCloseWidget
menu.onCloseWidget = function(widget)
if self.plex_stream_menu == widget then
self.plex_stream_menu = nil
if self.plex_stream_poll_task then UIManager:unschedule(self.plex_stream_poll_task) end
self.plex_stream_poll_task = nil
end
if original then original(widget) end
end
self:schedulePlexNowPlaying(menu, offset)
end
function Dashboard:showPlexHealth(state)
local items = {}
for _, drive in ipairs(type(state.drives) == "table" and state.drives or {}) do
if type(drive) == "table" then
local free = tonumber(drive.free_bytes)
local free_label = free and string.format("%.1f GB free", free / 1000000000)
or "capacity unavailable"
items[#items + 1] = {
text = safe_label(drive.drive, 4) .. " " .. safe_label(drive.name, 34)
.. " · " .. safe_label(drive.state, 24) .. " · " .. free_label,
enabled_func = function() return false end,
}
end
end
for _, service in ipairs(type(state.services) == "table" and state.services or {}) do
if type(service) == "table" then
items[#items + 1] = {
text = safe_label(service.id, 32) .. " · " .. safe_label(service.state, 24),
enabled_func = function() return false end,
}
end
end
self:showQuickMenu("Storage and services", items)
end
function Dashboard:plexMaintenanceReady(action, details)
local state, reason = self:getPlexStatus()
if not state then return nil, "Media status unavailable: " .. tostring(reason) end
if state.stale ~= false then return nil, "Media status is stale. Try again shortly." end
local needs_drives = action == "restart_service" or action == "refresh_metadata"
if needs_drives then
local mounted = {}
for _, drive in ipairs(state.drives) do
if type(drive) == "table" and (drive.id == "c" or drive.id == "m"
or drive.id == "n") and drive.drive == drive.id:upper() .. ":"
and drive.state == "mounted" then
mounted[drive.id] = true
end
end
if not (mounted.c and mounted.m and mounted.n) then
return nil, "All three media drives must be mounted for this action."
end
if state.plex.state ~= "online" then
return nil, "Plex must be online for this action."
end
end
if action == "restart_service" then
if type(details) ~= "table" or not ({ seerr = true, sonarr = true,
radarr = true, prowlarr = true })[details.service_id] then
return nil, "Unsupported service restart."
end
if type(state.plex.active_streams) ~= "number"
or state.plex.active_streams ~= 0 then
return nil, "Wait until all Plex streams stop before restarting a service."
end
for _, row in ipairs(state.services) do
if type(row) == "table" and row.id == details.service_id
and (row.state == "healthy" or row.state == "running"
or row.state == "unhealthy"
or (row.state == "stopped" and (details.service_id == "seerr"
or details.service_id == "prowlarr"))) then return state end
end
return nil, "Selected service is not available in the current status."
elseif action == "refresh_metadata" then
if type(details) ~= "table" or type(details.library_id) ~= "string"
or type(details.expected_name) ~= "string" then
return nil, "Invalid Plex library selection."
end
if type(state.plex.active_streams) ~= "number"
or state.plex.active_streams ~= 0 then
return nil, "Wait until all Plex streams stop before refreshing metadata."
end
for _, row in ipairs(state.plex.libraries) do
if type(row) == "table" and row.id == details.library_id
and row.name == details.expected_name then return state end
end
return nil, "Plex library changed. Choose it again."
elseif action == "flush_seerr_cache" then
if type(details) ~= "table" or not ({ tmdb = true, plexguid = true,
sonarr = true, radarr = true })[details.cache_id] then
return nil, "Unsupported Seerr cache."
end
if state.seerr.state ~= "online" then
return nil, "Seerr must be online to clear its cache."
end
return state
end
return nil, "Unsupported Plex maintenance action."
end
function Dashboard:confirmPlexMaintenance(action, details, title, explanation)
local ready, reason = self:plexMaintenanceReady(action, details)
if not ready then self:notice(reason, 8); return end
UIManager:show(ConfirmBox:new {
text = explanation,
ok_text = title,
flush_events_on_show = true,
ok_callback = function()
local current, current_reason = self:plexMaintenanceReady(action, details)
if not current then self:notice(current_reason, 8); return end
self:submitPlexCommand(action, details, title)
end,
})
end
function Dashboard:showPlexRestartMenu()
local state, reason = self:getPlexStatus()
if not state then self:notice("Media status unavailable: " .. tostring(reason), 8); return end
local items = {}
for _, target in ipairs({
{ id = "seerr", name = "Seerr" }, { id = "sonarr", name = "Sonarr" },
{ id = "radarr", name = "Radarr" }, { id = "prowlarr", name = "Prowlarr" },
}) do
local service = target
local observed = "unavailable"
for _, row in ipairs(state.services) do
if type(row) == "table" and row.id == service.id then
observed = safe_label(row.state, 20)
break
end
end
local can_start = observed == "stopped"
and (service.id == "seerr" or service.id == "prowlarr")
local verb = can_start and "Start " or "Restart "
items[#items + 1] = {
text = verb .. service.name .. " · " .. observed,
enabled_func = function()
return observed == "healthy" or observed == "running"
or observed == "unhealthy" or can_start
end,
close_on_select = true,
callback = function()
self:confirmPlexMaintenance("restart_service",
{ service_id = service.id }, verb .. service.name,
verb .. service.name .. "? It may pause related tasks briefly."
.. " Active Plex streams must be zero; media files are not deleted.")
end,
}
end
self:showQuickMenu("Restart media service", items)
end
function Dashboard:showPlexMetadataMenu()
local state, reason = self:getPlexStatus()
if not state then self:notice("Media status unavailable: " .. tostring(reason), 8); return end
local items = {}
for _, library in ipairs(state.plex.libraries) do
if type(library) == "table" and type(library.id) == "string"
and type(library.name) == "string" then
local row = library
items[#items + 1] = {
text = safe_label(row.name, 60) .. " · refresh metadata",
close_on_select = true,
callback = function()
self:confirmPlexMaintenance("refresh_metadata",
{ library_id = row.id, expected_name = row.name },
"Refresh " .. safe_label(row.name, 40),
"Refresh Plex metadata for " .. safe_label(row.name, 70)
.. "? Plex may fetch updated artwork and descriptions."
.. " Media files are not deleted.")
end,
}
end
end
if #items == 0 then
items[1] = { text = "No Plex libraries available",
enabled_func = function() return false end }
end
self:showQuickMenu("Refresh Plex metadata", items)
end
function Dashboard:showSeerrCacheMenu()
local items = {}
for _, target in ipairs({
{ id = "tmdb", name = "TMDb metadata" },
{ id = "plexguid", name = "Plex associations" },
{ id = "sonarr", name = "Sonarr integration" },
{ id = "radarr", name = "Radarr integration" },
}) do
local cache = target
items[#items + 1] = { text = cache.name, close_on_select = true,
callback = function()
self:confirmPlexMaintenance("flush_seerr_cache",
{ cache_id = cache.id }, "Clear " .. cache.name,
"Clear Seerr's " .. cache.name .. " cache? Seerr will fetch it again."
.. " Media files and Kindle saved views are not deleted.")
end }
end
self:showQuickMenu("Clear Seerr cache", items)
end
function Dashboard:showPlexMaintenance()
self:showQuickMenu("Plex maintenance", {
{ text = "Refresh this view", close_on_select = true,
callback = function()
self.tab_cache[4] = nil
self.last_request_at = 0
if self.running and self.active_tab == 4 then
self:schedulePoll(1)
end
end },
{ text = "Clear saved dashboard images", close_on_select = true,
callback = function()
UIManager:show(ConfirmBox:new {
text = "Clear this Kindle's saved images for all four dashboard tabs?"
.. " Live server data and media files are not changed.",
ok_text = "Clear saved images",
flush_events_on_show = true,
ok_callback = function() self:clearSavedImages() end,
})
end },
{ text = "Restart Seerr / Arr service", close_on_select = true,
callback = function() self:showPlexRestartMenu() end },
{ text = "Refresh Plex library metadata", close_on_select = true,
callback = function() self:showPlexMetadataMenu() end },
{ text = "Clear a Seerr cache", close_on_select = true,
callback = function() self:showSeerrCacheMenu() end },
})
end
local SUBTITLE_CATALOG_KINDS = {
movies = "movie", shows = "show", seasons = "season", episodes = "episode",
}
local SUBTITLE_JOB_STATES = {
queued = true, claimed = true, completed = true, partial = true,
failed = true, unknown = true, expired = true,
}
local SUBTITLE_TERMINAL_STATES = {
completed = true, partial = true, failed = true, unknown = true, expired = true,
}
local function subtitle_file_count(item)
local count = type(item) == "table" and item.file_count
if type(count) ~= "number" or count % 1 ~= 0 or count < 0 or count > 5000 then
return nil
end
return count
end
local function subtitle_item_valid(item, kind)
return type(item) == "table" and item.kind == kind and positive_id(item.id)
and type(item.title) == "string" and #item.title > 0 and #item.title <= 160
and subtitle_file_count(item) ~= nil
end
local function subtitle_languages(item)
local names = {}
for _, name in ipairs(type(item.subtitle_languages) == "table"
and item.subtitle_languages or {}) do
if type(name) == "string" and #name > 0 and #name <= 32 then
names[#names + 1] = safe_label(name, 24)
if #names == 3 then break end
end
end
return #names > 0 and table.concat(names, ", ") or "none listed"
end
function Dashboard:showSubtitleMenu()
local job = self.active_subtitle_job or self.last_subtitle_job
local items = {
{ text = "Adds new subtitle tracks; existing tracks stay unchanged",
enabled_func = function() return false end },
{ text = "Browse Plex movies", close_on_select = true,
callback = function() self:startSubtitleCatalog("movies", nil, "", 0) end },
{ text = "Browse Plex TV shows", close_on_select = true,
callback = function() self:startSubtitleCatalog("shows", nil, "", 0) end },
{ text = "Search Plex movies", close_on_select = true,
callback = function() self:showSubtitleSearchPrompt("movies") end },
{ text = "Search Plex TV shows", close_on_select = true,
callback = function() self:showSubtitleSearchPrompt("shows") end },
}
if job then
items[#items + 1] = { text = "Generation progress · "
.. safe_label(job.state or "checking", 20), close_on_select = true,
callback = function() self:showSubtitleProgress() end }
end
self:showQuickMenu("Add subtitles to Plex", items)
end
function Dashboard:showPlexDeleteMenu()
self:showQuickMenu("Delete Plex media", {
{ text = "Only exact Arr-managed titles can be deleted",
enabled_func = function() return false end },
{ text = "Browse movies", close_on_select = true,
callback = function()
self:startSubtitleCatalog("movies", nil, "", 0, nil, "delete")
end },
{ text = "Browse TV shows", close_on_select = true,
callback = function()
self:startSubtitleCatalog("shows", nil, "", 0, nil, "delete")
end },
{ text = "Search movies", close_on_select = true,
callback = function() self:showSubtitleSearchPrompt("movies", "delete") end },
{ text = "Search TV shows", close_on_select = true,
callback = function() self:showSubtitleSearchPrompt("shows", "delete") end },
})
end
function Dashboard:showSubtitleSearchPrompt(scope, purpose)
if scope ~= "movies" and scope ~= "shows" then return end
purpose = purpose == "delete" and "delete" or "subtitles"
local dialog
dialog = MultiInputDialog:new {
title = purpose == "delete"
and (scope == "movies" and "Find movie to delete" or "Find show to delete")
or (scope == "movies" and "Find Plex movie" or "Find Plex TV show"),
fields = { { text = "", hint = "Title (up to 80 characters)", input_type = "string" } },
buttons = {{
{ text = "Cancel", id = "close", callback = function() UIManager:close(dialog) end },
{ text = "Search", is_enter_default = true, callback = function()
local fields = dialog:getFields()
UIManager:close(dialog)
self:startSubtitleCatalog(scope, nil, fields[1], 0, nil, purpose)
end },
}},
}
UIManager:show(dialog)
end
function Dashboard:startSubtitleCatalog(scope, parent_id, query, offset, parent_title, purpose)
if self.active_subtitle_catalog then
self:notice("Wait for the current Plex selection list.", 7)
return
end
if not SUBTITLE_CATALOG_KINDS[scope] then return end
purpose = purpose == "delete" and "delete" or "subtitles"
if purpose == "delete" and scope ~= "movies" and scope ~= "shows" then return end
if not NetworkMgr:isConnected() then
self:notice("Wi-Fi is disconnected. Plex titles were not loaded.", 7)
return
end
local _, token_error = read_bearer_token(self.settings.control_token_file)
if token_error then
self:notice("Plex control token unavailable: " .. token_error, 7)
return
end
offset = type(offset) == "number" and offset % 1 == 0
and math.max(0, math.min(5000, offset)) or 0
local payload = { request_id = require("random").uuid(true):lower(),
scope = scope, offset = offset }
if scope == "movies" or scope == "shows" then
query = type(query) == "string" and query:gsub("[%c]", " ")
:match("^%s*(.-)%s*$") or ""
if #query > 80 then
self:notice("Search title is too long (80 characters maximum).", 7)
return
end
payload.query = query
else
if not positive_id(parent_id) then return end
payload.parent_id = parent_id
end
local body, code = self:requestRemote("/api/v1/plex/subtitles/catalog", "POST",
self.settings.control_token_file, require("json").encode(payload),
"application/json", MAX_JSON_BYTES)
if body and code ~= 202 then
local response = decode_json(body)
self:notice("Plex titles unavailable: "
.. safe_label(response and response.error, 90), 8)
return
end
self.active_subtitle_catalog = { id = payload.request_id, scope = scope,
parent_id = parent_id, parent_title = parent_title, query = query,
offset = offset, purpose = purpose, started_at = os.time() }
self:notice(body and "Loading Plex selections..."
or "Selection receipt uncertain; checking the same request ID.", 5)
UIManager:unschedule(self.subtitle_catalog_poll_task)
UIManager:scheduleIn(2, self.subtitle_catalog_poll_task)
end
function Dashboard:showSubtitleCatalog(result, pending)
local expected_kind = SUBTITLE_CATALOG_KINDS[pending.scope]
local deleting = pending.purpose == "delete"
local items = {}
for _, candidate in ipairs(result.items) do
if #items >= 50 then break end
if subtitle_item_valid(candidate, expected_kind) then
local item = candidate
local count = subtitle_file_count(item)
local suffix = count == 1 and "1 file" or (tostring(count) .. " files")
local title = safe_label(item.title, 65)
if type(item.index) == "number" and item.index % 1 == 0
and item.index >= 0 and item.index <= 9999
and (expected_kind == "season" or expected_kind == "episode") then
title = (expected_kind == "season" and "Season " or "Episode ")
.. tostring(item.index) .. " · " .. title
end
items[#items + 1] = { text = title .. " · " .. suffix
.. (deleting and "" or (" · tracks: " .. subtitle_languages(item))),
enabled_func = function()
return count > 0 or (not deleting
and (item.kind == "show" or item.kind == "season"))
end,
close_on_select = true,
callback = function()
if deleting then self:showPlexDeleteTitle(item)
elseif item.kind == "show" then self:showSubtitleShow(item)
elseif item.kind == "season" then self:showSubtitleSeason(item)
else self:confirmSubtitleGeneration(item) end
end }
end
end
if #items == 0 then
items[1] = { text = "No matching Plex items with usable details",
enabled_func = function() return false end }
end
if pending.offset > 0 then
items[#items + 1] = { text = "Previous selections", close_on_select = true,
callback = function()
self:startSubtitleCatalog(pending.scope, pending.parent_id,
pending.query, math.max(0, pending.offset - 50),
pending.parent_title, pending.purpose)
end }
end
if #result.items > 0 and pending.offset + #result.items < result.total then
items[#items + 1] = { text = "More selections", close_on_select = true,
callback = function()
self:startSubtitleCatalog(pending.scope, pending.parent_id,
pending.query, pending.offset + #result.items,
pending.parent_title, pending.purpose)
end }
end
local label = ({ movies = "Plex movies", shows = "Plex TV shows",
seasons = "TV seasons", episodes = "TV episodes" })[pending.scope]
if deleting then
label = pending.scope == "movies" and "Select movie to delete"
or "Select show to delete"
end
if pending.parent_title then label = label .. " · " .. safe_label(pending.parent_title, 40) end
self:showQuickMenu(label, items)
end
function Dashboard:pollSubtitleCatalog()
local pending = self.active_subtitle_catalog
if not pending or not self.running or self.suspended then return end
local body, code = self:requestRemote("/api/v1/plex/subtitles/catalog/" .. pending.id,
"GET", self.settings.control_token_file, nil, "application/json", MAX_JSON_BYTES)
if body and code == 200 then
local result = decode_json(body)
if type(result) == "table" and result.id == pending.id then
if result.state == "completed" then
self.active_subtitle_catalog = nil
if type(result.items) == "table" and #result.items <= 50
and type(result.total) == "number" and result.total % 1 == 0
and result.total >= 0 and type(result.offset) == "number"
and result.offset == pending.offset then
self:showSubtitleCatalog(result, pending)
else
self:notice("Plex selection list was invalid.", 8)
end
return
elseif result.state == "failed" or result.state == "rejected"
or result.state == "unknown" or result.state == "expired" then
self.active_subtitle_catalog = nil
self:notice("Plex selection list " .. result.state .. ": "
.. safe_label(result.detail, 80), 8)
return
end
end
elseif body and (code == 401 or code == 403) then
self.active_subtitle_catalog = nil
self:notice("Plex control token was rejected.", 8)
return
end
if os.time() - pending.started_at >= 120 then
self.active_subtitle_catalog = nil
self:notice("Plex selection list timed out. Reopen subtitles to try again.", 8)
return
end
UIManager:scheduleIn(3, self.subtitle_catalog_poll_task)
end
function Dashboard:showSubtitleShow(item)
local count = subtitle_file_count(item) or 0
self:showQuickMenu("TV show · " .. safe_label(item.title, 55), {
{ text = tostring(count) .. " current files · tracks: " .. subtitle_languages(item),
enabled_func = function() return false end },
{ text = "Add subtitles to whole show (" .. tostring(count) .. " files)",
enabled_func = function() return count > 0 end, close_on_select = true,
callback = function() self:confirmSubtitleGeneration(item) end },
{ text = "Choose a season", close_on_select = true,
callback = function() self:startSubtitleCatalog("seasons", item.id,
nil, 0, item.title) end },
})
end
local function plex_deletion_item_valid(item)
return type(item) == "table"
and (item.kind == "movie" or item.kind == "show")
and subtitle_item_valid(item, item.kind)
and subtitle_file_count(item) > 0
end
function Dashboard:showPlexDeleteTitle(item)
if not plex_deletion_item_valid(item) then
self:notice("This Plex title has no eligible media files to delete.", 8)
return
end
local whole = item.kind == "show" and "whole TV show" or "whole movie"
local count = subtitle_file_count(item)
self:showQuickMenu("Delete " .. whole .. " · " .. safe_label(item.title, 50), {
{ text = tostring(count) .. (count == 1 and " media file" or " media files")
.. " currently in Plex", enabled_func = function() return false end },
{ text = item.kind == "show" and "Includes every season and episode"
or "Includes every version of this movie",
enabled_func = function() return false end },
{ text = "Delete " .. whole .. " from library and storage",
close_on_select = true,
callback = function() self:confirmPlexDelete(item) end },
})
end
function Dashboard:confirmPlexDelete(item)
if not plex_deletion_item_valid(item) then
self:notice("This Plex title has no eligible media files to delete.", 8)
return
end
local state, reason = self:getPlexStatus()
if not state or state.stale or state.plex.state ~= "online" then
self:notice("Plex is unavailable: " .. tostring(reason or "stale media status"), 8)
return
end
local whole = item.kind == "show" and "entire TV show" or "entire movie"
local count = subtitle_file_count(item)
local title = safe_label(item.title, 160)
local scope = item.kind == "show" and "all seasons and episodes"
or "all versions of the movie"
UIManager:show(ConfirmBox:new {
text = "Delete " .. whole .. " \"" .. title .. "\""
.. " from the library and storage?"
.. " This removes " .. scope .. ": " .. tostring(count)
.. (count == 1 and " media file" or " media files")
.. " and their subtitle files, and removes the title from Sonarr/Radarr."
.. " Only an exact managed title will be deleted."
.. " Seerr request history stays. This dashboard cannot undo the deletion.",
ok_text = item.kind == "show" and "Delete whole show" or "Delete whole movie",
flush_events_on_show = true,
ok_callback = function()
local current, current_reason = self:getPlexStatus()
if not current or current.stale or current.plex.state ~= "online" then
self:notice("Plex changed before deletion: "
.. tostring(current_reason or "stale media status"), 8)
return
end
self:submitPlexCommand("delete_media", {
media_kind = item.kind,
item_id = item.id,
expected_title = item.title,
expected_file_count = count,
}, "Delete " .. safe_label(item.title, 48))
end,
})
end
function Dashboard:showSubtitleSeason(item)
local count = subtitle_file_count(item) or 0
self:showQuickMenu("TV season · " .. safe_label(item.title, 55), {
{ text = tostring(count) .. " current files · tracks: " .. subtitle_languages(item),
enabled_func = function() return false end },
{ text = "Add subtitles to whole season (" .. tostring(count) .. " files)",
enabled_func = function() return count > 0 end, close_on_select = true,
callback = function() self:confirmSubtitleGeneration(item) end },
{ text = "Choose an episode", close_on_select = true,
callback = function() self:startSubtitleCatalog("episodes", item.id,
nil, 0, item.title) end },
})
end
function Dashboard:confirmSubtitleGeneration(item)
if self.active_subtitle_job then
self:notice("A subtitle job is already running. Open its progress first.", 8)
return
end
if not subtitle_item_valid(item, item and item.kind)
or not ({ movie = true, show = true, season = true, episode = true })[item.kind]
or subtitle_file_count(item) == 0 then
self:notice("This Plex selection has no eligible media files.", 8)
return
end
local state, reason = self:getPlexStatus()
if not state or state.stale ~= false or state.plex.state ~= "online" then
self:notice("Plex is unavailable: " .. tostring(reason or "stale media status"), 8)
return
end
local count = subtitle_file_count(item)
local title = safe_label(item.title, 70)
UIManager:show(ConfirmBox:new {
text = "Add generated subtitles to " .. title .. " (" .. tostring(count)
.. (count == 1 and " file" or " files") .. ")?\n\n"
.. "This adds new subtitle tracks. Existing tracks and media files stay unchanged."
.. (count > 1 and " This may run for hours." or ""),
ok_text = "Add subtitle tracks",
ok_callback = function() self:submitSubtitleJob(item) end,
})
end
function Dashboard:submitSubtitleJob(item)
if self.active_subtitle_job or not subtitle_item_valid(item, item and item.kind)
or subtitle_file_count(item) == 0 then return end
local state, reason = self:getPlexStatus()
if not state or state.stale ~= false or state.plex.state ~= "online" then
self:notice("Plex changed before the subtitle request: "
.. tostring(reason or "status unavailable"), 8)
return
end
local _, token_error = read_bearer_token(self.settings.control_token_file)
if token_error then
self:notice("Plex control token unavailable: " .. token_error, 8)
return
end
local id = require("random").uuid(true):lower()
local label = safe_label(item.title, 90)
local pending = { id = id, label = label, state = "queued",
target_type = item.kind, target_id = item.id,
expected_file_count = subtitle_file_count(item) }
self.active_subtitle_job = pending
self.settings.subtitle_job = { id = id, label = label }
self:saveSettings()
local payload = { request_id = id, target_type = item.kind,
target_id = item.id, expected_file_count = pending.expected_file_count,
confirm = "ADD_SUBTITLES" }
local body, code = self:requestRemote("/api/v1/plex/subtitles/jobs", "POST",
self.settings.control_token_file, require("json").encode(payload),
"application/json", MAX_JSON_BYTES)
if code == 400 or code == 401 or code == 403 or code == 409 then
local response = decode_json(body)
self.active_subtitle_job = nil
self.settings.subtitle_job = nil
self:saveSettings()
self:notice("Subtitle job rejected (HTTP " .. tostring(code) .. "): "
.. safe_label(response and response.error, 90), 9)
return
end
self:notice(code == 202 and "Subtitle job queued. Open progress from Plex / Services."
or "Subtitle receipt uncertain; checking the same job ID.", 8)
UIManager:unschedule(self.subtitle_job_poll_task)
UIManager:scheduleIn(2, self.subtitle_job_poll_task)
end
local function subtitle_progress_line(job)
local progress = type(job.progress) == "table" and job.progress or {}
local completed = tonumber(progress.completed) or 0
local total = tonumber(progress.total) or job.expected_file_count or 0
local failed = tonumber(progress.failed) or 0
return tostring(completed) .. "/" .. tostring(total) .. " files · "
.. tostring(failed) .. " failed"
end
function Dashboard:showSubtitleProgress()
local job = self.active_subtitle_job or self.last_subtitle_job
if not job then
self:notice("No subtitle generation job is recorded on this Kindle.", 7)
return
end
local items = {
{ text = "Adds tracks only; existing subtitles stay unchanged",
enabled_func = function() return false end },
{ text = "State: " .. safe_label(job.state or "checking", 20),
enabled_func = function() return false end },
{ text = "Progress: " .. subtitle_progress_line(job),
enabled_func = function() return false end },
{ text = "Tracks added: " .. tostring(tonumber(job.added_tracks) or 0),
enabled_func = function() return false end },
}
if type(job.progress) == "table" and type(job.progress.current_title) == "string"
and job.progress.current_title ~= "" then
items[#items + 1] = { text = "Current: "
.. safe_label(job.progress.current_title, 80),
enabled_func = function() return false end }
end
if job.detail then
items[#items + 1] = { text = "Detail: " .. safe_label(job.detail, 80),
enabled_func = function() return false end }
end
if self.active_subtitle_job then
items[#items + 1] = { text = "Refresh progress", close_on_select = true,
callback = function()
self:pollSubtitleJob()
self:showSubtitleProgress()
end }
end
self:showQuickMenu("Subtitles · " .. safe_label(job.label, 52), items)
end
function Dashboard:pollSubtitleJob()
local pending = self.active_subtitle_job
if not pending or not self.running or self.suspended then return end
local body, code = self:requestRemote("/api/v1/plex/subtitles/jobs/" .. pending.id,
"GET", self.settings.control_token_file, nil, "application/json", MAX_JSON_BYTES)
if body and code == 200 then
local result = decode_json(body)
if type(result) == "table" and result.id == pending.id
and SUBTITLE_JOB_STATES[result.state] then
pending.state = result.state
pending.detail = result.detail
pending.progress = type(result.progress) == "table" and result.progress or nil
pending.added_tracks = tonumber(result.added_tracks) or 0
local update = pending.state .. ":" .. subtitle_progress_line(pending)
if update ~= pending.last_update then
pending.last_update = update
self:notice("Subtitles " .. update, 6)
end
if SUBTITLE_TERMINAL_STATES[pending.state] then
self.last_subtitle_job = pending
self.active_subtitle_job = nil
self.settings.subtitle_job = nil
self:saveSettings()
if pending.state == "unknown" then
self:notice("Subtitle outcome uncertain. No automatic retry. Inspect progress before a new request.", 10)
else
self:notice("Subtitle job " .. pending.state .. ": "
.. tostring(pending.added_tracks) .. " tracks added, "
.. subtitle_progress_line(pending), 10)
end
return
end
end
elseif body and (code == 401 or code == 403) then
self:notice("Plex control token was rejected; subtitle job ID is saved.", 10)
end
UIManager:scheduleIn(30, self.subtitle_job_poll_task)
end
function Dashboard:showPlexReceipt()
local pending = self.active_plex_command
if not pending then
self:notice(self.plex_receipt_error
and "Private Plex receipt storage is unreadable. Restore it from backup or use root / USB recovery."
.. " New actions stay blocked; no action was resent."
or "No saved Plex action is pending.", 10)
return
end
self:showQuickMenu("Saved Plex action", {
{ text = pending.label, enabled_func = function() return false end },
{ text = "Request ID: " .. pending.id, enabled_func = function() return false end },
{ text = "Checks this receipt only; never resends the action",
enabled_func = function() return false end },
{ text = "Check outcome", close_on_select = true,
callback = function() self:pollPlexCommand() end },
{ text = "Action: " .. pending.action,
enabled_func = function() return false end },
{ text = self:plexReceiptContext(pending),
enabled_func = function() return false end },
{ text = "I checked Plex / Seerr · reconcile this receipt",
enabled_func = function() return self:plexReceiptMayReconcile(pending) end,
close_on_select = true,
callback = function() self:confirmPlexReceiptReconciliation(pending) end },
})
end
function Dashboard:plexReceiptMayReconcile(pending)
return type(pending) == "table" and PLEX_RECEIPT_ACTIONS[pending.action]
and (pending.never_dispatched == true or pending.prequeue_refused_code ~= nil
or pending.remote_state == "unknown" or pending.receipt_absent == true
or os.time() - pending.started_at >= 120)
end
function Dashboard:plexReceiptContext(pending)
if pending.never_dispatched then return "Not sent: private receipt storage failed before POST." end
local details = type(pending.payload) == "table" and pending.payload or {}
local rows = {}
for _, key in ipairs({ "media_type", "tmdb_id", "seasons", "storage_id",
"seerr_request_id", "expected_media_type", "expected_tmdb_id",
"library_id", "expected_name", "service_id", "cache_id" }) do
local value = details[key]
if type(value) == "table" then value = table.concat(value, ", ") end
if value ~= nil then rows[#rows + 1] = key .. ": " .. tostring(value) end
end
return #rows > 0 and table.concat(rows, "\n") or "Inspect the named action in Plex / Seerr."
end
function Dashboard:confirmPlexReceiptReconciliation(pending)
if self.active_plex_command ~= pending or not self:plexReceiptMayReconcile(pending) then return end
UIManager:show(ConfirmBox:new {
text = "Reconcile the local receipt for " .. pending.label .. "?\nAction: "
.. pending.action .. "\nRequest ID: " .. pending.id .. "\n"
.. self:plexReceiptContext(pending)
.. "\n\nConfirm only after checking actual Plex / Seerr state and verifying"
.. " this action is no longer pending. Clearing this local lock does not"
.. " cancel server work or prove the action succeeded. No action will be resent.",
ok_text = "I checked · clear local receipt",
flush_events_on_show = true,
ok_callback = function()
if self.active_plex_command ~= pending or not self:plexReceiptMayReconcile(pending) then return end
local previous = { schema = 1, state = "pending", id = pending.id,
action = pending.action, label = pending.label, started_at = pending.started_at,
payload = pending.payload }
local acknowledgement = { schema = 1, state = "clear",
operator_acknowledgement = { id = pending.id, action = pending.action,
acknowledged_at = os.time(), reason = "checked_actual_state" },
previous_receipt = previous }
if not write_plex_receipt(acknowledgement) then
self.plex_receipt_error = true
self:notice("Reconciliation could not be saved. Receipt stays locked; no action was sent.", 10)
UIManager:unschedule(self.plex_command_poll_task)
UIManager:scheduleIn(30, self.plex_command_poll_task)
return
end
UIManager:unschedule(self.plex_command_poll_task)
self.active_plex_command = nil
self.plex_receipt_error = false
self:notice("Local receipt reconciled after your review. No action was resent; success was not assumed.", 10)
end,
})
end
function Dashboard:showPlexMenu(offset, current_state)
if not self.running then return end
offset = type(offset) == "number" and math.max(0, math.floor(offset)) or 0
local state, reason = current_state, nil
if not state then state, reason = self:getPlexStatus() end
if not state then
self:notice("Plex status unavailable: " .. tostring(reason), 8)
local items = {
{ text = "Now Playing", close_on_select = true,
callback = function() self:showPlexStreams() end },
{ text = "Windows / GPU / subtitle jobs", close_on_select = true,
callback = function() self:showWindowsStatus() end },
{ text = "Media request tracker", close_on_select = true,
callback = function() self:showMediaInsights("acquisition") end },
{ text = "SSD health", close_on_select = true,
callback = function() self:showMediaInsights("storage") end },
{ text = "Optional ebooks", close_on_select = true,
callback = function() self:showOptionalEbooks() end },
}
if self.active_plex_command or self.plex_receipt_error then
table.insert(items, 1, { text = "Saved Plex action", close_on_select = true,
callback = function() self:showPlexReceipt() end })
end
self:showQuickMenu("Plex / Services", items)
return
end
local plex = state.plex
local seerr = state.seerr
local can_control = state.stale == false and seerr.state == "online"
local stream_count = tonumber(plex.active_streams)
local pending_count = tonumber(seerr.pending_count)
local items = {
{ text = "Plex " .. safe_label(plex.state, 20) .. " · "
.. (stream_count and tostring(stream_count) or "unknown") .. " active streams",
enabled_func = function() return false end },
{ text = "Seerr " .. safe_label(seerr.state, 20) .. " · "
.. (pending_count and tostring(pending_count) or "unknown") .. " pending",
enabled_func = function() return false end },
{ text = "Windows / GPU / subtitle jobs", close_on_select = true,
callback = function() self:showWindowsStatus() end },
{ text = "Media request tracker", close_on_select = true,
callback = function() self:showMediaInsights("acquisition") end },
{ text = "SSD health", close_on_select = true,
callback = function() self:showMediaInsights("storage") end },
{ text = "Saved Plex action", enabled_func = function()
return self.active_plex_command ~= nil or self.plex_receipt_error == true end,
close_on_select = true, callback = function() self:showPlexReceipt() end },
{ text = "Search and request a title",
enabled_func = function() return can_control end,
close_on_select = true,
callback = function() self:showPlexSearchPrompt() end },
{ text = "Add subtitle tracks", close_on_select = true,
callback = function() self:showSubtitleMenu() end },
{ text = "Optional ebooks · check health / start / stop", close_on_select = true,
callback = function() self:showOptionalEbooks() end },
{ text = "Delete a whole movie or TV show",
enabled_func = function() return state.stale == false
and plex.state == "online" end,
close_on_select = true,
callback = function() self:showPlexDeleteMenu() end },
{ text = "Libraries and scan controls", close_on_select = true,
callback = function() self:showPlexLibraries(state) end },
{ text = "Now Playing", close_on_select = true,
callback = function() self:showPlexStreams(state) end },
{ text = "Storage and service health", close_on_select = true,
callback = function() self:showPlexHealth(state) end },
{ text = "Maintenance", close_on_select = true,
callback = function() self:showPlexMaintenance() end },
}
if state.stale then
items[#items + 1] = { text = "Media data is stale; controls paused",
enabled_func = function() return false end }
end
local pending = type(seerr.pending) == "table" and seerr.pending or {}
local count = 0
for index, request in ipairs(pending) do
if index > offset + 10 then break end
if index > offset then
if type(request) == "table" and positive_id(request.id)
and positive_id(request.tmdb_id)
and (request.media_type == "movie" or request.media_type == "tv") then
local row = request
items[#items + 1] = {
text = "Approve: " .. safe_label(row.title, 58)
.. " (" .. row.media_type .. ")",
enabled_func = function() return can_control end,
close_on_select = true,
callback = function() self:confirmPlexApprove(row) end,
}
count = count + 1
end
end
end
if count == 0 and offset == 0 then
items[#items + 1] = { text = "No pending requests",
enabled_func = function() return false end }
end
if offset > 0 then
items[#items + 1] = { text = "Previous pending requests",
close_on_select = true,
callback = function() self:showPlexMenu(math.max(0, offset - 10)) end }
end
if #pending > offset + 10 then
items[#items + 1] = { text = "More pending requests",
close_on_select = true,
callback = function() self:showPlexMenu(offset + 10) end }
elseif pending_count and pending_count > #pending then
items[#items + 1] = { text = "Showing first " .. #pending .. " of "
.. pending_count .. "; refresh after decisions for more",
enabled_func = function() return false end }
end
self:showQuickMenu("Plex / Services", items)
end
function Dashboard:showPlexPipeline(state, selected)
local pipeline = type(state.pipeline) == "table" and state.pipeline or {}
local components = type(pipeline.components) == "table" and pipeline.components or {}
local rows = {
{ "Docker / Arr", "media_ready", 1 },
{ "Plex collector", "collector_running", 3 },
{ "Public relay", "public_relay_healthy", 4 },
{ "Printers / cameras", "printer_relay_ready", 5 },
{ "Plex / Seerr", "plex_relay_ready", 6 },
{ "Print Doctor", "print_doctor_running", 7 },
}
local items = {
{ text = "Overall: " .. safe_label(pipeline.state, 24)
.. (state.stale and " · snapshot stale" or ""),
enabled_func = function() return false end },
{ text = "Last checked: " .. (type(pipeline.age_seconds) == "number"
and tostring(math.floor(pipeline.age_seconds)) .. " seconds ago" or "unknown"),
enabled_func = function() return false end },
}
local selected_title
for _, row in ipairs(rows) do
local value = components[row[2]]
local label = value == true and "READY" or (value == false and "FAILED" or "UNKNOWN")
if row[3] == selected then selected_title = row[1] end
items[#items + 1] = { text = (row[3] == selected and "→ " or "")
.. row[1] .. ": " .. label,
enabled_func = function() return false end }
end
items[#items + 1] = { text = "Storage and service health", close_on_select = true,
callback = function() self:showPlexHealth(state) end }
items[#items + 1] = { text = "Maintenance", close_on_select = true,
callback = function() self:showPlexMaintenance() end }
self:showQuickMenu(selected_title or "Pipeline readiness", items)
end
function Dashboard:showPlexServerCard(state)
local plex = state.plex
local items = {
{ text = "Windows / GPU / subtitle jobs", close_on_select = true,
callback = function() self:showWindowsStatus() end },
{ text = "Media request tracker", close_on_select = true,
callback = function() self:showMediaInsights("acquisition") end },
{ text = "SSD health", close_on_select = true,
callback = function() self:showMediaInsights("storage") end },
{ text = safe_label(plex.server_name, 55) .. " · " .. safe_label(plex.state, 20),
enabled_func = function() return false end },
{ text = "Active streams: " .. tostring(plex.active_streams or "unknown"),
enabled_func = function() return false end },
{ text = "Libraries and scan controls", close_on_select = true,
callback = function() self:showPlexLibraries(state) end },
{ text = "Now Playing", close_on_select = true,
callback = function() self:showPlexStreams(state) end },
{ text = "Add subtitle tracks", close_on_select = true,
callback = function() self:showSubtitleMenu() end },
{ text = "Delete a whole movie or TV show",
enabled_func = function() return state.stale == false
and plex.state == "online" end,
close_on_select = true,
callback = function() self:showPlexDeleteMenu() end },
{ text = "Refresh library metadata", close_on_select = true,
callback = function() self:showPlexMetadataMenu() end },
{ text = "Media maintenance", close_on_select = true,
callback = function() self:showPlexMaintenance() end },
}
self:showQuickMenu("Plex server", items)
end
function Dashboard:showPlexRequestsCard(state)
local seerr = state.seerr
local can_control = state.stale == false and seerr.state == "online"
local items = {
{ text = "Seerr " .. safe_label(seerr.state, 20) .. " · "
.. tostring(seerr.pending_count or "unknown") .. " pending",
enabled_func = function() return false end },
{ text = "Search and request a title", enabled_func = function() return can_control end,
close_on_select = true,
callback = function() self:showPlexSearchPrompt() end },
{ text = "Track all media requests", close_on_select = true,
callback = function() self:showMediaInsights("acquisition") end },
}
for _, request in ipairs(type(seerr.pending) == "table" and seerr.pending or {}) do
if #items >= 12 then break end
if type(request) == "table" and positive_id(request.id)
and positive_id(request.tmdb_id)
and (request.media_type == "movie" or request.media_type == "tv") then
local row = request
items[#items + 1] = { text = "Approve: " .. safe_label(row.title, 58),
enabled_func = function() return can_control end,
close_on_select = true,
callback = function() self:confirmPlexApprove(row) end }
end
end
if #items == 3 then
items[#items + 1] = { text = "No visible pending requests",
enabled_func = function() return false end }
end
self:showQuickMenu("Seerr requests", items)
end
function Dashboard:showPlexDriveCard(state, drive)
local free = type(drive.free_bytes) == "number" and
string.format("%.1f GiB free", drive.free_bytes / 1073741824)
or "capacity unavailable"
self:showQuickMenu(safe_label(drive.drive, 4) .. " " .. safe_label(drive.name, 46), {
{ text = "State: " .. safe_label(drive.state, 30),
enabled_func = function() return false end },
{ text = "Volume: " .. safe_label(drive.label, 48) .. " · " .. free,
enabled_func = function() return false end },
{ text = drive.id == "c" and "Downloads stage here"
or "Finished media may be stored here",
enabled_func = function() return false end },
{ text = "Search and request media", enabled_func = function()
return state.stale == false and state.seerr.state == "online" end,
close_on_select = true,
callback = function() self:showPlexSearchPrompt() end },
{ text = "All storage and services", close_on_select = true,
callback = function() self:showPlexHealth(state) end },
})
end
function Dashboard:showPlexServiceCard(state, service)
local allowed = ({ seerr = true, sonarr = true,
radarr = true, prowlarr = true })[service.id]
local restartable = service.state == "healthy" or service.state == "running"
or service.state == "unhealthy"
or (service.state == "stopped" and
(service.id == "seerr" or service.id == "prowlarr"))
local can_restart = allowed and state.stale == false
and restartable
and type(state.plex.active_streams) == "number"
and state.plex.active_streams == 0
local verb = service.state == "stopped" and "Start" or "Restart"
self:showQuickMenu(safe_label(service.id, 32), {
{ text = "Service state: " .. safe_label(service.state, 30),
enabled_func = function() return false end },
{ text = verb .. " service", enabled_func = function() return can_restart end,
close_on_select = true,
callback = function()
self:confirmPlexMaintenance("restart_service",
{ service_id = service.id }, verb .. " " .. service.id,
verb .. " " .. service.id .. "? It may pause related tasks briefly.")
end },
{ text = "All storage and services", close_on_select = true,
callback = function() self:showPlexHealth(state) end },
{ text = "Maintenance", close_on_select = true,
callback = function() self:showPlexMaintenance() end },
})
end
function Dashboard:showPlexActionAt(pos)
local x, y = self:imageTapCoordinates(pos)
if not x then self:showPlexMenu(); return end
local state, reason = self:getPlexStatus()
if not state then
self:notice("Media details unavailable: " .. tostring(reason), 8)
return
end
if state.layout_version ~= 1 then
self:showPlexMenu(nil, state)
return
end
if x >= 55 and x < 1209 and y >= 268 and y < 633 then
local selected
if y >= 410 and y < 610 then
local column = x >= 640 and 1 or 0
local row = math.floor((y - 410) / 51) + 1
local index = column * 4 + row
if index >= 1 and index <= 7 and index ~= 2 then selected = index end
end
self:showPlexPipeline(state, selected)
elseif y >= 652 and y < 887 and x >= 55 and x < 619 then
self:showPlexServerCard(state)
elseif y >= 652 and y < 887 and x >= 641 and x < 1209 then
self:showPlexRequestsCard(state)
elseif x >= 55 and x < 1209 and y >= 906 and y < 1241 then
local index = y >= 982 and y < 1210 and math.floor((y - 982) / 76) + 1
local drive = index and state.drives[index]
if type(drive) == "table" then
self:showPlexDriveCard(state, drive)
else
self:showPlexHealth(state)
end
elseif x >= 55 and x < 1209 and y >= 1259 and y < 1599 then
local column = x >= 652 and x < 1209 and 1 or (x >= 82 and x < 625 and 0 or nil)
local row = y >= 1340 and y < 1565 and math.floor((y - 1340) / 54) or nil
local service = column and row and row <= 3 and state.services[column * 4 + row + 1]
if type(service) == "table" then
self:showPlexServiceCard(state, service)
else
self:showPlexHealth(state)
end
else
self:showPlexMenu(nil, state)
end
end
do
local states={operational=true,degraded=true,unavailable=true,held=true,unknown=true}
local check_states={pass=true,degraded=true,fail=true,held=true,unknown=true}
local perspectives={external=true,origin=true,pipeline=true}
local monitor_states={current=true,stale=true,unknown=true}
local reason_codes={verified=true,http_failed=true,tls_failed=true,deadline_exceeded=true,
dependency_unavailable=true,source_delayed=true,source_missing=true,operator_hold=true,
capacity_limited=true,not_configured=true,probe_failed=true,probe_stale=true,
monitor_stale=true,monitor_missing=true,monitor_invalid=true,clock_skew=true,missing_check=true}
local function fields(value,allowed)
if type(value)~="table" then return false end
for key in pairs(value) do if not allowed[key] then return false end end
return true
end
local function string_value(value,maximum)
return type(value)=="string" and #value>=1 and #value<=maximum and not value:find("[^ -~]")
end
local function number_value(value,maximum,nullable)
if nullable and (value==nil or json_is_null(value)) then return true end
return type(value)=="number" and value==value and value>=0 and value<=maximum
end
local function array_value(value,maximum,validator)
if type(value)~="table" or #value>maximum then return false end
for key,row in pairs(value) do
if type(key)~="number" or key%1~=0 or key<1 or key>#value or not validator(row) then return false end
end
return true
end
local function expected_state(values)
for _,pair in ipairs({{"fail","unavailable"},{"degraded","degraded"},{"held","held"},{"unknown","unknown"}}) do
for _,state in pairs(values) do if state==pair[1] then return pair[2] end end
end
return "operational"
end
local function readiness_valid(value)
if not fields(value,{schema_version=true,generated_at=true,age_seconds=true,monitor_state=true,
monitor_reason=true,status=true,semantics=true,services=true,history=true}) or value.schema_version~=1
or not states[value.status] or not monitor_states[value.monitor_state]
or not number_value(value.generated_at,10000000000,true) or not number_value(value.age_seconds,10000000000,true)
or not string_value(value.semantics,180) then return false end
if value.monitor_state=="current" and (value.generated_at==nil or json_is_null(value.generated_at)
or value.age_seconds==nil or json_is_null(value.age_seconds)) then return false end
if value.monitor_reason~=nil and not json_is_null(value.monitor_reason) and not reason_codes[value.monitor_reason] then return false end
local seen={}
local services_valid=array_value(value.services,32,function(service)
if not fields(service,{id=true,name=true,state=true,summary=true,perspectives=true,checks=true})
or not string_value(service.id,48) or not service.id:match("^[a-z][a-z0-9-]*$") or seen[service.id]
or not string_value(service.name,64) or not states[service.state] or not string_value(service.summary,160)
or type(service.perspectives)~="table" then return false end
seen[service.id]=true
local count=0
for key,state in pairs(service.perspectives) do
if not perspectives[key] or not check_states[state] then return false end
count=count+1
end
if count<1 or count>3 or expected_state(service.perspectives)~=service.state then return false end
local checked={}
return array_value(service.checks,3,function(check)
if not fields(check,{id=true,perspective=true,state=true,reason=true,age_seconds=true,
observed_at=true,latency_ms=true,summary=true}) or not perspectives[check.perspective]
or checked[check.perspective] or check.id~=service.id..":"..check.perspective
or check.state~=service.perspectives[check.perspective] or not reason_codes[check.reason]
or not string_value(check.summary,160) or not number_value(check.age_seconds,10000000000,true)
or not number_value(check.observed_at,10000000000,true) or not number_value(check.latency_ms,60000,true) then return false end
if check.state~="unknown" and (check.observed_at==nil or json_is_null(check.observed_at)
or check.age_seconds==nil or json_is_null(check.age_seconds)) then return false end
if check.state=="pass" and check.reason~="verified" then return false end
checked[check.perspective]=true
return true
end) and #service.checks==count
end)
if not services_valid then return false end
if value.history==nil then return true end
local history=value.history
if not fields(history,{state=true,age_seconds=true,events=true})
or not ({current=true,stale=true,unknown=true,unavailable=true})[history.state]
or not number_value(history.age_seconds,10000000000,true) then return false end
return array_value(history.events,48,function(event)
return fields(event,{service_id=true,at=true,from=true,to=true,kind=true}) and seen[event.service_id]
and number_value(event.at,10000000000,false) and states[event.from] and states[event.to]
and event.from~=event.to and (event.kind=="change" or event.kind=="recovery" and event.to=="operational")
end)
end
local function seconds(value)
if value==nil or json_is_null(value) then return "not observed" end
return tostring(math.floor(value)).." seconds"
end
function Dashboard:showServiceReadinessDetail(key,data,service)
if not readiness_valid(data.readiness) then self:notice("Readiness observations did not validate; refresh this status tab.",8);return end
local labels={external="PUBLIC REACHABILITY",origin="ORIGIN READINESS",pipeline="REQUIRED DATA FRESHNESS"}
local value=data.readiness
local lines={service.name.." - "..service.state:upper(),service.summary,"",
"MONITOR: "..value.monitor_state:upper(),"Snapshot age: "..seconds(value.age_seconds),"",
"A responding page alone does not prove that its API and data pipeline are ready."}
for _,check in ipairs(service.checks) do
lines[#lines+1]="\n"..labels[check.perspective].." - "..check.state:upper()
lines[#lines+1]=check.summary
lines[#lines+1]="Check age: "..seconds(check.age_seconds)
if not json_is_null(check.latency_ms) and check.latency_ms~=nil then lines[#lines+1]="Observed request latency: "..tostring(check.latency_ms).." ms" end
end
lines[#lines+1]="\nMONITOR TRANSITION HISTORY - LAST 24 HOURS"
local history=value.history
if history==nil or history.state=="unavailable" then
lines[#lines+1]="Monitor history is unavailable. Existing service incidents remain in Alerts > History."
else
lines[#lines+1]="History snapshot: "..history.state.." - "..seconds(history.age_seconds).." old"
local count=0
for _,event in ipairs(history.events) do
if event.service_id==service.id then
count=count+1
lines[#lines+1]=os.date("!%Y-%m-%d %H:%M:%S UTC",event.at).." - "..event.from.." to "..event.to.." ("..event.kind..")"
end
end
if count==0 then lines[#lines+1]="No retained transition for this service in the 24-hour history. This does not prove uninterrupted availability." end
end
lines[#lines+1]="\nA missing or expired observation cannot establish recovery."
self:showAlertText("Service readiness - scroll for all checks",lines)
end
function Dashboard:showServiceReadiness(key,current_data)
local data,reason=current_data,nil
if not data then data,reason=self:getStatusDetails(key) end
if not data then self:notice("Readiness unavailable: "..tostring(reason),8);return end
if not readiness_valid(data.readiness) then
self:notice("Service readiness is not configured or its observations did not validate. Existing status details remain available.",10);return
end
local value=data.readiness
local items={{text="Monitor: "..value.monitor_state.." - "..seconds(value.age_seconds).." old",enabled_func=function() return false end}}
for _,row in ipairs(value.services) do
local service=row
items[#items+1]={text=service.name.." - "..service.state,close_on_select=true,
callback=function() self:showServiceReadinessDetail(key,data,service) end}
end
items[#items+1]={text="Refresh readiness",close_on_select=true,callback=function() self:showServiceReadiness(key) end}
items[#items+1]={text="Existing Alerts history",close_on_select=true,callback=function()
self.alerts_mode="history";self.alerts_filter="All";self.alerts_offset=0
self:switchTab(tab_index_for_id("alerts"))
self:showAlertHistory()
end}
self:showQuickMenu("Service readiness",items)
end
end
function Dashboard:showStatusServiceMenu(key, data, offset)
offset = offset or 0
local rows = type(data.services) == "table" and data.services or {}
local items = {}
for index = offset + 1, math.min(#rows, offset + 12) do
local row = rows[index]
if type(row) == "table" then
local service = row
local state = key == "llm" and row.availability or row.status
local label = safe_label(row.name, 65) .. " · " .. safe_label(state, 20)
if key == "site" then
label = label .. " · " .. safe_label(row.latency_ms, 20) .. " ms"
end
items[#items + 1] = { text = label, close_on_select = true,
callback = function() self:showStatusServiceDetail(key, data, service) end }
end
end
if #items == 0 then
items[1] = { text = "No service details available", enabled_func = function() return false end }
end
if offset > 0 then
items[#items + 1] = { text = "Previous services", close_on_select = true,
callback = function() self:showStatusServiceMenu(key, data, math.max(0, offset - 12)) end }
end
if #rows > offset + 12 then
items[#items + 1] = { text = "More services", close_on_select = true,
callback = function() self:showStatusServiceMenu(key, data, offset + 12) end }
end
self:showQuickMenu(key == "llm" and "LLM services" or "Site services", items)
end
function Dashboard:getStatusDetails(key)
local path = "/api/v1/status/" .. key
local body, code = self:requestRemote(path, "GET", self.settings.token_file,
nil, "application/json", MAX_JSON_BYTES)
if not body or code ~= 200 then
return nil, "HTTP " .. tostring(code)
end
local data = decode_json(body)
if type(data) ~= "table" or data.schema_version ~= 1 or data.key ~= key then
return nil, "Status detail format changed"
end
return data
end
function Dashboard:showStatusServiceDetail(key, data, service)
local state = key == "llm" and service.availability or service.status
local items = {
{ text = "State: " .. safe_label(state, 24),
enabled_func = function() return false end },
}
if key == "site" then
for _, metric in ipairs({
{ "Latency", "latency_ms", " ms" }, { "CPU", "cpu_pct", "%" },
{ "Memory", "memory_pct", "%" }, { "Network", "network_pct", "%" },
}) do
items[#items + 1] = { text = metric[1] .. ": "
.. safe_label(service[metric[2]], 24) .. metric[3],
enabled_func = function() return false end }
end
end
items[#items + 1] = { text = "All services", close_on_select = true,
callback = function() self:showStatusServiceMenu(key, data, 0) end }
self:showQuickMenu(safe_label(service.name, 65), items)
end
function Dashboard:showStatusMetric(data, label, key, suffix)
local readings = type(data.readings) == "table" and data.readings or {}
self:showQuickMenu(label, {
{ text = "Current reading: " .. safe_label(readings[key], 30) .. suffix,
enabled_func = function() return false end },
{ text = data.stale and "Source data is stale" or "Source data is current",
enabled_func = function() return false end },
{ text = "All status readings", close_on_select = true,
callback = function() self:showStatusMenu("site", data) end },
})
end
function Dashboard:showStatusHotPath(data, path)
self:showQuickMenu("Hot path · " .. safe_label(path.path, 65), {
{ text = "Hits: " .. safe_label(path.hits, 24) .. " per minute",
enabled_func = function() return false end },
{ text = "Errors: " .. safe_label(path.error_pct, 24) .. "%",
enabled_func = function() return false end },
{ text = "Average latency: " .. safe_label(path.avg_latency_ms, 24) .. " ms",
enabled_func = function() return false end },
{ text = "All status readings", close_on_select = true,
callback = function() self:showStatusMenu("site", data) end },
})
end
function Dashboard:showStatusAccount(data, kind)
local account = type(data.account) == "table" and data.account or {}
local codex = kind == "codex"
self:showQuickMenu(codex and "Codex weekly use" or "OpenAI API balance", {
{ text = codex and safe_label(account.codex_weekly, 42)
or safe_label(account.api_balance, 42),
enabled_func = function() return false end },
{ text = codex and safe_label(account.codex_note, 90)
or safe_label(account.api_note, 90),
enabled_func = function() return false end },
})
end
function Dashboard:showStatusMenu(key, current_data)
local data, reason = current_data, nil
if not data then data, reason = self:getStatusDetails(key) end
if not data then
self:notice("Status details unavailable: " .. tostring(reason), 8)
return
end
local items = {
{ text = type(data.stale)~="boolean" and "Source freshness not reported" or (data.stale and "Source data is stale" or "Source data is current"),
enabled_func = function() return false end },
{ text = "Refresh this tab", close_on_select = true,
callback = function()
self.tab_cache[self.active_tab] = nil
self:schedulePoll(1)
end },
{ text = "Service readiness", close_on_select = true,
callback = function() self:showServiceReadiness(key, data) end },
{ text = "Inspect services", close_on_select = true,
callback = function() self:showStatusServiceMenu(key, data, 0) end },
}
if key == "site" and (type(data.readings)=="table" or type(data.account)=="table") then
local readings = type(data.readings) == "table" and data.readings or {}
local account = type(data.account) == "table" and data.account or {}
for _, metric in ipairs({
{ "Core RPM", "core_rpm" }, { "Core p95 latency", "core_p95_ms" },
{ "Error rate", "error_rate_pct" }, { "Sandbox sessions", "sandbox_sessions" },
{ "Core CPU", "core_cpu_pct" }, { "Core memory", "core_memory_pct" },
{ "Core network", "core_network_pct" }, { "E2B latency", "e2b_latency_ms" },
}) do
items[#items + 1] = { text = metric[1] .. ": " .. safe_label(readings[metric[2]], 24),
enabled_func = function() return false end }
end
items[#items + 1] = { text = "Codex weekly: " .. safe_label(account.codex_weekly, 36)
.. " · " .. safe_label(account.codex_note, 46),
enabled_func = function() return false end }
items[#items + 1] = { text = "API balance: " .. safe_label(account.api_balance, 36)
.. " · " .. safe_label(account.api_note, 46),
enabled_func = function() return false end }
for _, hot in ipairs(type(data.top_paths) == "table" and data.top_paths or {}) do
if type(hot) == "table" then
items[#items + 1] = { text = "Hot: " .. safe_label(hot.path, 65)
.. " · " .. safe_label(hot.hits, 12) .. "/min · "
.. safe_label(hot.error_pct, 12) .. "% err",
enabled_func = function() return false end }
end
end
end
self:showQuickMenu(key == "llm" and "LLM status" or "Site status", items)
end
function Dashboard:showStatusActionAt(pos, key)
local x, y = self:imageTapCoordinates(pos)
if not x then self:showStatusMenu(key); return end
local data, reason = self:getStatusDetails(key)
if not data then
self:notice("Status details unavailable: " .. tostring(reason), 8)
return
end
if data.layout_version ~= 1 then
self:showStatusMenu(key, data)
return
end
local top = data.stale and 374 or 280
if key == "llm" then
local first_row = top + 210
local column = x >= 653 and x < 1210 and 1
or (x >= 55 and x < 612 and 0 or nil)
local row = y >= first_row and y < first_row + 16 * 61
and math.floor((y - first_row) / 61) or nil
local services = type(data.services) == "table" and data.services or {}
local service = column and row and services[column * 16 + row + 1]
if type(service) == "table" then
self:showStatusServiceDetail(key, data, service)
else
self:showStatusMenu(key, data)
end
return
end
local metric_top = top + 157
local metric_row = y >= metric_top and y < metric_top + 212
and math.floor((y - metric_top) / 112) or nil
local metric_column = x >= 55 and x < 1223 and math.floor((x - 55) / 292) or nil
local metric_inside = metric_column and (x - 55) % 292 < 278
local metrics = {
{ "Core RPM", "core_rpm", " rpm" },
{ "Core p95 latency", "core_p95_ms", " ms" },
{ "Error rate", "error_rate_pct", "%" },
{ "Sandbox sessions", "sandbox_sessions", "" },
{ "Core CPU", "core_cpu_pct", "%" },
{ "Core memory", "core_memory_pct", "%" },
{ "Core network", "core_network_pct", "%" },
{ "E2B latency", "e2b_latency_ms", " ms" },
}
if metric_row and metric_inside and metric_column <= 3 then
local metric = metrics[metric_row * 4 + metric_column + 1]
if metric then self:showStatusMetric(data, metric[1], metric[2], metric[3]); return end
end
local service_top = top + 428
if x >= 55 and x < 1209 and y >= service_top and y < service_top + 4 * 90 then
local index = math.floor((y - service_top) / 90) + 1
local services = type(data.services) == "table" and data.services or {}
if type(services[index]) == "table" then
self:showStatusServiceDetail(key, data, services[index])
return
end
end
local path_top = top + 838
if x >= 55 and x < 1209 and y >= path_top and y < path_top + 3 * 71 then
local index = math.floor((y - path_top) / 71) + 1
local paths = type(data.top_paths) == "table" and data.top_paths or {}
if type(paths[index]) == "table" then
self:showStatusHotPath(data, paths[index])
return
end
end
local account_top = top + 1106
if y >= account_top and y < account_top + 111 then
if x >= 55 and x < 625 then
self:showStatusAccount(data, "codex")
return
elseif x >= 638 and x < 1208 then
self:showStatusAccount(data, "api")
return
end
end
self:showStatusMenu(key, data)
end
local function traffic_count(value)
if type(value) ~= "number" or value ~= value or value < 0 or value > 9007199254740991
or value % 1 ~= 0 then return "Unavailable" end
return string.format("%.0f", value)
end
function Dashboard:getTrafficDetails(page)
page = tonumber(page) or 1
if page % 1 ~= 0 or page < 1 or page > 100000 then return nil, "Invalid traffic page" end
local window = self.settings.traffic_window or "5m"
local view = self.settings.traffic_view or "pages"
local body, code = self:requestRemote("/api/v1/status/traffic?window=" .. window .. "&page=" .. tostring(page) .. "&view=" .. view,
"GET", self.settings.token_file, nil, "application/json", 64 * 1024)
if not body or code ~= 200 then return nil, "HTTP " .. tostring(code) end
local data = decode_json(body)
if type(data) ~= "table" or data.schema_version ~= 1 or data.key ~= "traffic"
or data.source ~= "origin" or data.window ~= window or data.view ~= view then return nil, "Traffic format changed" end
return data
end
function Dashboard:setTrafficWindow(window)
if window ~= "5m" and window ~= "1h" and window ~= "24h" then return end
self.settings.traffic_window = window
self.tab_cache[5] = nil
self.stable_polls[5] = 0
self:saveSettings()
self.last_request_at = 0
if self.running then self:schedulePoll(0.2) end
end
function Dashboard:setTrafficView(view)
if view ~= "pages" and view ~= "sites" then return end
self.settings.traffic_view = view
self.tab_cache[5] = nil
self.stable_polls[5] = 0
self:saveSettings()
self.last_request_at = 0
if self.running then self:schedulePoll(0.2) end
end
function Dashboard:showTrafficWindows()
local items = {}
for _, row in ipairs({ { "5m", "Last 5 minutes" }, { "1h", "Last hour" }, { "24h", "Last 24 hours" } }) do
local window = row[1]
items[#items + 1] = { text = row[2], close_on_select = true,
callback = function() self:setTrafficWindow(window) end }
end
self:showQuickMenu("Traffic time window", items)
end
function Dashboard:showTrafficRoute(data, row)
local items = {}
if data.view == "pages" then
for _, text in ipairs({ safe_label(row.host, 120), safe_label(row.path, 240),
"Page requests: " .. traffic_count(row.requests),
"Origin only / " .. safe_label(data.window, 8),
"Successful page GETs and redirects, including bots.",
data.stale and "Last successful snapshot is stale" or "Snapshot is current" }) do
items[#items + 1] = { text = text, enabled_func = function() return false end }
end
self:showQuickMenu("Website page", items)
return
end
for _, text in ipairs({ safe_label(row.host, 120), safe_label(row.path, 240),
"Service: " .. safe_label(row.service, 80),
safe_label(row.method, 16) .. " / " .. safe_label(row.request_kind, 24) .. " / " .. safe_label(row.client_kind, 24),
"Exact requests: " .. traffic_count(row.requests),
"4xx: " .. traffic_count(row.errors_4xx) .. " / 5xx: " .. traffic_count(row.errors_5xx),
"Response bytes: " .. traffic_count(row.bytes),
"Origin only / " .. safe_label(data.window, 8),
data.stale and "Last successful snapshot is stale" or "Snapshot is current" }) do
items[#items + 1] = { text = text, enabled_func = function() return false end }
end
self:showQuickMenu("Traffic path detail", items)
end
function Dashboard:showTrafficList(data, kind, offset)
offset = offset or 0
local rows = type(data[kind]) == "table" and data[kind] or {}
local items = {}
for index = offset + 1, math.min(#rows, offset + 12) do
local row = rows[index]
items[#items + 1] = { text = (kind == "services" and safe_label(row.id, 65) .. " / " or "")
.. safe_label(row.host, 100) .. " / " .. traffic_count(row.requests) .. " requests",
enabled_func = function() return false end }
end
if offset + 12 < #rows then
items[#items + 1] = { text = "More " .. kind, close_on_select = true,
callback = function() self:showTrafficList(data, kind, offset + 12) end }
end
self:showQuickMenu("Traffic " .. kind, items)
end
function Dashboard:showTrafficCoverage(data)
local coverage = type(data.coverage) == "table" and data.coverage or {}
local items = { { text = "Origin only. CDN cache hits and edge blocks are excluded.", enabled_func = function() return false end },
{ text = data.complete_window and "Full selected window collected" or "Partial window or collection gap", enabled_func = function() return false end },
{ text = "Browser labels are estimates of people.", enabled_func = function() return false end } }
for _, collector in ipairs(type(data.collectors) == "table" and data.collectors or {}) do
items[#items + 1] = { text = safe_label(collector.id, 60) .. ": " .. (collector.fresh and "reporting" or "delayed")
.. " / queued " .. traffic_count(collector.pending_events) .. " / missing logs " .. traffic_count(collector.missing_files),
enabled_func = function() return false end }
end
for _, host in ipairs(type(coverage.expected_hosts) == "table" and coverage.expected_hosts or {}) do
local reporting = false
for _, active in ipairs(type(coverage.collecting_hosts) == "table" and coverage.collecting_hosts or {}) do
if active == host then reporting = true; break end
end
items[#items + 1] = { text = safe_label(host, 120) .. (reporting and " / reporting" or " / awaiting collection"),
enabled_func = function() return false end }
end
self:showQuickMenu("Traffic collection coverage", items)
end
function Dashboard:showTrafficMenu(current_data, page)
local data, reason = current_data, nil
if not data then data, reason = self:getTrafficDetails(page or 1) end
local items = { { text = "Choose time window", close_on_select = true, callback = function() self:showTrafficWindows() end },
{ text = "Refresh traffic", close_on_select = true, callback = function() self.tab_cache[5] = nil; self.last_request_at = 0; self:schedulePoll(0.2) end } }
local details = self.settings.traffic_view == "sites"
items[#items + 1] = { text = details and "Show page overview" or "Show request details", close_on_select = true,
callback = function() self:setTrafficView(details and "pages" or "sites") end }
if not data or not data.available then
table.insert(items, 1, { text = "Traffic unavailable" .. (reason and ": " .. safe_label(reason, 70) or " / waiting for first snapshot"), enabled_func = function() return false end })
self:showQuickMenu("Site traffic", items)
return
end
local totals = type(data.totals) == "table" and data.totals or {}
table.insert(items, 1, { text = (data.stale and "STALE / " or "Current / ") .. safe_label(data.window, 8) .. " / origin only", enabled_func = function() return false end })
table.insert(items, 2, { text = data.view == "pages" and ("Page requests: " .. traffic_count(totals.requests) .. " / pages: " .. traffic_count(data.total_routes))
or ("Exact requests: " .. traffic_count(totals.requests) .. " / 5xx: " .. traffic_count(totals.errors_5xx)
.. " / 4xx: " .. traffic_count(totals.errors_4xx)), enabled_func = function() return false end })
items[#items + 1] = { text = "Sites with traffic", close_on_select = true, callback = function() self:showTrafficList(data, "hosts", 0) end }
if details then items[#items + 1] = { text = "Services with traffic", close_on_select = true, callback = function() self:showTrafficList(data, "services", 0) end } end
items[#items + 1] = { text = "Collection coverage", close_on_select = true, callback = function() self:showTrafficCoverage(data) end }
items[#items + 1] = { text = (details and "Path rows / page " or "Pages / page ") .. traffic_count(data.page) .. " of " .. traffic_count(math.max(1, tonumber(data.pages) or 0)), enabled_func = function() return false end }
for _, row in ipairs(type(data.routes) == "table" and data.routes or {}) do
items[#items + 1] = { text = safe_label(row.host, 55) .. " " .. safe_label(row.path, 80) .. " / " .. traffic_count(row.requests),
close_on_select = true, callback = function() self:showTrafficRoute(data, row) end }
end
if type(data.page) == "number" and data.page > 1 then
items[#items + 1] = { text = details and "Previous paths" or "Previous pages", close_on_select = true, callback = function() self:showTrafficMenu(nil, data.page - 1) end }
end
if type(data.page) == "number" and type(data.pages) == "number" and data.page < data.pages then
items[#items + 1] = { text = details and "Next paths" or "Next pages", close_on_select = true, callback = function() self:showTrafficMenu(nil, data.page + 1) end }
end
self:showQuickMenu("Site traffic", items)
end
function Dashboard:showQuickControls()
if not self.running or self.quick_menu_count > 0 then return end
if self.active_tab == 1 then
local module = DASHBOARD_MODULES[1]
self:showQuickMenu(module.title, module.menu_items(self))
return
end
if self.active_tab == 4 then
self:showPlexMenu()
return
end
if self.active_tab == 6 then self:showAlertsMenu(); return end
if self.active_tab == 5 then self:showTrafficMenu(); return end
if self.active_tab == 2 or self.active_tab == 3 then
self:showStatusMenu(self.active_tab == 2 and "llm" or "site")
return
end
local items = {
{ text = _("Printer controls"),
sub_item_table = DASHBOARD_MODULES[1].menu_items(self) },
}
for index, tab in ipairs(DASHBOARD_TABS) do
local selected = index
items[#items + 1] = { text = tab.label, close_on_select = true,
callback = function() self:switchTab(selected) end }
end
self:showQuickMenu(DASHBOARD_TABS[self.active_tab].label, items)
end
function Dashboard:showPlaceholder()
self.offline_banner = nil
self:showText("PLEX / SERVICES",
"This tab is ready for the Plex servers and associated services."
.. " Their status source has not been connected yet.")
end
function Dashboard:switchTab(index)
if type(index) ~= "number" or index % 1 ~= 0
or index < 1 or index > #DASHBOARD_TABS then return end
if index == self.active_tab then
if self.running then self:poll(true) end
return
end
self.active_tab = index
self.clean_refresh_pending = true
self.stable_polls = self.stable_polls or {}
self.stable_polls[index] = 0
self.settings.active_tab = DASHBOARD_TABS[index].id
self:saveSettings()
self:cancelPoll()
self.failure_count = 0
self.last_request_at = 0
self.offline_banner = nil
local tab = DASHBOARD_TABS[index]
if not self.running then return end
if tab.native then
self:renderAlerts(self.alerts_context or self.alerts_cache or { fetched_at = os.time() })
self:schedulePoll(0.2)
return
end
if not tab.path then
self:showPlaceholder()
return
end
self:showCachedOrConnecting(tab.label)
self:schedulePoll(0.2)
end
function Dashboard:poll(manual)
if not self.running or self.suspended then
return
end
if self.quick_menu_count > 0 or self.camera_view or self:dashboardCovered() then
self:schedulePoll(10)
return
end
local tab = DASHBOARD_TABS[self.active_tab]
if tab.native then self:pollAlerts(); return end
if not tab.path then
self:cancelPoll()
if self.view_kind ~= "text" then self:showPlaceholder() end
return
end
local now = os.time()
if manual and now - self.last_request_at < 10 then
return
end
self.last_request_at = now
self.stable_polls = self.stable_polls or {}
if manual then self.stable_polls[self.active_tab] = 0 end
self:cancelPoll()
if not NetworkMgr:isConnected() then
self.alerts_badge_stale = true
self.failure_count = self.failure_count + 1
self.stable_polls[self.active_tab] = 0
self:noteHealthFailure()
self:showOffline("Wi-Fi is disconnected.")
self:schedulePoll(self:retryPollDelay(true))
return
end
local result, reason, etag = self:fetchPng(tab)
self:scheduleAlertBadgeRefresh()
if result == "unchanged" then
self.failure_count = 0
self.stable_polls[self.active_tab] = math.min(2,
(self.stable_polls[self.active_tab] or 0) + 1)
local cache = self.tab_cache[self.active_tab]
cache.last_checked_at = os.time()
local had_offline_banner = self.offline_banner ~= nil
if had_offline_banner then self.clean_refresh_pending = true end
self.offline_banner = nil
if self.view_kind ~= "png" or had_offline_banner then
if not self:showPng(cache.png) then
self.failure_count = self.failure_count + 1
self:noteHealthFailure()
self:showOffline("Dashboard image could not be displayed")
self:schedulePoll(self:retryPollDelay(false)); return
end
end
self:noteHealthRefresh()
self:schedulePoll(self:normalPollDelay())
return
end
if result then
if self.offline_banner then self.clean_refresh_pending = true end
self.offline_banner = nil
if self:showPng(result) then
self.tab_cache[self.active_tab] = {
png = result, etag = etag, last_success_at = os.time(),
image_received_at = os.time(), last_checked_at = os.time(),
}
self:persistCachedPng(self.active_tab, result,
self.tab_cache[self.active_tab].last_success_at)
self:noteHealthRefresh()
self.failure_count = 0
self.stable_polls[self.active_tab] = 0
self:schedulePoll(self:normalPollDelay())
return
end
reason = "Dashboard image could not be displayed"
end
self.failure_count = self.failure_count + 1
self.stable_polls[self.active_tab] = 0
self:noteHealthFailure()
self:showOffline(reason or "Cannot reach dashboard hub")
self:schedulePoll(self:retryPollDelay(false))
end
function Dashboard:startDashboard(persist_auto_start, preserve_selected_tab)
self:applyKeepAliveDefault()
if self.running then
self:poll(true)
return
end
self.running = true
self.suspended = false
if not preserve_selected_tab and self.settings.landing_tab and self.settings.landing_tab ~= "last" then
self.active_tab = tab_index_for_id(self.settings.landing_tab)
end
self.clean_refresh_pending = true
self:applyNightDimming()
self:scheduleEverydayTick()
if persist_auto_start ~= false then self:setAutoStart(true) end
self:holdStandby()
self:showCachedOrConnecting(DASHBOARD_TABS[self.active_tab].label)
self:schedulePoll(0.2)
if self.active_command then
UIManager:scheduleIn(2, self.command_poll_task)
end
if self.active_doctor then
UIManager:scheduleIn(3, self.doctor_poll_task)
end
if self.active_plex_command then
UIManager:scheduleIn(2, self.plex_command_poll_task)
end
if self.active_ebook_job then UIManager:scheduleIn(2, self.ebook_poll_task) end
if self.active_plex_search then
UIManager:scheduleIn(2, self.plex_search_poll_task)
end
if self.active_plex_details then
UIManager:scheduleIn(2, self.plex_details_poll_task)
end
if self.active_subtitle_catalog then
UIManager:scheduleIn(2, self.subtitle_catalog_poll_task)
end
if self.active_subtitle_job then
UIManager:scheduleIn(2, self.subtitle_job_poll_task)
end
end
function Dashboard:stopDashboard()
self.running = false
self:cancelEverydayTick()
self:releaseNightDimming()
self:closePrinterControls()
self:cancelPrinterSends()
self:closePlexNowPlaying()
self:closeMediaTracker()
if self.alert_badge_task then UIManager:unschedule(self.alert_badge_task); self.alert_badge_task = nil end
if self.alerts_quiet_dialog then UIManager:close(self.alerts_quiet_dialog) end
if self.alerts_view then UIManager:close(self.alerts_view) end
if self.brightness_dialog then UIManager:close(self.brightness_dialog) end
if self.night_schedule_dialog then UIManager:close(self.night_schedule_dialog) end
if self.media_insights_view then UIManager:close(self.media_insights_view) end
if self.windows_status_view then UIManager:close(self.windows_status_view) end
if self.boot_auto_start_task then
UIManager:unschedule(self.boot_auto_start_task)
self.boot_auto_start_task = nil
end
self.running = false
self:setAutoStart(false)
self:cancelPoll()
UIManager:unschedule(self.command_poll_task)
UIManager:unschedule(self.doctor_poll_task)
UIManager:unschedule(self.camera_poll_task)
UIManager:unschedule(self.plex_command_poll_task)
UIManager:unschedule(self.ebook_poll_task)
UIManager:unschedule(self.plex_search_poll_task)
UIManager:unschedule(self.plex_details_poll_task)
UIManager:unschedule(self.subtitle_catalog_poll_task)
UIManager:unschedule(self.subtitle_job_poll_task)
if self.camera_view then UIManager:close(self.camera_view) end
self.camera_printer = nil
self:releaseStandby()
if self.view then
UIManager:close(self.view)
self.view = nil
end
self.view_kind = nil
self.view_text = nil
end
function Dashboard:onSuspend()
self.suspended = true
self:cancelEverydayTick()
self:cancelPrinterSends()
if self.printer_controls_task then UIManager:unschedule(self.printer_controls_task) end
self.printer_controls_task = nil
if self.plex_stream_poll_task then UIManager:unschedule(self.plex_stream_poll_task) end
self.plex_stream_poll_task = nil
if self.media_tracker_poll_task then UIManager:unschedule(self.media_tracker_poll_task) end
self.media_tracker_poll_task = nil
local released, reason = self:releaseOwnedKeepAlive()
if not released then self:notice(reason, 8) end
self:cancelPoll()
UIManager:unschedule(self.camera_poll_task)
UIManager:unschedule(self.plex_command_poll_task)
UIManager:unschedule(self.ebook_poll_task)
UIManager:unschedule(self.plex_search_poll_task)
UIManager:unschedule(self.plex_details_poll_task)
UIManager:unschedule(self.subtitle_catalog_poll_task)
UIManager:unschedule(self.subtitle_job_poll_task)
UIManager:unschedule(self.command_poll_task)
UIManager:unschedule(self.doctor_poll_task)
self:releaseStandby()
end
function Dashboard:onResume()
self.suspended = false
self:applyKeepAliveDefault()
if not self.running then return end
self.clean_refresh_pending = true
self:scheduleEverydayTick()
self:cleanScreen()
if self.printer_controls_menu then self:schedulePrinterControls(self.printer_controls_menu) end
if self.plex_stream_menu then self:schedulePlexNowPlaying(self.plex_stream_menu, self.plex_stream_offset or 0) end
if self.media_tracker_menu then
self:scheduleMediaTrackerRefresh(self.media_tracker_menu, self.media_tracker_offset or 0)
end
if self.active_command then
UIManager:scheduleIn(2, self.command_poll_task)
end
if self.active_doctor then
UIManager:scheduleIn(3, self.doctor_poll_task)
end
if self.camera_view and self.camera_printer then
UIManager:scheduleIn(2, self.camera_poll_task)
end
if self.active_plex_command then
UIManager:scheduleIn(2, self.plex_command_poll_task)
end
if self.active_ebook_job then UIManager:scheduleIn(2, self.ebook_poll_task) end
if self.active_plex_search then
UIManager:scheduleIn(2, self.plex_search_poll_task)
end
if self.active_plex_details then
UIManager:scheduleIn(2, self.plex_details_poll_task)
end
if self.active_subtitle_catalog then
UIManager:scheduleIn(2, self.subtitle_catalog_poll_task)
end
if self.active_subtitle_job then
UIManager:scheduleIn(2, self.subtitle_job_poll_task)
end
if self.running then
self:holdStandby()
self:schedulePoll(3)
end
end
function Dashboard:onNetworkConnected()
self:refreshSelfHealthIndicator()
if self.running and not self.suspended then
self.last_request_at = 0
self:schedulePoll(2)
end
end
function Dashboard:onNetworkDisconnected()
self:refreshSelfHealthIndicator()
if self.running and not self.suspended then
self:schedulePoll(2)
end
end
function Dashboard:onCloseWidget()
self.running = false
self:cancelEverydayTick()
self:releaseNightDimming()
self:closePrinterControls()
self:cancelPrinterSends()
self:closePlexNowPlaying()
self:closeMediaTracker()
if self.alert_badge_task then UIManager:unschedule(self.alert_badge_task); self.alert_badge_task = nil end
if self.alerts_quiet_dialog then UIManager:close(self.alerts_quiet_dialog) end
if self.alerts_view then UIManager:close(self.alerts_view) end
self.keepalive_closed = true
if self.keepalive_startup_task then
UIManager:unschedule(self.keepalive_startup_task)
self.keepalive_startup_task = nil
end
local released, reason = self:releaseOwnedKeepAlive()
if not released then self:notice(reason, 8) end
if self.keepalive_handle then
pcall(function() self.keepalive_handle:close() end)
self.keepalive_handle = nil
end
if self.brightness_dialog then UIManager:close(self.brightness_dialog) end
if self.night_schedule_dialog then UIManager:close(self.night_schedule_dialog) end
if self.media_insights_view then UIManager:close(self.media_insights_view) end
if self.windows_status_view then UIManager:close(self.windows_status_view) end
if self.boot_auto_start_task then
UIManager:unschedule(self.boot_auto_start_task)
self.boot_auto_start_task = nil
end
self.running = false
self:cancelPoll()
UIManager:unschedule(self.camera_poll_task)
UIManager:unschedule(self.plex_command_poll_task)
UIManager:unschedule(self.ebook_poll_task)
UIManager:unschedule(self.plex_search_poll_task)
UIManager:unschedule(self.plex_details_poll_task)
UIManager:unschedule(self.subtitle_catalog_poll_task)
UIManager:unschedule(self.subtitle_job_poll_task)
if self.camera_view then UIManager:close(self.camera_view) end
self.camera_printer = nil
UIManager:unschedule(self.command_poll_task)
UIManager:unschedule(self.doctor_poll_task)
self.active_command = nil
self.active_doctor = nil
self.active_plex_command = nil
self.active_plex_search = nil
self.active_plex_details = nil
self.active_subtitle_catalog = nil
self.active_subtitle_job = nil
self:releaseStandby()
if self.view then
UIManager:close(self.view)
self.view = nil
end
end
function Dashboard:showConfig()
local dialog
dialog = MultiInputDialog:new {
title = _("Printer Dashboard settings"),
fields = {
{ text = self.settings.base_url, hint = _("__INKBOARD_BASE__"), input_type = "string" },
{ text = tostring(self.settings.refresh_seconds), hint = _("Other tabs refresh (60-900s); Printers 15s"), input_type = "number" },
{ text = self.settings.token_file, hint = _("Absolute token-file path"), input_type = "string" },
},
buttons = {{
{ text = _("Cancel"), id = "close", callback = function() UIManager:close(dialog) end },
{ text = _("Save"), is_enter_default = true, callback = function()
local fields = dialog:getFields()
local base = clean_base_url(fields[1])
local seconds = tonumber(fields[2])
if not base then
UIManager:show(require("ui/widget/infomessage"):new {
text = _("Enter the exact HTTPS relay URL or a private HTTP base URL."), timeout = 4,
})
return
end
if not seconds or seconds % 1 ~= 0 or seconds < 60 or seconds > 900 then
UIManager:show(require("ui/widget/infomessage"):new {
text = _("Refresh must be 60 to 900 seconds."), timeout = 4,
})
return
end
if not fields[3] or fields[3]:sub(1, 1) ~= "/" then
UIManager:show(require("ui/widget/infomessage"):new {
text = _("Token-file path must be absolute."), timeout = 4,
})
return
end
self.settings.base_url = base
if base == PUBLIC_BASE then self.settings.proxy_mode = "https" end
self.settings.refresh_seconds = seconds
self.settings.token_file = fields[3]
self.tab_cache = {}
self:saveSettings()
UIManager:close(dialog)
if self.running then
self.last_request_at = 0
self:poll(true)
end
end },
}},
}
UIManager:show(dialog)
end
function Dashboard:showTokenDialog(control)
local preferred = control and self.settings.control_token_file or self.settings.token_file
local target = control and CONTROL_TOKEN_FILE or TOKEN_FILE
if preferred == FALLBACK_TOKEN_FILE or preferred == FALLBACK_CONTROL_TOKEN_FILE then
target = control and FALLBACK_CONTROL_TOKEN_FILE or FALLBACK_TOKEN_FILE
end
local dialog
dialog = MultiInputDialog:new {
title = control and _("Set control token") or _("Set dashboard token"),
fields = {{
text = "",
hint = control and _("Paste the separate control token")
or _("Paste the reader token"),
text_type = "password",
}},
buttons = {{
{ text = _("Cancel"), id = "close", callback = function() UIManager:close(dialog) end },
{ text = _("Save"), is_enter_default = true, callback = function()
local token = dialog:getFields()[1]
local ok, reason = write_bearer_token(token, target)
if not ok and (target == TOKEN_FILE or target == CONTROL_TOKEN_FILE) then
target = control and FALLBACK_CONTROL_TOKEN_FILE or FALLBACK_TOKEN_FILE
ok, reason = write_bearer_token(token, target)
end
if not ok then
UIManager:show(require("ui/widget/infomessage"):new {
text = reason, timeout = 5,
})
return
end
if control then self.settings.control_token_file = target
else self.settings.token_file = target end
self:saveSettings()
UIManager:close(dialog)
UIManager:show(require("ui/widget/infomessage"):new {
text = (target == FALLBACK_TOKEN_FILE or target == FALLBACK_CONTROL_TOKEN_FILE)
and _("Token stored in MTP-visible KOReader settings; keep Kindle storage private.")
or (control and _("Control token stored privately.")
or _("Reader token stored privately.")), timeout = 6,
})
end },
}},
}
UIManager:show(dialog)
end
function Dashboard:addToMainMenu(menu_items)
local function proxy_item(label, value)
return {
text = label,
checked_func = function() return self.settings.proxy_mode == value end,
callback = function()
self.settings.proxy_mode = value
if value == "https" then self.settings.base_url = PUBLIC_BASE end
self.tab_cache = {}
self:saveSettings()
end,
}
end
local subitems = {
{ text = _("Start dashboard"), callback = function() self:startDashboard() end },
{ text = _("Light / brightness"), callback = function() self:showBrightnessDialog() end },
{ text = _("Dashboard self-health"), callback = function() self:showSelfHealth() end },
{ text = _("Everyday Kindle settings"), callback = function() self:showEverydaySettings() end },
{ text = _("Check for Wi-Fi update"), keep_menu_open = true,
callback = function() self:checkWifiUpdate() end },
{ text = _("Configure"), keep_menu_open = true,
callback = function() self:showConfig() end },
{ text = _("Set dashboard token"), keep_menu_open = true,
callback = function() self:showTokenDialog(false) end },
{ text = _("Set control token"), keep_menu_open = true,
callback = function() self:showTokenDialog(true) end },
}
for index, tab in ipairs(DASHBOARD_TABS) do
local selected = index
subitems[#subitems + 1] = {
text = _("Open tab: ") .. tab.label,
checked_func = function() return self.active_tab == selected end,
callback = function()
self:switchTab(selected)
if not self.running then self:startDashboard(nil, true) end
end,
}
end
for _, module in ipairs(DASHBOARD_MODULES) do
local current = module
subitems[#subitems + 1] = { text = current.title,
sub_item_table_func = function() return current.menu_items(self) end }
end
local extra_items = {
{ text = _("Connection route"), sub_item_table = {
proxy_item(_("Verified HTTPS relay (any Wi-Fi)"), "https"),
} },
{ text = _("KeepAlive at KOReader startup"),
checked_func = function() return self.settings.keepalive_default ~= false end,
callback = function() self:toggleKeepAliveDefault() end },
{ text = _("KeepAlive status / behavior"),
callback = function() self:showKeepAliveStatus() end },
{ text = _("Prevent KOReader standby while open"),
checked_func = function() return self.settings.keep_awake end,
callback = function()
self.settings.keep_awake = not self.settings.keep_awake
self:saveSettings()
if self.settings.keep_awake then self:holdStandby()
else self:releaseStandby() end
end },
}
for _, item in ipairs(extra_items) do subitems[#subitems + 1] = item end
menu_items.kindleprinter = {
text = _("Inkboard"),
sorting_hint = "tools",
sub_item_table = subitems,
}
end
function Dashboard:showPlexActionAt()self:showPlexMenu()end
function Dashboard:showStatusActionAt(_,key)self:showStatusMenu(key)end
local OPTIONAL_FEATURES=__INKBOARD_FEATURES__
local OPTIONAL_MENUS={doctor={"showDoctorMenu"},media_requests={"showPlexSearchPrompt","confirmPlexApprove"},media_operator={"showPlexMaintenance","showPlexLibraries","showPlexDeleteMenu","showPlexMetadataMenu","showOptionalEbooks"},subtitles={"showSubtitleMenu"},telemetry={"showWindowsStatus","showMediaInsights"}}
for feature,methods in pairs(OPTIONAL_MENUS)do
if not OPTIONAL_FEATURES[feature]then for _,name in ipairs(methods)do
Dashboard[name]=function(self)self:notice("This optional module is not configured on this hub.",8)end
end end
end
return Dashboard
