<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.inkboard</string>
  <key>ProgramArguments</key><array><string>__VENV__/bin/inkboard</string><string>serve</string><string>--directory</string><string>__CONFIG__</string></array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string><key>Umask</key><integer>63</integer>
</dict></plist>
